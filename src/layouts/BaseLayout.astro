---
import "~/styles/global.css";
import { ClientRouter } from "astro:transitions";
import SEO from "~/components/SEO.astro";
import SkipLink from "~/components/SkipLink.astro";
import ToastHost from "~/islands/ToastHost.tsx";
import Analytics from "@vercel/analytics/astro";
import { site } from "~/data/site";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article" | "product";
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
  noindex?: boolean;
}

const props = Astro.props;
const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: site.name,
  url: site.url,
  logo: new URL("/logo.png", Astro.site ?? site.url).toString(),
  foundingDate: String(site.founded),
  slogan: site.tagline,
  description: site.descriptor,
  email: site.email,
  sameAs: [site.social.instagram, site.social.facebook],
};
const jsonLd = props.jsonLd
  ? (Array.isArray(props.jsonLd) ? [orgJsonLd, ...props.jsonLd] : [orgJsonLd, props.jsonLd])
  : [orgJsonLd];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fefcf8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
    <SEO
      title={props.title}
      description={props.description}
      image={props.image}
      canonical={props.canonical}
      type={props.type}
      jsonLd={jsonLd}
      noindex={props.noindex}
    />
  </head>
  <body>
    <SkipLink />
    <slot />
    <ToastHost client:load />
    <Analytics />
  </body>
</html>

<script>
  /**
   * Visitas para el panel (18-11-2026): un aviso a `/api/v` por página, sin
   * cookies ni almacenamiento. La cabecera navega sin recargar, así que la
   * primera página de la pestaña es la que trae de dónde llega (`n: 1`).
   * Si falla, no pasa nada: ni se reintenta ni se avisa.
   */
  function avisaVisitas() {
    let primera = true;
    // Una página, un aviso: el catálogo cambia la consulta al filtrar.
    let ultima = "";
    document.addEventListener("astro:page-load", () => {
      try {
        if (location.pathname === ultima) return;
        ultima = location.pathname;
        // El panel y el TPV no cuentan (el servidor también los descarta).
        if (/^\/(admin|tpv)(\/|$)/.test(location.pathname)) return;
        const n = primera ? 1 : 0;
        primera = false;
        const params = new URLSearchParams(location.search);
        const tablet = navigator.maxTouchPoints > 1 && /Macintosh/.test(navigator.userAgent) ? 1 : 0;
        const datos = JSON.stringify({
          p: location.pathname,
          r: n ? document.referrer : "",
          u: n ? (params.get("utm_source") ?? "") : "",
          n,
          t: tablet,
        });
        if (!navigator.sendBeacon?.("/api/v", datos))
          fetch("/api/v", { method: "POST", body: datos, keepalive: true }).catch(() => {});
      } catch {}
    });
  }
  // Un solo oyente por pestaña. Y nada desde un iframe: para ir a una página
  // con islas `client:only` (el catálogo), el router de Astro la carga antes
  // en un iframe oculto, y eso contaba una visita de más.
  const marca = window as unknown as { __hslVisitas?: boolean };
  if (window.self === window.top && !marca.__hslVisitas) {
    marca.__hslVisitas = true;
    avisaVisitas();
  }
</script>
