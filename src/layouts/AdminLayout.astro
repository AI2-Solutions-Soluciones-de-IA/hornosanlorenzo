---
// src/layouts/AdminLayout.astro
import BaseLayout from "~/layouts/BaseLayout.astro";
import AdminSalir from "~/islands/AdminSalir";
import { puedeEntrar } from "~/lib/auth/guardia";

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;

// Aquí NO se comprueba la sesión: eso lo hace el middleware, que es quien
// puede cortar la petición de verdad. Este layout solo pinta.
//
// Datos de clientes y pedidos: ni caché compartida ni disco del navegador.
Astro.response.headers.set("Cache-Control", "private, no-store");

// Pedidos lo primero y Resumen lo último (9-10-2026).
const todas = [
  { href: "/admin/pedidos", label: "Pedidos" },
  { href: "/admin/produccion", label: "Producción" },
  { href: "/admin/productos", label: "Productos" },
  { href: "/admin/packs", label: "Packs" },
  { href: "/admin/clientes", label: "Clientes" },
  { href: "/admin/noticias", label: "Este mes" },
  { href: "/admin/resumen", label: "Resumen" },
];
// Solo lo que el papel abre: la oficina ve Pedidos y nada más. Quien corta
// de verdad es el middleware; esto evita enseñar enlaces que dan 404.
const secciones = todas.filter((s) => puedeEntrar(Astro.locals.usuario, s.href));
const actual = Astro.url.pathname;
const seccionActual = secciones.find((s) => s.href === actual)?.label ?? "Panel";
---
<BaseLayout title={`${titulo} — Panel`} description="Panel de administración" noindex>
  <!-- Móvil: cabecera, desplegable de secciones y contenido, en ese orden
       (sin scroll horizontal: petición de Oscar, 30-9-2026).
       Desde md: columna a la izquierda (Panel, secciones, Salir) y título + contenido a la derecha. -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-10 md:grid md:grid-cols-[13rem_minmax(0,1fr)] md:grid-rows-[auto_1fr] md:gap-x-8">
    <header class="filete pb-4 flex items-end justify-between gap-4 md:col-start-2 md:row-start-1">
      <div>
        <p class="numeracion md:hidden">Panel</p>
        <h1 class="font-[family-name:var(--font-display)] text-3xl sm:text-4xl mt-1">{titulo}</h1>
      </div>
      <div class="md:hidden"><AdminSalir client:load /></div>
    </header>

    <aside class="mt-6 md:mt-0 md:col-start-1 md:row-start-1 md:row-span-2 md:flex md:flex-col md:bg-[color:var(--color-leche)] md:border-r md:border-[color:var(--color-avellana)] md:sticky md:top-0 md:self-start md:h-screen md:min-h-0">
      <p class="numeracion hidden md:block md:px-4 md:pb-4">Panel</p>

      <!-- Móvil: desplegable nativo (<details>), sin JavaScript. Enseña la
           sección en la que se está y, al tocarlo, la lista entera. -->
      <details class="md:hidden group border border-[color:var(--color-avellana)] bg-[color:var(--color-leche)]">
        <summary class="flex items-center justify-between gap-3 px-4 py-3 text-sm font-semibold cursor-pointer list-none [&::-webkit-details-marker]:hidden">
          <span>
            <span class="text-[color:var(--color-ink-muted)] font-normal">Sección:</span> {seccionActual}
            {/* En el móvil el menú va plegado: el número de pedidos nuevos se ve también aquí. */}
            {secciones.some((x) => x.href === "/admin/pedidos") && (
              <span data-contador-pedidos hidden class="ml-2 inline-flex min-w-5 h-5 px-1.5 items-center justify-center rounded-full bg-[color:var(--color-teja)] text-[color:var(--color-leche)] text-[11px] font-bold leading-none align-middle"></span>
            )}
          </span>
          <svg viewBox="0 0 12 12" width="12" height="12" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="transition-transform group-open:rotate-180">
            <path d="m2 4.5 4 3.5 4-3.5" />
          </svg>
        </summary>
        <nav aria-label="Secciones del panel" class="flex flex-col border-t border-[color:var(--color-avellana)]">
          {secciones.map((s) => (
            <a
              href={s.href}
              class:list={[
                "px-4 py-3 text-sm font-semibold border-b border-[color:var(--color-avellana)] last:border-b-0 hover:bg-[color:var(--color-latte)] transition-colors",
                actual === s.href && "bg-[color:var(--color-latte)] text-[color:var(--color-moka)]",
              ]}
              aria-current={actual === s.href ? "page" : undefined}
            >
              {s.label}
              {s.href === "/admin/pedidos" && (
                <span data-contador-pedidos hidden class="ml-2 inline-flex min-w-5 h-5 px-1.5 items-center justify-center rounded-full bg-[color:var(--color-teja)] text-[color:var(--color-leche)] text-[11px] font-bold leading-none align-middle"></span>
              )}
            </a>
          ))}
        </nav>
      </details>

      <!-- Escritorio: columna lateral. -->
      <nav
        aria-label="Secciones del panel"
        class="hidden md:flex md:flex-col md:min-h-0 md:overflow-y-auto"
      >
        {secciones.map((s) => (
          <a
            href={s.href}
            class:list={[
              "px-4 py-2 text-sm font-semibold hover:bg-[color:var(--color-latte)] transition-colors",
              actual === s.href
                ? "bg-[color:var(--color-latte)] text-[color:var(--color-moka)]"
                : "bg-[color:var(--color-leche)]",
            ]}
            aria-current={actual === s.href ? "page" : undefined}
          >
            {s.label}
            {s.href === "/admin/pedidos" && (
                <span data-contador-pedidos hidden class="ml-2 inline-flex min-w-5 h-5 px-1.5 items-center justify-center rounded-full bg-[color:var(--color-teja)] text-[color:var(--color-leche)] text-[11px] font-bold leading-none align-middle"></span>
              )}
          </a>
        ))}
      </nav>
      <div class="hidden md:block md:mt-auto md:px-4 md:py-6">
        <AdminSalir client:load />
      </div>
    </aside>

    <div class="mt-8 min-w-0 md:col-start-2 md:row-start-2">
      <slot />
    </div>
  </div>
</BaseLayout>

<script>
  /**
   * Número en rojo junto a «Pedidos» en el menú del panel (9-10-2026): los
   * pedidos entrados desde la última vez que se abrió Pedidos en este
   * navegador. Esa marca la deja `PedidosNuevos.tsx` en localStorage al
   * abrir la página de Pedidos. Mira cada 20 s con la pestaña visible.
   * La cabecera de la web usa navegación sin recarga, así que todo se
   * engancha a `astro:page-load` y se limpia en cada cambio de página.
   */
  const CLAVE_VISTOS = "hsl-pedidos-vistos";
  let reloj: number | undefined;

  function pinta(n: number) {
    for (const el of document.querySelectorAll<HTMLElement>("[data-contador-pedidos]")) {
      el.textContent = n > 99 ? "99+" : String(n);
      el.hidden = n === 0;
      el.setAttribute("aria-label", `${n} pedidos nuevos`);
    }
  }

  async function mira() {
    if (document.hidden || !document.querySelector("[data-contador-pedidos]")) return;
    let vistos = NaN;
    try {
      vistos = Number(localStorage.getItem(CLAVE_VISTOS) ?? NaN);
    } catch {}
    // Sin marca (nunca se ha abierto Pedidos aquí): no hay con qué comparar.
    if (!Number.isFinite(vistos)) return pinta(0);
    try {
      const r = await fetch("/api/admin/pedidos/nuevos", { cache: "no-store" });
      if (!r.ok) return;
      const { total } = (await r.json()) as { total: number };
      pinta(Math.max(0, total - vistos));
    } catch {
      // Sin conexión un rato: se vuelve a mirar en la siguiente vuelta.
    }
  }

  document.addEventListener("astro:page-load", () => {
    window.clearInterval(reloj);
    if (!document.querySelector("[data-contador-pedidos]")) return;
    // Un respiro al cargar: en Pedidos, la isla apunta antes lo ya visto.
    window.setTimeout(mira, 1500);
    reloj = window.setInterval(mira, 20_000);
  });
  document.addEventListener("visibilitychange", () => {
    if (!document.hidden) mira();
  });
</script>
