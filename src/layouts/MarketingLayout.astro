---
import BaseLayout from "~/layouts/BaseLayout.astro";
import Header from "~/components/Header.astro";
import Footer from "~/components/Footer.astro";
import CookieBanner from "~/islands/CookieBanner.tsx";
import { ventaOnlinePausada, VENTA_PAUSADA_COPY } from "~/lib/venta-online";
import { stores } from "~/data/stores";

interface Props {
  title: string;
  description: string;
  image?: string;
  canonical?: string;
  type?: "website" | "article" | "product";
  jsonLd?: Record<string, unknown> | Array<Record<string, unknown>>;
}
const props = Astro.props;
---
<BaseLayout {...props}>
  {ventaOnlinePausada() && (
    <p role="status" class="bg-[color:var(--color-moka)] text-[color:var(--color-leche)] text-center text-sm px-4 py-2.5">
      Estamos estrenando web. {VENTA_PAUSADA_COPY}
      <span class="block mt-0.5">
      Mientras tanto, puedes seguir encargando por teléfono:{" "}
      {stores.map((s, i) => (
        <>
          {i > 0 && " · "}
          <span class="whitespace-nowrap">
            {s.shortName}{" "}
            <a href={`tel:${s.phone}`} class="font-semibold underline underline-offset-2">{s.phoneDisplay}</a>
          </span>
        </>
      ))}
      </span>
    </p>
  )}
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <CookieBanner client:idle />
</BaseLayout>
