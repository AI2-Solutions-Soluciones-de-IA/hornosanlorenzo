---
interface Props {
  embedUrl: string;
  externalUrl: string;
  title: string;
  /** Lo que se lee en la franja mientras el mapa no se carga. */
  lugar: string;
}
const { embedUrl, externalUrl, title, lugar } = Astro.props;
---
<!-- Franja al pie de la tarjeta de cada tienda (19-10-2026): sin cookies
     aceptadas, solo la línea y el enlace; con ellas, el mapa debajo. -->
<div class="bg-[color:var(--color-latte)] border-t border-[color:var(--color-line)]" data-mapembed>
  <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-2 px-5 sm:px-7 py-3 text-xs">
    <p class="flex items-center gap-2 text-[color:var(--color-ink-muted)]">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 4 3 6v14l6-2 6 2 6-2V4l-6 2-6-2z"/><path d="M9 4v14M15 6v14"/></svg>
      <span data-mapplaceholder>Mapa de Google Maps · {lugar} · se carga al aceptar cookies</span>
      <span class="hidden" data-maplisto>Mapa · {lugar}</span>
    </p>
    <a href={externalUrl} rel="noopener" target="_blank" class="font-semibold text-[color:var(--color-teja)] hover:underline">
      Ver mapa en Google Maps →
    </a>
  </div>
  <iframe
    title={`Mapa — ${title}`}
    data-embed-url={embedUrl}
    width="100%"
    height="280"
    loading="lazy"
    referrerpolicy="no-referrer-when-downgrade"
    class="w-full h-[280px] hidden"
    data-mapframe
  ></iframe>
</div>

<script>
  function maybeLoadMaps() {
    const consent = localStorage.getItem("hsl-cookie-consent");
    if (consent !== "accepted") return;
    document.querySelectorAll<HTMLElement>("[data-mapembed]").forEach((wrap) => {
      const iframe = wrap.querySelector<HTMLIFrameElement>("[data-mapframe]");
      if (!iframe || iframe.getAttribute("src")) return;
      iframe.src = iframe.dataset.embedUrl ?? "";
      iframe.classList.remove("hidden");
      wrap.querySelector("[data-mapplaceholder]")?.classList.add("hidden");
      wrap.querySelector("[data-maplisto]")?.classList.remove("hidden");
    });
  }
  maybeLoadMaps();
  window.addEventListener("hsl-cookie-consent-change", (e) => {
    if ((e as CustomEvent).detail === "accepted") maybeLoadMaps();
  });
</script>
