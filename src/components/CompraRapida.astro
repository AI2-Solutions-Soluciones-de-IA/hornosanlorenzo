---
/**
 * Precio y botón de añadir de una tarjeta: lo que va debajo del nombre en
 * `ProductCard` y, desde que una noticia de Este mes puede enlazar un
 * producto, también en `NewsCard`. Vive aparte para que las dos tarjetas
 * cobren exactamente lo mismo que enseñan: la regla de `precioTarjeta` de
 * abajo es la que evita que el cliente vea un importe y pague otro.
 */
import AddToCart from "~/islands/AddToCart.tsx";
import { formatPriceCents } from "~/lib/format";

interface Props {
  slug: string;
  name: string;
  priceCents?: number;
  /** Con oferta de Este mes y sin tamaños: el precio de siempre, tachado. */
  priceAntesCents?: number;
  /** La carta no da precio: se consulta con el obrador. */
  consultar?: boolean;
  /** Se ve, pero hoy no se puede comprar. */
  agotado?: boolean;
  unit?: string;
  variants?: { id: string; label: string; priceCents: number; precioAntesCents?: number }[];
}

const {
  slug,
  name,
  priceCents,
  priceAntesCents,
  consultar = false,
  agotado = false,
  unit,
  variants,
} = Astro.props;

/** Con varios tamaños la tarjeta lleva selector y el precio lo pone la isla. */
const conTamanos = Boolean(variants && variants.length > 1);
/**
 * El precio que se pinta tiene que ser el que se va a cobrar.
 *
 * Con UN solo tamaño la tarjeta no lleva selector, pero `AddToCart` arranca
 * con `variants[0]` ya seleccionada y mete en el carrito SU precio, no el
 * `priceCents` base. Mientras la carta vivía en los 98 Markdown los dos
 * números coincidían siempre (el base era el del tamaño más barato); desde
 * que el panel los edita por separado pueden no coincidir, y entonces el
 * cliente veía un importe en la tarjeta y pagaba otro sin haber tocado nada
 * ni hecho falta petición amañada ninguna. Con dos o más tamaños esto no
 * hace falta: ahí el precio lo pinta la isla, que ya usa el de la variante.
 */
const precioTarjeta =
  variants && variants.length === 1 ? variants[0].priceCents : priceCents;
const sinPrecio = consultar || priceCents === undefined;
/** El tachado sigue la misma regla que el precio: con un tamaño, el suyo. */
const precioAntes =
  variants && variants.length === 1 ? variants[0].precioAntesCents : priceAntesCents;
---
<div class="mt-4">
  {agotado ? (
    /* Visible pero no comprable: se ve el precio (o «Consultar»), sin
       botón de añadir.

       OJO: aquí `agotado` va ANTES que `consultar`, al revés que en
       `~/lib/pedido.ts` y en `catalogo/[slug].astro`, y NO es la misma
       decisión ni la contradice. Allí hay que escoger UN mensaje entre
       dos excluyentes, y la regla del proyecto es que gana «consultar»:
       un producto sin precio de venta online no es de los que vuelven a
       salir del horno, así que prometer una reposición sería engañoso.
       Aquí no se escoge: esta rama enseña «Consultar» como precio Y la
       etiqueta «Agotado hoy», es decir, las dos cosas a la vez. Ponerla
       después de la de «consultar» no arreglaría ninguna incoherencia,
       solo perdería la etiqueta de agotado. */
    <div class="flex items-center justify-between">
      <p class="font-[family-name:var(--font-display)] text-xl font-semibold text-[color:var(--color-ink-muted)]">
        {!sinPrecio && precioAntes !== undefined && (
          <s class="text-sm font-normal mr-1.5"><span class="sr-only">Antes </span>{formatPriceCents(precioAntes)}</s>
        )}
        {sinPrecio ? "Consultar" : formatPriceCents(precioTarjeta!)}
      </p>
      <span class="numeracion">Agotado hoy</span>
    </div>
  ) : sinPrecio ? (
    <div class="flex items-center justify-between">
      <p class="font-[family-name:var(--font-display)] text-xl font-semibold text-[color:var(--color-ink-muted)]">
        Consultar
      </p>
      <a
        href="/contacto"
        class="inline-flex items-center h-9 px-4 border border-[color:var(--color-avellana)] text-[13px] font-semibold text-[color:var(--color-moka)] hover:border-[color:var(--color-moka)] transition-colors"
      >
        Preguntar
      </a>
    </div>
  ) : conTamanos ? (
    /* El precio lo pinta la isla: cambia con el tamaño elegido. */
    <AddToCart
      client:visible
      slug={slug}
      name={name}
      unitPriceCents={precioTarjeta!}
      unitPriceAntesCents={precioAntes}
      variants={variants}
      compact={true}
    />
  ) : (
    <div class="flex items-center justify-between">
      <p class="font-[family-name:var(--font-display)] text-xl font-semibold">
        {precioAntes !== undefined && (
          <s class="text-sm font-normal text-[color:var(--color-ink-muted)] mr-1.5"><span class="sr-only">Antes </span>{formatPriceCents(precioAntes)}</s>
        )}
        {formatPriceCents(precioTarjeta!)}{unit && <span class="text-xs text-[color:var(--color-ink-muted)] font-normal"> / {unit}</span>}
      </p>
      <AddToCart
        client:visible
        slug={slug}
        name={name}
        unitPriceCents={precioTarjeta!}
        variants={variants}
        compact={true}
      />
    </div>
  )}
</div>
