---
import { site } from "~/data/site";
import { stores } from "~/data/stores";
import SocialLinks from "~/components/SocialLinks.astro";
import { Image } from "astro:assets";
import sello from "../../public/images/sello-hsl.png";
import { footerNav, paymentLabels } from "~/data/navigation";
import { paymentMarks } from "~/data/payment-marks";
const year = new Date().getFullYear();

const legal = [
  { href: "/legal/condiciones-de-compra", label: "Condiciones de compra" },
  { href: "/legal/aviso-legal", label: "Aviso legal" },
  { href: "/legal/privacidad", label: "Privacidad" },
  { href: "/legal/cookies", label: "Cookies" },
];
---
<footer class="bg-[color:var(--color-leche)] border-t border-[color:var(--color-avellana)] mt-24" transition:persist>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-12 grid gap-8 md:grid-cols-4 text-sm">
    <div>
      <!-- Sello aprobado por el cliente (30-9-2026), en vez del dibujado a mano. -->
      <Image
        src={sello}
        alt={`${site.name} — obrador artesano, Madrid, desde 1986`}
        widths={[200, 300, 400]}
        sizes="144px"
        class="w-36 h-36"
      />
    </div>
    <div>
      <p class="numeracion">Tiendas</p>
      <ul class="mt-3 space-y-3">
        {stores.map((s) => (
          <li>
            <p class="font-semibold text-[color:var(--color-ink)]">{s.shortName}</p>
            <p class="text-[color:var(--color-ink-muted)]">{s.address}</p>
            <p class="text-[color:var(--color-ink-muted)]">{s.phoneDisplay}</p>
          </li>
        ))}
      </ul>
    </div>
    <div>
      <p class="numeracion">Navegación</p>
      <ul class="mt-3 space-y-2">
        {footerNav.map((l) => (
          <li><a href={l.href} class="hover:text-[color:var(--color-caramelo)] transition-colors">{l.label}</a></li>
        ))}
      </ul>
    </div>
    <div>
      <p class="numeracion">Legal</p>
      <ul class="mt-3 space-y-2">
        {legal.map((l) => (
          <li><a href={l.href} class="hover:text-[color:var(--color-caramelo)] transition-colors">{l.label}</a></li>
        ))}
      </ul>
      <p class="numeracion mt-6">Síguenos</p>
      <SocialLinks class="mt-3" />
    </div>
  </div>

  <!-- Formas de pago -->
  <div class="border-t border-[color:var(--color-avellana)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-6 flex flex-wrap items-center gap-x-6 gap-y-3">
      <p class="numeracion">Formas de pago</p>
      <ul class="flex flex-wrap items-center gap-2">
        {paymentMarks.map((m) => (
          <li
            class="inline-flex items-center justify-center h-9 w-16 border border-[color:var(--color-avellana)] bg-[color:var(--color-leche)]"
            title={m.label}
          >
            <svg
              viewBox="0 0 24 24"
              width="30"
              height="30"
              fill="var(--color-moka)"
              role="img"
              aria-label={m.label}
            >
              <path d={m.path} />
            </svg>
          </li>
        ))}
        {paymentLabels.map((m) => (
          <li
            class="inline-flex items-center h-9 px-3 border border-[color:var(--color-avellana)] bg-[color:var(--color-leche)] text-[10px] font-medium uppercase tracking-[0.12em] text-[color:var(--color-ink-muted)]"
          >
            {m.label}
          </li>
        ))}
      </ul>
    </div>
  </div>

  <div class="border-t border-[color:var(--color-avellana)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-4 text-xs text-[color:var(--color-ink-muted)] flex flex-col sm:flex-row justify-between gap-2">
      <span>© {year} {site.name}. Todos los derechos reservados.</span>
      <span>Hecho con cariño en Madrid.</span>
    </div>
  </div>
</footer>
