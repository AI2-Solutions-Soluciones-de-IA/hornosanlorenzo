---
// src/components/TablaRanking.astro
// Una tabla del ranking de la carta en el Resumen del panel. `completa`
// añade la posición, la categoría y en cuántos pedidos sale cada producto.
import type { ProductoEnRanking } from "~/lib/db/estadisticas";
import { formatPriceCents } from "~/lib/format";
import { categories } from "~/data/categories";

interface Props {
  filas: ProductoEnRanking[];
  completa?: boolean;
}
const { filas, completa = false } = Astro.props;

const nombreCategoria = (id: string | null) =>
  id === null ? "—" : (categories.find((c) => c.id === id)?.label ?? id);
const celda = "py-2";
const cifra = "py-2 text-right tabular-nums";
---
<div class="mt-3 overflow-x-auto"><table class="w-full text-sm">
  <thead>
    <tr class="text-left numeracion">
      {completa && <th class="py-2 pr-3 font-medium text-right">#</th>}
      <th class="py-2 font-medium">Producto</th>
      {completa && <th class="py-2 font-medium">Categoría</th>}
      <th class="py-2 font-medium text-right">Unidades</th>
      {completa && <th class="py-2 font-medium text-right">Pedidos</th>}
      <th class="py-2 font-medium text-right">Importe</th>
    </tr>
  </thead>
  <tbody>
    {filas.map((p, i) => (
      <tr class:list={[
        "border-t border-[color:var(--color-line)]",
        p.unidades === 0 && "text-[color:var(--color-ink-muted)]",
      ]}>
        {completa && <td class="py-2 pr-3 text-right tabular-nums">{p.slug === null ? "" : i + 1}</td>}
        <td class={celda}>
          {p.slug === null ? <em>{p.nombre}</em> : p.nombre}
        </td>
        {completa && <td class={celda}>{nombreCategoria(p.categoria)}</td>}
        {p.unidades === 0 ? (
          <td class={cifra} colspan={completa ? 3 : 2}>Sin ventas</td>
        ) : (
          <>
            <td class={cifra}>{p.unidades}</td>
            {completa && <td class={cifra}>{p.pedidos}</td>}
            <td class={cifra}>{formatPriceCents(p.importeCents)}</td>
          </>
        )}
      </tr>
    ))}
  </tbody>
</table></div>
