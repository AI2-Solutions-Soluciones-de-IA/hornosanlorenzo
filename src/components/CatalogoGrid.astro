---
import VolverTienda from "~/components/VolverTienda.astro";
import ElementoCatalogo from "~/components/ElementoCatalogo.astro";
import { agruparSabores } from "~/lib/sabores";
import CategoryFilter, { CHIP_TOP_VENTAS } from "~/islands/CategoryFilter.tsx";
import type { Producto } from "~/lib/db/productos";
import type { DefinicionPack } from "~/data/packs";
import { grupoCategories, grupoOfCategory, grupoLabel, type GrupoId, type CategoryId } from "~/data/categories";
import { secciones, seccionById, isSeccionId, bloqueDe } from "~/data/secciones";
import { stores } from "~/data/stores";

interface Props {
  /** Enlace «Volver a la tienda online» encima: en las secciones, no en `/catalogo`. */
  volver?: boolean;
  /**
   * El catálogo activo, ya leído por la página con `catalogoPublico`. La
   * lectura NO se hace aquí: cuando falla hay que marcar la respuesta como
   * `no-store` para que la página vacía no se quede cacheada, y una cabecera
   * puesta desde el frontmatter de un componente llega tarde (el porqué, con
   * detalle, en `~/lib/lectura-publica.ts`).
   */
  productos: Producto[];
  /** Las definiciones de los packs, leídas igual: con `definicionesPublicas`. */
  defsPacks: Map<string, DefinicionPack>;
  grupo?: GrupoId | null;
  eyebrow: string;
  /** La etiqueta hace de h1: /catalogo no tiene titular grande. */
  eyebrowH1?: boolean;
  /** Sin título ni entrada, el bloque arranca en la etiqueta (la página ya
      tiene su h1). */
  title?: string;
  intro?: string;
  /** Agrupa el listado en los bloques de la carta impresa. */
  porSeccion?: boolean;
  /** Solo los marcados como destacados, sin filtrar por grupo. */
  destacados?: boolean;
  conFiltro?: boolean;
  /** Filtra por gama comercial (Dulce / Salado) en vez de por categoría. */
  porGrupo?: boolean;
}
const {
  productos,
  defsPacks,
  grupo = null,
  eyebrow,
  eyebrowH1 = false,
  volver = false,
  title,
  intro,
  porSeccion = false,
  destacados = false,
  conFiltro = true,
  porGrupo = false,
} = Astro.props;

const allowed = grupo ? grupoCategories[grupo] : null;

// Llegan ya filtrados por `activo` y en el orden de la carta: una ficha
// desactivada desde el panel desaparece de la web.
// Con las gamas mezcladas («Todo el catálogo»), van en el orden de sus
// chips (14-10-2026); dentro de cada gama, el de la carta (`sort` es estable).
const ORDEN_GAMAS: readonly GrupoId[] = ["packs", "dulce", "salado", "sin-alergenos"];
const posGama = (cat: string): number => {
  const g = grupoOfCategory(cat as CategoryId);
  return g ? ORDEN_GAMAS.indexOf(g) : ORDEN_GAMAS.length;
};
const filtrados = productos
  .filter((p) => (destacados ? p.destacado : true))
  .filter((p) => !allowed || allowed.includes(p.category as CategoryId));
const products = porGrupo
  ? [...filtrados].sort((a, b) => posGama(a.category) - posGama(b.category))
  : filtrados;

/**
 * Solo las secciones que tienen producto, en el orden de la carta. Una con
 * `dentroDe` no tiene bloque: sus productos van detrás de los del suyo.
 */
const bloques = porSeccion
  ? secciones
      .filter((s) => !s.dentroDe)
      .map((s) => ({
        seccion: s,
        items: [s.id, ...secciones.filter((x) => x.dentroDe === s.id).map((x) => x.id)].flatMap(
          (id) => products.filter((p) => p.seccion === id),
        ),
      }))
      .filter((b) => b.items.length > 0)
  : [];

/**
 * Productos sin sección: en modo carta se listan al final, en su propio
 * bloque. No es un caso raro reservado a datos mal metidos: el selector de
 * sección del panel abre en «— Ninguna —» y guarda `null`, así que una ficha
 * nueva nace sin sección por defecto. Cuando este bloque no se pintaba,
 * aparecía en /catalogo pero NO en /catalogo/dulce, que es justo donde el
 * menú del sitio manda a quien busca tartas.
 */
const sueltos = porSeccion ? products.filter((p) => !p.seccion) : products;

/**
 * Gamas presentes en el listado, para los chips del filtro. Delante, «Top
 * ventas» (los destacados), justo después de «Todo» (15-10-2026).
 */
const gamas = porGrupo
  ? [
      ...(products.some((p) => p.destacado) ? [{ id: CHIP_TOP_VENTAS, label: "Top ventas" }] : []),
      ...[...new Set(products.map((p) => grupoOfCategory(p.category as CategoryId)))]
        .filter((g): g is GrupoId => g !== null)
        .sort((a, b) => ORDEN_GAMAS.indexOf(a) - ORDEN_GAMAS.indexOf(b))
        .map((g) => ({ id: g as string, label: grupoLabel[g] })),
    ]
  : undefined;

/**
 * Con las gamas como filtro, las secciones de cada una: al elegir «Dulce»
 * salen debajo sus secciones, como en /catalogo/dulce (15-10-2026). Solo
 * los bloques (las secciones con `dentroDe` van dentro del suyo) con algún
 * producto de esa gama, en el orden de la carta.
 */
const seccionesPorGama: Record<string, { id: string; label: string }[]> = {};
if (porGrupo) {
  for (const s of secciones.filter((x) => !x.dentroDe)) {
    const gamasDelBloque = new Set(
      products
        .filter((p) => isSeccionId(p.seccion) && bloqueDe(p.seccion) === s.id)
        .map((p) => grupoOfCategory(p.category as CategoryId))
        .filter((g): g is GrupoId => g !== null),
    );
    for (const g of gamasDelBloque) (seccionesPorGama[g] ??= []).push({ id: s.id, label: s.label });
  }
}

/**
 * `seccion` es texto libre en la base de datos, sin CHECK ni FK: a
 * diferencia de antes (`z.enum(seccionIds)` en `content.config.ts`), el
 * compilador ya no puede garantizar que lo que hay en la fila sea uno de
 * los ids de `secciones.ts`. `isSeccionId` es la comprobación en tiempo de
 * ejecución que sustituye a esa garantía; sin ella, una ficha con un valor
 * que no está en la lista (un typo desde el panel, tarea 19) tira abajo
 * cualquier página pública que la enseñe fuera de un bloque `porSeccion`.
 */
function seccionLabelDe(seccion: string | null): string | undefined {
  return seccion && isSeccionId(seccion) ? seccionById(seccion).label : undefined;
}
---
<section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-12">
  {volver && <VolverTienda class="-mt-4 mb-4" />}
  {eyebrowH1 ? <h1 class="numeracion">{eyebrow}</h1> : <p class="numeracion">{eyebrow}</p>}
  {title && <h1 class="text-4xl sm:text-5xl mt-2">{title}</h1>}
  {intro && <p class="text-[color:var(--color-ink-muted)] mt-3 max-w-xl">{intro}</p>}

  {conFiltro && (
    <div class={title ? "mt-8" : "mt-4"}>
      <CategoryFilter
        client:load
        grupo={grupo}
        secciones={porSeccion ? bloques.map((b) => ({ id: b.seccion.id, label: b.seccion.label })) : undefined}
        grupos={gamas}
        seccionesPorGrupo={porGrupo ? seccionesPorGama : undefined}
      />
    </div>
  )}

  {porSeccion ? (
    <div class="mt-10 flex flex-col gap-14">
      {bloques.map((b) => (
        <div data-seccion={b.seccion.id}>
          <div class="filete pb-3">
            <p class="numeracion">{b.seccion.eyebrow}</p>
            <h2 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl mt-1">
              {b.seccion.label}
            </h2>
            {b.seccion.nota && (
              <p class="mt-2 text-sm text-[color:var(--color-ink-muted)]">{b.seccion.nota}</p>
            )}
            {b.seccion.aviso && (
              <p class="mt-3 text-sm border-l-2 border-[color:var(--color-caramelo)] pl-3">
                {b.seccion.aviso}{" "}
                {stores.map((s, i) => (
                  <>
                    {i > 0 && " · "}
                    <a href={`tel:${s.phone}`} class="underline font-semibold whitespace-nowrap">
                      {s.shortName} {s.phoneDisplay}
                    </a>
                  </>
                ))}
              </p>
            )}
          </div>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
            {agruparSabores(b.items).map((e) => (
              <ElementoCatalogo elemento={e} seccionLabel={seccionById(b.seccion.id).label} defsPacks={defsPacks} />
            ))}
          </div>
        </div>
      ))}

      {sueltos.length > 0 && (
        /* `data-seccion` con un valor que no es ningún id de `secciones.ts`:
           el filtro lo usa para esconder el bloque entero cuando ninguno de
           sus productos queda visible (`[data-seccion]:not([data-product])`),
           y al no estar entre los chips nunca puede seleccionarse. */
        <div data-seccion="sin-seccion">
          <div class="filete pb-3">
            <p class="numeracion">Y además</p>
            <h2 class="font-[family-name:var(--font-display)] text-2xl sm:text-3xl mt-1">
              Otras referencias
            </h2>
          </div>
          <div class="mt-6 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
            {agruparSabores(sueltos).map((e) => (
              <ElementoCatalogo elemento={e} defsPacks={defsPacks} />
            ))}
          </div>
        </div>
      )}
    </div>
  ) : (
    <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
      {agruparSabores(sueltos).map((e) => (
        <ElementoCatalogo
          elemento={e}
          defsPacks={defsPacks}
          seccionLabel={seccionLabelDe((e.tipo === "producto" ? e.producto : e.sabores[0]).seccion)}
        />
      ))}
    </div>
  )}
</section>
