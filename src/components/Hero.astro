---
import { Image } from "astro:assets";

interface Props {
  eyebrow?: string;
  title: string;
  italicTail?: string;
  body?: string;
  image?: ImageMetadata | string;
  imageAlt: string;
  /** Vídeo vertical en lugar de la foto: sin sonido, en bucle. */
  video?: { src: string; poster: string };
  /**
   * Mensajes que rotan en lugar del título y el texto, en el orden de la
   * arquitectura de mensajes de la marca. El primero es el `<h1>`.
   */
  mensajes?: { texto: string; sub?: string }[];
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
}
const { eyebrow, title, italicTail, body, image, imageAlt, video, mensajes, primaryCta, secondaryCta } = Astro.props;
---
<section class:list={["relative bg-[color:var(--color-leche)] overflow-hidden", { "hero-rojo": mensajes?.length }]}>
  <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-12 sm:py-20 grid gap-10 md:grid-cols-2 items-center">
    <div>
      {eyebrow && (
        <p class="numeracion mb-3">{eyebrow}</p>
      )}
      {mensajes?.length ? (
        <div class="mensajes" data-mensajes>
          <div
            class="mensajes-pista"
            role="region"
            aria-roledescription="carrusel"
            aria-label="Lo que decimos"
          >
            {mensajes.map((m, i) => {
              const Etiqueta = i === 0 ? "h1" : "p";
              return (
                <div
                  class:list={["mensaje", { activo: i === 0 }]}
                  data-mensaje
                  role="group"
                  aria-roledescription="mensaje"
                  aria-label={`${i + 1} de ${mensajes.length}`}
                  aria-hidden={i === 0 ? undefined : "true"}
                >
                  <Etiqueta class="font-[family-name:var(--font-display)] italic text-[1.625rem] sm:text-4xl xl:text-5xl leading-[1.15] text-[color:var(--color-ink)]">
                    «{m.texto}»
                  </Etiqueta>
                  {m.sub && (
                    <p class="mt-3 sm:mt-4 max-w-lg font-[family-name:var(--font-display)] italic text-base sm:text-lg text-[color:var(--color-ink-muted)]">
                      {m.sub}
                    </p>
                  )}
                </div>
              );
            })}
          </div>
        </div>
      ) : (
        <>
          <h1 class="text-4xl sm:text-6xl lg:text-7xl leading-[0.95] text-[color:var(--color-ink)]">
            {title}
            {italicTail && <em class="italic text-[color:var(--color-accent-dark)] font-normal block">{italicTail}</em>}
          </h1>
          {body && <p class="mt-5 max-w-md text-[color:var(--color-ink-muted)] text-lg">{body}</p>}
        </>
      )}
      <div class="mt-7 flex flex-wrap gap-3">
        {primaryCta && (
          <a href={primaryCta.href} class="btn btn-rojo">
            {primaryCta.label} →
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn-secundario">
            {secondaryCta.label}
          </a>
        )}
      </div>
    </div>
    {video ? (
      <div class="relative aspect-[4/5] md:aspect-[5/4] md:max-h-[80vh] overflow-hidden border border-[color:var(--color-avellana)] bg-[color:var(--color-moka)]">
        <video
          class="w-full h-full object-cover"
          src={video.src}
          poster={video.poster}
          autoplay
          muted
          loop
          playsinline
          preload="metadata"
          aria-label={imageAlt}
          data-hero-video
        />
      </div>
    ) : image && (
      <div class="relative aspect-[4/3] md:aspect-[5/4] overflow-hidden border border-[color:var(--color-avellana)]">
        {typeof image === "string"
          ? <img src={image} alt={imageAlt} width="900" height="700" class="w-full h-full object-cover" />
          : <Image quality={80} src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes="(min-width:768px) 600px, 100vw" class="w-full h-full object-cover" />
        }
      </div>
    )}
  </div>
</section>

<style>
  /* Todos los mensajes en la misma celda: la caja mide lo que el más largo y
     el texto de abajo no salta al cambiar. */
  .mensajes-pista {
    display: grid;
  }
  .mensaje {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(14px);
    visibility: hidden;
    transition:
      opacity 0.8s ease,
      transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1),
      visibility 0s linear 0.8s;
  }
  .mensaje.activo {
    opacity: 1;
    transform: none;
    visibility: visible;
    transition-delay: 0.25s, 0.25s, 0s;
  }
  /* Escritorio: los mensajes sobre rojo teja y en blanco. Los botones se
     invierten para leerse sobre el rojo: el principal, blanco relleno; el
     secundario, contorno blanco. En el móvil no cambia nada. */
  @media (min-width: 768px) {
    .hero-rojo {
      background: var(--color-teja);
    }
    .hero-rojo .numeracion,
    .hero-rojo .mensaje :is(h1, p) {
      color: var(--color-leche);
    }
    .hero-rojo .numeracion {
      opacity: 0.75;
    }
    .hero-rojo .mensaje p:not(:first-child) {
      opacity: 0.85;
    }
    .hero-rojo .btn-rojo {
      background: var(--color-leche);
      color: var(--color-teja);
    }
    .hero-rojo .btn-rojo:hover {
      background: var(--color-latte);
    }
    .hero-rojo .btn-secundario {
      color: var(--color-leche);
      border-color: rgb(254 252 248 / 0.55);
    }
    .hero-rojo .btn-secundario:hover {
      border-color: var(--color-leche);
    }
  }
  @media (max-width: 639.98px) {
    /* La caja mide lo que el mensaje más largo: el corto va centrado y el
       hueco se reparte arriba y abajo en vez de quedar todo debajo. */
    .mensaje {
      align-self: center;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mensaje,
    .mensaje.activo {
      transform: none;
      transition: none;
    }
  }
</style>

<script>
  /**
   * Rota los mensajes del hero cada 6 s, sin indicadores (los números y las
   * barras se quitaron a petición de Oscar, 7-10-2026). Se para con el ratón
   * o el foco dentro y con la pestaña oculta, y sigue donde iba. Con
   * «reducir movimiento» rota igual, pero más despacio y sin el fundido
   * (lo quita el CSS), porque sin indicadores no habría otra forma de ver
   * los demás mensajes.
   */
  function iniciaMensajes() {
    document.querySelectorAll<HTMLElement>("[data-mensajes]").forEach((raiz) => {
      if (raiz.dataset.listo) return;
      raiz.dataset.listo = "1";
      const mensajes = [...raiz.querySelectorAll<HTMLElement>("[data-mensaje]")];
      if (mensajes.length < 2) return;
      const DURACION = matchMedia("(prefers-reduced-motion: reduce)").matches ? 10_000 : 6_000;
      const PASO = 250;
      let actual = 0;
      let transcurrido = 0;
      let encima = false;

      const muestra = (n: number) => {
        actual = n % mensajes.length;
        mensajes.forEach((m, i) => {
          m.classList.toggle("activo", i === actual);
          if (i === actual) m.removeAttribute("aria-hidden");
          else m.setAttribute("aria-hidden", "true");
        });
      };

      raiz.addEventListener("pointerenter", () => (encima = true));
      raiz.addEventListener("pointerleave", () => (encima = false));

      const reloj = setInterval(() => {
        // Al navegar a otra página el hero sale del DOM: se apaga solo.
        if (!raiz.isConnected) return clearInterval(reloj);
        if (encima || document.hidden || raiz.contains(document.activeElement)) return;
        transcurrido += PASO;
        if (transcurrido < DURACION) return;
        transcurrido = 0;
        muestra(actual + 1);
      }, PASO);
    });
  }
  document.addEventListener("astro:page-load", iniciaMensajes);

  // Con «reducir movimiento» el vídeo se queda quieto en el póster.
  function paraSiReducido() {
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    document.querySelectorAll<HTMLVideoElement>("[data-hero-video]").forEach((v) => {
      v.removeAttribute("autoplay");
      v.pause();
    });
  }
  document.addEventListener("astro:page-load", paraSiReducido);
</script>
