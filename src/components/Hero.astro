---
import { Image } from "astro:assets";

interface Props {
  eyebrow?: string;
  title: string;
  italicTail?: string;
  body?: string;
  image: ImageMetadata | string;
  imageAlt: string;
  primaryCta?: { href: string; label: string };
  secondaryCta?: { href: string; label: string };
}
const { eyebrow, title, italicTail, body, image, imageAlt, primaryCta, secondaryCta } = Astro.props;
---
<section class="relative bg-[color:var(--color-leche)] overflow-hidden">
  <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-12 sm:py-20 grid gap-10 md:grid-cols-2 items-center">
    <div>
      {eyebrow && (
        <p class="numeracion mb-3">{eyebrow}</p>
      )}
      <h1 class="text-4xl sm:text-6xl lg:text-7xl leading-[0.95] text-[color:var(--color-ink)]">
        {title}
        {italicTail && <em class="italic text-[color:var(--color-accent-dark)] font-normal block">{italicTail}</em>}
      </h1>
      {body && <p class="mt-5 max-w-md text-[color:var(--color-ink-muted)] text-lg">{body}</p>}
      <div class="mt-7 flex flex-wrap gap-3">
        {primaryCta && (
          <a href={primaryCta.href} class="btn btn-primario">
            {primaryCta.label} →
          </a>
        )}
        {secondaryCta && (
          <a href={secondaryCta.href} class="btn btn-secundario">
            {secondaryCta.label}
          </a>
        )}
      </div>
    </div>
    <div class="relative aspect-[4/3] md:aspect-[5/4] overflow-hidden border border-[color:var(--color-avellana)]">
      {typeof image === "string"
        ? <img src={image} alt={imageAlt} width="900" height="700" class="w-full h-full object-cover" />
        : <Image quality={80} src={image} alt={imageAlt} widths={[480, 800, 1200]} sizes="(min-width:768px) 600px, 100vw" class="w-full h-full object-cover" />
      }
    </div>
  </div>
</section>
