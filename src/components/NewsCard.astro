---
import { Image } from "astro:assets";
import CompraRapida from "~/components/CompraRapida.astro";
import { seCompraDesdeLaFicha } from "~/lib/pack-ficha";
import { formatDate } from "~/lib/format";
import type { ProductoEnNoticia } from "~/lib/db/noticias";

interface Props {
  slug: string;
  title: string;
  excerpt: string;
  date: Date;
  /**
   * La foto ya no es un fichero del repositorio sino una URL del almacén, y
   * `<Image>` con URL remota necesita las medidas: vienen de la base de datos,
   * guardadas al subirla, para no descargar la foto solo para medirla.
   */
  imagen: { url: string; alt: string; ancho: number; alto: number } | null;
  /**
   * Producto de la carta enlazado desde el panel, si lo hay: la tarjeta
   * enseña su precio y el mismo botón de añadir que el catálogo. Una ficha
   * desactivada se trata como si no hubiera enlace: la noticia sigue, el
   * botón no.
   */
  producto?: ProductoEnNoticia | null;
}
const { slug, title, excerpt, date, imagen, producto = null } = Astro.props;
const comprable = producto && producto.activo ? producto : null;
---
<article class="group bg-[color:var(--color-paper)] border border-[color:var(--color-line)] rounded-[var(--radius-card)] overflow-hidden shadow-[var(--shadow-card)]">
  <a href={`/noticias/${slug}`} class="block">
    <div class="aspect-[16/10] overflow-hidden">
      {imagen ? (
        <Image quality={80}
          src={imagen.url}
          alt={imagen.alt}
          width={imagen.ancho}
          height={imagen.alto}
          widths={[400, 800]}
          sizes="(min-width:768px) 400px, 100vw"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-[color:var(--color-latte)]" aria-hidden="true">
          <span class="numeracion">Foto pendiente</span>
        </div>
      )}
    </div>
  </a>
  <div class="p-5">
    <p class="numeracion">{formatDate(date)}</p>
    <h3 class="font-[family-name:var(--font-display)] text-xl mt-1">
      <a href={`/noticias/${slug}`} class="hover:text-[color:var(--color-accent-dark)]">{title}</a>
    </h3>
    <p class="text-sm text-[color:var(--color-ink-muted)] mt-2 line-clamp-3">{excerpt}</p>
    <a href={`/noticias/${slug}`} class="inline-block mt-3 text-sm text-[color:var(--color-accent-dark)] font-semibold">Leer más →</a>
    {comprable && (
      <div class="mt-4 pt-4 border-t border-[color:var(--color-line)]">
        <p class="numeracion">
          <a href={`/catalogo/${comprable.slug}`} class="hover:text-[color:var(--color-accent-dark)]">{comprable.name}</a>
        </p>
        {seCompraDesdeLaFicha(comprable) ? (
          <a href={`/catalogo/${comprable.slug}`} class="btn btn-secundario mt-3">Ver el pack</a>
        ) : (
        <CompraRapida
          slug={comprable.slug}
          name={comprable.name}
          priceCents={comprable.priceCents ?? undefined}
          priceAntesCents={comprable.precioAntesCents}
          consultar={comprable.consultar}
          agotado={comprable.agotado}
          unit={comprable.unit ?? undefined}
          variants={comprable.variantes}
        />
        )}
      </div>
    )}
  </div>
</article>
