---
import MapEmbed from "~/components/MapEmbed.astro";
import type { Store } from "~/data/stores";
import { MODE_COPY, ENTREGA_DOMICILIO_COPY } from "~/lib/entrega";

interface Props { store: Store; }
const { store } = Astro.props;
---
<article class="grid gap-6 md:grid-cols-2 items-start bg-[color:var(--color-paper)] border border-[color:var(--color-line)] rounded-[var(--radius-card)] p-5 sm:p-8 shadow-[var(--shadow-card)]">
  <div>
    <p class="numeracion">{store.shortName}</p>
    <h2 class="text-2xl sm:text-3xl mt-1">{store.name}</h2>
    <p class="text-[color:var(--color-ink-muted)] mt-3">{store.address}</p>
    <p class="text-[color:var(--color-ink-muted)]">{store.postal} {store.city}</p>

    <dl class="mt-5 grid gap-3 text-sm">
      <div>
        <dt class="numeracion">Horario</dt>
        <dd>{store.hoursText}</dd>
      </div>
      <div>
        {/* Mismo texto que el checkout (`MODE_COPY`): si cambian las
            condiciones del reparto, cambian en los dos sitios a la vez. */}
        <dt class="numeracion">{MODE_COPY.domicilio.label}</dt>
        <dd>{ENTREGA_DOMICILIO_COPY}. {MODE_COPY.domicilio.body}</dd>
      </div>
      <div>
        <dt class="numeracion">Teléfono</dt>
        <dd><a href={`tel:${store.phone}`}>{store.phoneDisplay}</a></dd>
      </div>
      {store.mobiles.length > 0 && (
        <div>
          <dt class="numeracion">{store.mobiles.length > 1 ? "Móviles" : "Móvil"}</dt>
          <dd class="flex flex-wrap gap-x-4 gap-y-1">
            {store.mobiles.map((m) => (
              <a href={`tel:${m.number}`}>{m.display}</a>
            ))}
          </dd>
        </div>
      )}
      <div>
        <dt class="numeracion">Email</dt>
        <dd><a href={`mailto:${store.email}`}>{store.email}</a></dd>
      </div>
    </dl>

    <a href={store.mapsLink} rel="noopener" target="_blank" class="btn btn-primario mt-6">
      Cómo llegar →
    </a>
  </div>
  <MapEmbed embedUrl={store.mapsEmbed} externalUrl={store.mapsLink} title={store.shortName} />
</article>
