---
interface Props {
  label: string;
  title: string;
  ctaHref: string;
  ctaLabel: string;
}
const { label, title, ctaHref, ctaLabel } = Astro.props;
---
<section class="bg-[color:var(--color-moka)] text-[color:var(--color-leche)]">
  <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <p class="text-[10px] uppercase tracking-[0.3em] font-medium text-[color:var(--color-avellana)]">{label}</p>
      <p class="font-[family-name:var(--font-display)] italic text-2xl sm:text-3xl mt-1">{title}</p>
    </div>
    <a href={ctaHref} class="btn btn-claro">{ctaLabel} →</a>
  </div>
</section>
