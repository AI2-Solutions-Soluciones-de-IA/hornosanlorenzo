---
import { Image } from "astro:assets";
import CompraRapida from "~/components/CompraRapida.astro";
import { categoryById, isCategoryId, type CategoryId } from "~/data/categories";

interface Props {
  slug: string;
  name: string;
  category: CategoryId;
  /** Etiqueta de la sección de la carta; manda sobre la categoría. */
  seccionLabel?: string;
  /** Foto del almacén con sus medidas, o nada si la ficha aún no tiene. */
  imagen?: { url: string; alt: string; ancho: number; alto: number } | null;
  shortDescription: string;
  priceCents?: number;
  /** Con oferta de Este mes: el precio de siempre, que se tacha. */
  priceAntesCents?: number;
  /** La carta no da precio: se consulta con el obrador. */
  consultar?: boolean;
  /** Se ve en la carta, pero hoy no se puede comprar. */
  agotado?: boolean;
  unit?: string;
  variants?: { id: string; label: string; priceCents: number; precioAntesCents?: number }[];
  /** Etiqueta de la carta, p. ej. «Especialidad desde 1986». */
  especialidad?: string | null;
}

const {
  slug,
  name,
  category,
  seccionLabel,
  imagen = null,
  shortDescription,
  priceCents,
  priceAntesCents,
  consultar = false,
  agotado = false,
  unit,
  variants,
  especialidad = null,
} = Astro.props;

// `category` llega ya convertida con `as CategoryId` desde quien la pinta,
// pero la columna de la base de datos es texto libre sin CHECK ni FK: el
// compilador no puede garantizar que ese valor exista de verdad en
// `categories.ts`. `isCategoryId` es la comprobación en tiempo de
// ejecución; sin ella, un valor inválido tira `categoryById` (que sí
// asume que existe) y con él toda la tarjeta.
const eyebrow = seccionLabel ?? (isCategoryId(category) ? categoryById(category).label : undefined) ?? "";
---
<article class="group bg-[color:var(--color-paper)] border border-[color:var(--color-line)] rounded-[var(--radius-card)] overflow-hidden shadow-[var(--shadow-card)] hover:scale-[1.02] transition-transform duration-200">
  <a href={`/catalogo/${slug}`} class="block">
    <div class="aspect-[4/3] overflow-hidden">
      {imagen ? (
        <Image quality={80}
          src={imagen.url}
          alt={imagen.alt}
          width={imagen.ancho}
          height={imagen.alto}
          widths={[300, 600, 900]}
          sizes="(min-width:1024px) 360px, (min-width:640px) 50vw, 100vw"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
        />
      ) : (
        <div
          class="w-full h-full flex items-center justify-center bg-[color:var(--color-latte)] border-b border-[color:var(--color-avellana)]"
          aria-hidden="true"
        >
          <span class="numeracion">Foto pendiente</span>
        </div>
      )}
    </div>
  </a>
  <div class="p-4 sm:p-5">
    <p class="numeracion">{eyebrow}</p>
    <h3 class="font-[family-name:var(--font-display)] text-xl mt-1">
      <a href={`/catalogo/${slug}`} class="hover:text-[color:var(--color-accent-dark)]">{name}</a>
    </h3>
    {especialidad && <p class="especialidad mt-1">{especialidad}</p>}
    <p class="text-sm text-[color:var(--color-ink-muted)] mt-1 line-clamp-2">{shortDescription}</p>
    <CompraRapida
      slug={slug}
      name={name}
      priceCents={priceCents}
      priceAntesCents={priceAntesCents}
      consultar={consultar}
      agotado={agotado}
      unit={unit}
      variants={variants}
    />
  </div>
</article>
