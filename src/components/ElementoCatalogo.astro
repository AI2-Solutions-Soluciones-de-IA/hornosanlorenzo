---
/**
 * Una casilla del catálogo: la tarjeta de un producto o, si es un grupo de
 * sabores, la tarjeta agrupada. Lleva los `data-*` con los que filtran el
 * buscador y los chips (`CategoryFilter`); en un grupo, `data-search` junta
 * los nombres de todos los sabores para que buscar «bonito» encuentre la
 * tarjeta de las empanadas.
 */
import PackCard from "~/components/PackCard.astro";
import ProductCard from "~/components/ProductCard.astro";
import ProductoSaboresCard from "~/components/ProductoSaboresCard.astro";
import { grupoOfCategory, type CategoryId } from "~/data/categories";
import type { DefinicionPack } from "~/data/packs";
import { seCompraDesdeLaFicha } from "~/lib/pack-ficha";
import type { Producto } from "~/lib/db/productos";
import type { ElementoCatalogo } from "~/lib/sabores";
import { bloqueDe, isSeccionId } from "~/data/secciones";

interface Props {
  elemento: ElementoCatalogo;
  seccionLabel?: string;
  /** Sin `data-*` de filtro: el carrusel de la home no filtra. */
  sinFiltro?: boolean;
  /**
   * Las definiciones de los packs, leídas una vez por la página con
   * `definicionesPublicas` (no aquí: el porqué, en `~/lib/lectura-publica.ts`).
   */
  defsPacks: Map<string, DefinicionPack>;
}

const { elemento, seccionLabel, sinFiltro = false, defsPacks } = Astro.props;

function imagenDe(p: Producto) {
  if (!p.imageUrl || !p.imageWidth || !p.imageHeight) return null;
  return { url: p.imageUrl, alt: p.imageAlt ?? p.name, ancho: p.imageWidth, alto: p.imageHeight };
}

const primero = elemento.tipo === "producto" ? elemento.producto : elemento.sabores[0];
// Un pack no lleva compra rápida (hay que elegir): tarjeta propia. Uno sin
// definición no se puede vender y su ficha da 404, así que no se pinta.
const esPack = seCompraDesdeLaFicha(primero);
const defPack = esPack ? defsPacks.get(primero.slug) : undefined;
const search =
  elemento.tipo === "producto"
    ? `${primero.name} ${primero.shortDescription} ${seccionLabel ?? ""}`
    : `${elemento.titulo} ${elemento.sabores.map((s) => s.name).join(" ")} ${seccionLabel ?? ""}`;
const datos = sinFiltro
  ? {}
  : {
      "data-product": "",
      "data-category": primero.category,
      "data-grupo": grupoOfCategory(primero.category as CategoryId),
      // El bloque y no la sección: el chip «Empanadas y supremas» tiene que
      // dejar ver también las supremas (`dentroDe` en `secciones.ts`).
      "data-seccion": isSeccionId(primero.seccion) ? bloqueDe(primero.seccion) : (primero.seccion ?? undefined),
      "data-search": search,
    };
---
{(!esPack || defPack) && (
<div {...datos} class={sinFiltro ? "contents" : undefined}>
  {defPack ? (
    <PackCard pack={primero} def={defPack} />
  ) : elemento.tipo === "producto" ? (
    <ProductCard
      slug={primero.slug}
      name={primero.name}
      category={primero.category as CategoryId}
      seccionLabel={seccionLabel}
      imagen={imagenDe(primero)}
      shortDescription={primero.shortDescription}
      priceCents={primero.priceCents ?? undefined}
      priceAntesCents={primero.precioAntesCents}
      consultar={primero.consultar}
      agotado={primero.agotado}
      unit={primero.unit ?? undefined}
      variants={primero.variantes.map((v) => ({ id: v.variantId, label: v.label, priceCents: v.priceCents, precioAntesCents: v.precioAntesCents }))}
      especialidad={primero.especialidad}
    />
  ) : (
    <ProductoSaboresCard
      titulo={elemento.titulo}
      singular={elemento.singular}
      eyebrow={seccionLabel}
      sabores={elemento.sabores}
    />
  )}
</div>
)}
