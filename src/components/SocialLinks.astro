---
import { site } from "~/data/site";

interface Props {
  class?: string;
  tono?: "moka" | "leche";
  /** Sin recuadro y más pequeños: la franja clara de la cabecera del móvil. */
  compacto?: boolean;
}
const { class: className, tono = "moka", compacto = false } = Astro.props;

const btn =
  tono === "leche"
    ? "inline-flex h-10 w-10 items-center justify-center border border-[color:var(--color-leche)]/45 text-[color:var(--color-leche)] transition-colors hover:bg-[color:var(--color-leche)] hover:text-[color:var(--color-moka)]"
    : "inline-flex h-10 w-10 items-center justify-center border border-[color:var(--color-avellana)] text-[color:var(--color-moka)] transition-colors hover:bg-[color:var(--color-moka)] hover:text-[color:var(--color-leche)]";
const clase = compacto
  ? "inline-flex h-6 w-7 items-center justify-center text-[color:var(--color-moka)] transition-colors hover:text-[color:var(--color-teja)]"
  : btn;
const lado = compacto ? 16 : 20;
---
<div class:list={["flex", compacto ? "gap-1" : "gap-3", className]}>
  <a href={site.social.instagram} rel="noopener" target="_blank" aria-label="Instagram de Horno San Lorenzo" class={clase}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width={lado} height={lado} aria-hidden="true">
      <rect x="2" y="2" width={lado} height={lado} rx="5" />
      <circle cx="12" cy="12" r="4" />
      <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none" />
    </svg>
  </a>
  <a href={site.social.facebook} rel="noopener" target="_blank" aria-label="Facebook de Horno San Lorenzo" class={clase}>
    <svg viewBox="0 0 24 24" fill="currentColor" width={lado} height={lado} aria-hidden="true">
      <path d="M22 12a10 10 0 1 0-11.56 9.88v-6.99H7.9V12h2.54V9.8c0-2.5 1.49-3.89 3.78-3.89 1.09 0 2.24.2 2.24.2v2.46h-1.26c-1.24 0-1.63.77-1.63 1.56V12h2.78l-.44 2.89h-2.34v6.99A10 10 0 0 0 22 12z" />
    </svg>
  </a>
</div>
