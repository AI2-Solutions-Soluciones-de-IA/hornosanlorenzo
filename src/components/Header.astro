---
import { Image } from "astro:assets";
import CartBadge from "~/islands/CartBadge.tsx";
import AccesoSesion from "~/islands/AccesoSesion.tsx";
import SocialLinks from "~/components/SocialLinks.astro";
import { site } from "~/data/site";
import { mainNav } from "~/data/navigation";

// El sello de 512 px que mandó el cliente (19-10-2026), el mismo del pie.
import sello from "../../public/images/sello-hsl-512.png";
import imgDulce from "../../public/images/productos/menu-dulce.jpg";
import imgSalado from "../../public/images/productos/menu-salado.jpg";
import imgSinAlergenos from "../../public/images/productos/menu-sin-alergenos.jpg";
import imgPacks from "../../public/images/productos/menu-packs.jpg";
import imgTop from "../../public/images/productos/menu-top-ventas.jpg";
import imgParticulares from "../../public/images/productos/menu-particulares.jpg";
import imgHosteleria from "../../public/images/productos/menu-hosteleria.jpg";
import imgEmpresas from "../../public/images/productos/menu-empresas.jpg";

// Fotos del submenú de «Tienda Online» (brief: «Aquí 3 fotos con submenú 3»).
const submenuImages: Record<string, { src: ImageMetadata; alt: string }> = {
  Dulce: { src: imgDulce, alt: "Tarta de nata coronada de fresas naturales" },
  Salado: { src: imgSalado, alt: "Empanada de hojaldre entera sobre tabla de madera" },
  "Sin alérgenos": { src: imgSinAlergenos, alt: "Tarta de chocolate y trufa con cobertura brillante" },
  Packs: {
    src: imgPacks,
    alt: "Mesa de celebración con empanada, quiche, bollos preñaos, croissants, canapés y pastelitos",
  },
  "Top Ventas": {
    src: imgTop,
    alt: "Tabla de mini croissants dulces surtidos",
  },
  Particulares: {
    src: imgParticulares,
    alt: "Plancha de celebración decorada como un campo de fútbol",
  },
  Hostelería: {
    src: imgHosteleria,
    alt: "Plancha de milhojas de nata y crema, lista para racionar",
  },
  Empresas: {
    src: imgEmpresas,
    alt: "Mini canapés variados para un cóctel de empresa",
  },
};

// El panel crece con el número de entradas del submenú.
const submenuLayout: Record<number, string> = {
  2: "w-[28rem] grid-cols-2",
  3: "w-[41rem] grid-cols-3",
  4: "w-[54rem] grid-cols-4",
  5: "w-[67rem] grid-cols-5",
};

const here = Astro.url.pathname;
const isActive = (href: string) => {
  const path = href.split("?")[0];
  return path === "/" ? here === "/" : here.startsWith(path);
};
// El menú se parte en dos alrededor del sello: estas entradas a la izquierda
// y el resto a la derecha (con este reparto las dos mitades miden parecido;
// la izquierda tiene una más porque sus nombres son más cortos).
const MITAD_MENU = 4;
---
<header
  class="sticky top-0 z-50 bg-[color:var(--color-teja)]/95 backdrop-blur md:border-b border-[color:var(--color-avellana)]"
  transition:persist
>
  <!-- Banda superior: La Firma · buscador y acceso -->
  <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-3 sm:py-6 lg:py-8 xl:py-10 grid grid-cols-[1fr_auto_1fr] md:grid-cols-[1fr_7.5rem_1fr] lg:grid-cols-[1fr_11.5rem_1fr] xl:grid-cols-[1fr_13.5rem_1fr] items-center gap-4 max-md:border-b max-md:border-[color:var(--color-avellana)]">
    <!-- Buscador: solo la lupa; al pulsarla se despliega el campo a su
         derecha, flotando, para no mover el logo (en el móvil lo tapa
         mientras se escribe). Lo abre y cierra el script de abajo. -->
    <!-- Izquierda: la lupa y, desde tableta, Instagram y Facebook. Sin las
         rayas blancas del móvil hasta el sello (16-10-2026). -->
    <div class="justify-self-stretch md:justify-self-start flex items-center gap-3">
    <div class="relative" data-buscador>
      <button
        type="button"
        class="inline-flex items-center justify-center w-10 h-10 text-[color:var(--color-leche)] hover:text-[color:var(--color-latte)]"
        aria-label="Buscar en el catálogo"
        aria-expanded="false"
        aria-controls="buscador-panel"
        data-buscador-abrir
      >
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
      </button>
      <form
        id="buscador-panel"
        action="/catalogo"
        method="get"
        role="search"
        hidden
        class="absolute left-full top-1/2 -translate-y-1/2 ml-2 z-50 w-72 md:w-52 lg:w-72 max-w-[calc(100vw-5rem)] flex items-center border border-[color:var(--color-avellana)] bg-[color:var(--color-leche)] shadow-lg"
      >
        <label for="buscar" class="sr-only">Buscar en el catálogo</label>
        <input
          id="buscar"
          type="search"
          name="q"
          placeholder="¿Qué te apetece?"
          class="flex-1 min-w-0 bg-transparent px-3 py-3 text-sm text-[color:var(--color-ink)] focus:outline-none"
        />
        <button type="submit" class="px-3 py-3 text-[color:var(--color-moka)] hover:text-[color:var(--color-caramelo)]" aria-label="Buscar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
        </button>
      </form>
    </div>
    <SocialLinks tono="leche" class="hidden md:flex" />
    </div>

    <!-- El sello, el mismo del pie, en vez de la firma (8-10-2026). Desde
         768 px (tableta y escritorio) va grande y flotando en el centro, montado sobre la franja
         roja y la barra del menú, que se abre a sus dos lados. En el móvil,
         igual: más grande que la franja roja, asomando sobre la barra blanca
         del pedido; el enlace solo ocupa la altura de la franja y el sello
         cuelga de él. `alt` vacío: el enlace ya se nombra con aria-label. -->
    <a
      href="/"
      aria-label={`${site.name} — inicio`}
      class="justify-self-center max-md:relative max-md:z-10 max-md:w-[108px] max-md:h-11 md:absolute md:left-1/2 md:-translate-x-1/2 md:top-2 md:z-10"
    >
      <Image quality={85}
        src={sello}
        alt=""
        loading="eager"
        widths={[108, 216, 324]}
        sizes="108px"
        class="md:hidden absolute left-0 -top-1 w-[108px] h-[108px]"
      />
      <Image quality={85}
        src={sello}
        alt=""
        loading="eager"
        widths={[128, 192, 256, 384, 448]}
        sizes="(min-width:1280px) 216px, (min-width:1024px) 184px, 120px"
        class="hidden md:block w-[120px] h-[120px] lg:w-[184px] lg:h-[184px] xl:w-[216px] xl:h-[216px]"
      />
    </a>

    <!-- `col-start-3`: desde 768 px el sello flota y deja la columna del
         centro vacía; sin esto, estos botones se metían debajo de él. -->
    <div class="flex items-center justify-end gap-2 md:col-start-3">
      <!-- La puerta del pedido en escritorio, al lado de «Regístrate»: mismo
           tamaño y letra, pero rellena, porque es la acción principal. En el
           móvil va en su propia barra, debajo. Entre 1024 y 1280 px no cabe
           junto a «Regístrate» y «Entrar» sin descentrar el logo: ahí se
           oculta (siguen el menú y el «Ver el catálogo» de la portada). -->
      <a
        href="/catalogo"
        class="hidden md:inline-flex lg:hidden xl:inline-flex items-center h-10 px-4 rounded-[var(--radius-boton)] whitespace-nowrap bg-[color:var(--color-leche)] text-[11px] font-semibold uppercase tracking-[0.14em] text-[color:var(--color-teja)] hover:bg-[color:var(--color-latte)] transition-colors"
      >
        Haz tu pedido
      </a>
      <AccesoSesion tono="claro" client:load />

      <CartBadge client:only="react" />

      <!-- En el móvil no hay menú desplegable (al cliente no le gusta,
           21-10-2026): la cuenta va con su icono y las secciones, en la
           barra de abajo. Sin sesión, /cuenta manda a /acceso. -->
      <a
        href="/cuenta"
        class="md:hidden inline-flex items-center justify-center w-11 h-11 -mr-2 text-[color:var(--color-leche)] hover:text-[color:var(--color-latte)]"
        aria-label="Mi cuenta"
      >
        <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <circle cx="12" cy="8" r="4" />
          <path d="M4 20c1.5-3.5 4.5-5 8-5s6.5 1.5 8 5" />
        </svg>
      </a>
    </div>
  </div>

  <!-- Móvil: el pedido tiene su propia puerta. Bajo la franja roja, sobre fondo claro: un
       botón rojo con filete avellana y la letra del sello (12-10-2026). -->
  <!-- `pt-14`: deja sitio al sello, que asoma desde la franja roja. -->
  <div class="md:hidden bg-[color:var(--color-leche)] px-4 pt-14 pb-2.5 flex justify-center">
    <a
      href="/catalogo"
      class="inline-flex items-center gap-2 min-h-9 px-5 rounded-[var(--radius-boton)] border border-[color:var(--color-avellana)] bg-[color:var(--color-teja)] text-[color:var(--color-leche)] shadow-sm font-[family-name:var(--font-display)] text-sm uppercase tracking-[0.08em] hover:bg-[color:var(--color-moka)] transition-colors"
    >
      Haz tu pedido
      <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 12h14M13 6l6 6-6 6" />
      </svg>
    </a>
  </div>

  <!-- Móvil: las secciones a la vista, como la barra del escritorio: blanca
       con letra teja, sin desplegables (cada entrada lleva a su página) y sin
       «Inicio», que ya es el sello. Dos líneas centradas. Se esconde al bajar
       por la página y vuelve al subir (script de abajo, 21-10-2026). -->
  <nav aria-label="Secciones" class="secciones-movil md:hidden bg-white border-y border-[color:var(--color-avellana)]" data-secciones-movil>
    <ul class="flex flex-wrap justify-center gap-x-3 min-[380px]:gap-x-4 px-2 py-0.5 text-[10px] font-medium uppercase tracking-[0.04em] min-[380px]:tracking-[0.08em]">
      {mainNav.filter((item) => item.href !== "/").map((item) => (
        <li>
          <a
            href={item.href}
            download={item.download}
            aria-current={isActive(item.href) ? "page" : undefined}
            data-nav-principal
            class="flex items-center min-h-8 border-b-2 border-transparent whitespace-nowrap text-[color:var(--color-teja)]/85 aria-[current=page]:text-[color:var(--color-teja)] aria-[current=page]:border-[color:var(--color-teja)]"
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>

  <!-- Banda de navegación: las cuatro secciones -->
  <nav
    aria-label="Principal"
    class="hidden md:block bg-white border-t border-[color:var(--color-avellana)]"
  >
    <!-- Blanca con las letras en teja, el rojo de la cabecera (vuelve el
         12-10-2026, tras unos días roja): contraste de sobra (más de 9:1). -->
    <!-- `relative` aquí y no en cada <li>: los desplegables se centran en la
         barra entera, no bajo su enlace. Centrados bajo el enlace, los anchos
         (hasta 54rem) se salían por la derecha y, aunque estén ocultos
         (`invisible`), ensanchaban la página: scroll lateral a 1024 px. -->
    <!-- Desde 768 px (la barra no sale en el móvil), dos mitades con el
         hueco del sello en medio; en tableta, letra más junta para que quepa. -->
    <div class="relative mx-auto max-w-6xl md:max-w-none px-4 sm:px-6 2xl:px-10 flex items-stretch justify-center gap-3 md:grid md:grid-cols-[1fr_7.5rem_1fr] lg:grid-cols-[1fr_11.5rem_1fr] xl:grid-cols-[1fr_13.5rem_1fr] md:gap-0 text-[10px] xl:text-[11px] font-medium uppercase tracking-[0.02em] lg:tracking-[0.1em] xl:tracking-[0.14em] 2xl:tracking-[0.16em]">
    {[mainNav.slice(0, MITAD_MENU), mainNav.slice(MITAD_MENU)].map((grupo, g) => (
    <>
    {g === 1 && <div class="hidden md:block" aria-hidden="true"></div>}
    <ul class:list={["contents md:flex md:items-stretch md:gap-2 lg:gap-4 xl:gap-7 2xl:gap-10", g === 0 ? "md:justify-end md:pr-1 lg:pr-4 xl:pr-6" : "md:justify-start md:pl-1 lg:pl-4 xl:pl-6"]}>
      {grupo.map((item) => {
        const active = isActive(item.href);
        // La raya sale de `aria-current`, no de una clase: la cabecera es
        // `transition:persist` y no se vuelve a pintar al cambiar de página,
        // así que el script de abajo mueve el atributo (16-10-2026).
        const linkClass = [
          "flex items-center h-full py-4 border-b-2 transition-colors whitespace-nowrap",
          "text-[color:var(--color-teja)]/85 border-transparent hover:text-[color:var(--color-teja)] not-aria-[current=page]:hover:border-[color:var(--color-teja)]/50",
          "aria-[current=page]:text-[color:var(--color-teja)] aria-[current=page]:border-[color:var(--color-teja)]",
        ];

        if (!item.children) {
          return (
            // En tableta (768–1023 px) no caben las siete: sale «Inicio»,
            // que ya es el sello (19-10-2026).
            <li class:list={[item.href === "/" && "md:max-lg:hidden"]}>
              <a
                href={item.href}
                download={item.download}
                aria-current={active ? "page" : undefined}
                data-nav-principal
                class:list={linkClass}
              >
                {item.label}
              </a>
            </li>
          );
        }

        return (
          <li class="group">
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              data-nav-principal
              aria-haspopup="true"
              class:list={[...linkClass, "gap-1.5"]}
            >
              {item.label}
              <svg viewBox="0 0 12 12" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true" class="shrink-0">
                <path d="m2 4.5 4 3.5 4-3.5" />
              </svg>
            </a>

            <div
              class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity absolute left-1/2 -translate-x-1/2 top-full z-50 pt-px"
            >
              <div class:list={["bg-[color:var(--color-leche)] border border-[color:var(--color-avellana)] p-6 grid gap-5 max-w-[calc(100vw-2rem)]", submenuLayout[item.children.length] ?? submenuLayout[3]]}>
                {item.children.map((child) => {
                  const photo = submenuImages[child.label];
                  return (
                    <a href={child.href} class="group/card block">
                      {photo && (
                        <div class="aspect-[4/3] overflow-hidden border border-[color:var(--color-avellana)]">
                          <Image quality={80}
                            src={photo.src}
                            alt={photo.alt}
                            widths={[200, 400]}
                            sizes="200px"
                            class="w-full h-full object-cover transition-transform duration-300 group-hover/card:scale-[1.04]"
                          />
                        </div>
                      )}
                      <p class="mt-3 font-[family-name:var(--font-display)] text-base normal-case tracking-normal text-[color:var(--color-moka)] group-hover/card:text-[color:var(--color-caramelo)] transition-colors">
                        {child.label}
                      </p>
                      <p class="mt-1 text-[11px] leading-snug normal-case tracking-normal font-normal text-[color:var(--color-ink-muted)]">
                        {child.short}
                      </p>
                    </a>
                  );
                })}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
    </>
    ))}
    </div>
  </nav>

</header>

<script>
  // Buscador de la cabecera: la lupa abre y cierra el campo. Por delegación
  // en `document`, como el menú móvil: sobrevive a la navegación sin recarga.
  const panelBuscador = () => document.getElementById("buscador-panel");
  const lupa = () => document.querySelector<HTMLButtonElement>("[data-buscador-abrir]");
  const cierraBuscador = () => {
    const panel = panelBuscador();
    if (!panel || panel.hidden) return;
    panel.hidden = true;
    lupa()?.setAttribute("aria-expanded", "false");
  };

  document.addEventListener("keydown", (e) => {
    if (e.key !== "Escape" || panelBuscador()?.hidden !== false) return;
    cierraBuscador();
    lupa()?.focus();
  });

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;

    if (target?.closest("[data-buscador-abrir]")) {
      const panel = panelBuscador();
      if (!panel) return;
      panel.hidden = !panel.hidden;
      lupa()?.setAttribute("aria-expanded", String(!panel.hidden));
      if (!panel.hidden) panel.querySelector("input")?.focus();
      return;
    }
    if (!target?.closest("[data-buscador]")) cierraBuscador();
  });

  /**
   * Marca la entrada del menú de la página actual. La cabecera persiste entre
   * páginas, así que lo que pintó el servidor se queda con la primera; misma
   * regla que `isActive` del frontmatter.
   */
  function marcaMenu() {
    const aqui = location.pathname;
    document.querySelectorAll<HTMLAnchorElement>("[data-nav-principal]").forEach((a) => {
      const ruta = new URL(a.href).pathname;
      const activa = ruta === "/" ? aqui === "/" : aqui.startsWith(ruta);
      if (activa) a.setAttribute("aria-current", "page");
      else a.removeAttribute("aria-current");
    });
  }
  /**
   * Móvil: la barra de secciones se esconde al bajar y vuelve al subir. Al
   * plegarse, la cabecera encoge y el navegador recoloca el scroll; sin la
   * pausa (`hasta`), ese salto se leía como «subir» y la barra parpadeaba.
   */
  const secciones = () => document.querySelector<HTMLElement>("[data-secciones-movil]");
  const esMovil = window.matchMedia("(max-width: 767px)");
  let ultimaY = window.scrollY;
  let hasta = 0;
  const muestraSecciones = (ver: boolean) => {
    const el = secciones();
    if (!el || el.hasAttribute("data-oculta") === !ver) return;
    el.toggleAttribute("data-oculta", !ver);
    hasta = performance.now() + 400;
  };
  window.addEventListener(
    "scroll",
    () => {
      const y = window.scrollY;
      if (!esMovil.matches || performance.now() < hasta) {
        ultimaY = y;
        return;
      }
      if (y < 80) muestraSecciones(true);
      else if (Math.abs(y - ultimaY) < 10) return;
      else muestraSecciones(y < ultimaY);
      ultimaY = y;
    },
    { passive: true },
  );
  document.addEventListener("astro:page-load", () => {
    ultimaY = window.scrollY;
    muestraSecciones(true);
  });
  document.addEventListener("astro:page-load", marcaMenu);
  document.addEventListener("astro:page-load", cierraBuscador);
</script>

<style>
  .secciones-movil {
    max-height: 6rem;
    overflow: hidden;
    transition:
      max-height 0.25s ease,
      border-color 0.25s ease;
  }
  .secciones-movil[data-oculta] {
    max-height: 0;
    border-color: transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .secciones-movil {
      transition: none;
    }
  }
</style>
