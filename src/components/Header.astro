---
import { Image } from "astro:assets";
import CartBadge from "~/islands/CartBadge.tsx";
import AccesoSesion from "~/islands/AccesoSesion.tsx";
import SocialLinks from "~/components/SocialLinks.astro";
import { site } from "~/data/site";
import { mainNav } from "~/data/navigation";

import logoHsl from "../../public/images/logo-hsl.png";
import imgDulce from "../../public/images/productos/tarta-tres-chocolates.jpg";
import imgSalado from "../../public/images/productos/quiche-lorraine.jpg";
import imgPacks from "../../public/images/productos/bolleria.jpeg";
import imgTop from "../../public/images/productos/croissant-mantequilla.jpg";
import imgParticulares from "../../public/images/productos/foto-tarta-fresas.jpg";
import imgHosteleria from "../../public/images/productos/foto-empanadas.jpg";
import imgEmpresas from "../../public/images/productos/foto-croissants.jpg";

// Fotos del submenú de «Tienda Online» (brief: «Aquí 3 fotos con submenú 3»).
const submenuImages: Record<string, { src: ImageMetadata; alt: string }> = {
  Dulce: { src: imgDulce, alt: "Tarta de tres chocolates cortada" },
  Salado: { src: imgSalado, alt: "Quiche lorraine dorada, recién horneada" },
  Packs: { src: imgPacks, alt: "Surtido de bollería de obrador" },
  "Top Ventas": {
    src: imgTop,
    alt: "Croissants de mantequilla recién horneados",
  },
  Particulares: {
    src: imgParticulares,
    alt: "Tartas de fresa recién montadas en el obrador",
  },
  Hostelería: {
    src: imgHosteleria,
    alt: "Empanadas de obrador recién horneadas",
  },
  Empresas: {
    src: imgEmpresas,
    alt: "Bandeja de croissants para desayuno de equipo",
  },
};

// El panel crece con el número de entradas del submenú.
const submenuLayout: Record<number, string> = {
  2: "w-[28rem] grid-cols-2",
  3: "w-[41rem] grid-cols-3",
  4: "w-[54rem] grid-cols-4",
};

const here = Astro.url.pathname;
const isActive = (href: string) => {
  const path = href.split("?")[0];
  return path === "/" ? here === "/" : here.startsWith(path);
};
---
<header
  class="sticky top-0 z-50 bg-[color:var(--color-teja)]/95 backdrop-blur border-b border-[color:var(--color-avellana)]"
  transition:persist
>
  <!-- La cinta cromática: la paleta en proporción, una por pieza -->
  <div class="cinta" aria-hidden="true">
    <span style="flex:70;background:var(--color-leche)"></span>
    <span style="flex:14;background:var(--color-latte)"></span>
    <span style="flex:8;background:var(--color-avellana)"></span>
    <span style="flex:4;background:var(--color-caramelo)"></span>
    <span style="flex:3;background:var(--color-moka)"></span>
    <span style="flex:1;background:var(--color-teja)"></span>
  </div>

  <!-- Banda superior: La Firma · buscador y acceso -->
  <div class="mx-auto max-w-6xl px-4 sm:px-6 py-4 sm:py-6 grid grid-cols-[1fr_auto_1fr] items-center gap-4">
    <div aria-hidden="true"></div>

    <a href="/" aria-label={`${site.name} — inicio`} class="justify-self-center">
      <!-- Logo del cliente en su versión clara, para fondo oscuro (30-9-2026):
           se lee sobre el rojo teja tal cual, sin invertirlo por CSS como la
           firma de antes. `alt` vacío: el enlace ya se nombra con aria-label. -->
      <Image quality={85}
        src={logoHsl}
        alt=""
        widths={[200, 320, 480, 640]}
        sizes="(min-width:1024px) 210px, (min-width:640px) 190px, 160px"
        class="w-[160px] sm:w-[190px] lg:w-[210px] h-auto"
      />
    </a>

    <div class="flex items-center justify-end gap-2">
      <form
        action="/catalogo"
        method="get"
        role="search"
        class="hidden lg:flex items-center border-b border-[color:var(--color-leche)]/45 focus-within:border-[color:var(--color-leche)] transition-colors"
      >
        <label for="buscar" class="sr-only">Buscar en el catálogo</label>
        <input
          id="buscar"
          type="search"
          name="q"
          placeholder="Buscar"
          class="w-24 xl:w-32 bg-transparent py-2 text-sm text-[color:var(--color-leche)] placeholder:text-[color:var(--color-leche)]/65 focus:outline-none"
        />
        <button type="submit" class="p-2 text-[color:var(--color-leche)] hover:text-[color:var(--color-latte)]" aria-label="Buscar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
        </button>
      </form>

      <AccesoSesion tono="claro" client:load />

      <CartBadge client:only="react" />

      <button
        class="md:hidden inline-flex items-center justify-center w-12 h-12 border border-[color:var(--color-leche)]/45 text-[color:var(--color-leche)]"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-mobile-nav-toggle
        type="button"
      >
        ☰
      </button>
    </div>
  </div>

  <!-- Móvil: la barra de secciones se pliega tras el ☰, así que el pedido
       necesita una puerta propia. Ocupa el hueco que deja esa barra.
       Va en claro, no en teja: la cabecera ya es roja. -->
  <div class="md:hidden border-t border-[color:var(--color-leche)]/25 px-4 py-2">
    <a
      href="/catalogo"
      class="btn btn-claro w-full min-h-10 text-[13px] uppercase tracking-[0.12em]"
    >
      Haz tu pedido
    </a>
  </div>

  <!-- Banda de navegación: las cuatro secciones -->
  <nav
    aria-label="Principal"
    class="hidden md:block bg-[color:var(--color-latte)] border-t border-[color:var(--color-avellana)]"
  >
    <ul class="mx-auto max-w-6xl px-4 sm:px-6 flex items-stretch justify-center gap-8 lg:gap-12 text-[11px] font-medium uppercase tracking-[0.16em]">
      {mainNav.map((item) => {
        const active = isActive(item.href);
        const linkClass = [
          "flex items-center h-full py-4 border-b-2 transition-colors",
          active
            ? "text-[color:var(--color-moka)] border-[color:var(--color-moka)]"
            : "text-[color:var(--color-ink-muted)] border-transparent hover:text-[color:var(--color-moka)]",
        ];

        if (!item.children) {
          return (
            <li>
              <a
                href={item.href}
                download={item.download}
                aria-current={active ? "page" : undefined}
                class:list={linkClass}
              >
                {item.label}
              </a>
            </li>
          );
        }

        return (
          <li class="relative group">
            <a
              href={item.href}
              aria-current={active ? "page" : undefined}
              aria-haspopup="true"
              class:list={[...linkClass, "gap-1.5"]}
            >
              {item.label}
              <svg viewBox="0 0 12 12" width="9" height="9" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <path d="m2 4.5 4 3.5 4-3.5" />
              </svg>
            </a>

            <div
              class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 transition-opacity absolute left-1/2 -translate-x-1/2 top-full z-50 pt-px"
            >
              <div class:list={["bg-[color:var(--color-leche)] border border-[color:var(--color-avellana)] p-6 grid gap-5", submenuLayout[item.children.length] ?? submenuLayout[3]]}>
                {item.children.map((child) => {
                  const photo = submenuImages[child.label];
                  return (
                    <a href={child.href} class="group/card block">
                      {photo && (
                        <div class="aspect-[4/3] overflow-hidden border border-[color:var(--color-avellana)]">
                          <Image quality={80}
                            src={photo.src}
                            alt={photo.alt}
                            widths={[200, 400]}
                            sizes="200px"
                            class="w-full h-full object-cover transition-transform duration-300 group-hover/card:scale-[1.04]"
                          />
                        </div>
                      )}
                      <p class="mt-3 font-[family-name:var(--font-display)] text-base normal-case tracking-normal text-[color:var(--color-moka)] group-hover/card:text-[color:var(--color-caramelo)] transition-colors">
                        {child.label}
                      </p>
                      <p class="mt-1 text-[11px] leading-snug normal-case tracking-normal font-normal text-[color:var(--color-ink-muted)]">
                        {child.short}
                      </p>
                    </a>
                  );
                })}
              </div>
            </div>
          </li>
        );
      })}
    </ul>
  </nav>

  <!-- Menú móvil (plegado) -->
  <nav
    id="mobile-nav"
    aria-label="Móvil"
    class="md:hidden hidden bg-[color:var(--color-latte)] border-t border-[color:var(--color-avellana)]"
  >
    <div class="mx-auto max-w-6xl px-4 py-3 flex flex-col">
      <form action="/catalogo" method="get" role="search" class="flex items-center border border-[color:var(--color-avellana)] mb-3 bg-[color:var(--color-leche)]">
        <label for="buscar-movil" class="sr-only">Buscar en el catálogo</label>
        <input
          id="buscar-movil"
          type="search"
          name="q"
          placeholder="Buscar"
          class="flex-1 bg-transparent px-3 py-3 text-sm text-[color:var(--color-moka)] placeholder:text-[color:var(--color-ink-muted)] focus:outline-none"
        />
        <button type="submit" class="px-3 py-3 text-[color:var(--color-moka)]" aria-label="Buscar">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" />
          </svg>
        </button>
      </form>

      <ul class="flex flex-col text-[11px] font-medium uppercase tracking-[0.16em]">
        {mainNav.map((item) => (
          <li class="border-b border-[color:var(--color-avellana)]">
            <a
              href={item.href}
              download={item.download}
              data-mobile-nav-link
              class="block py-3 text-[color:var(--color-moka)]"
            >
              {item.label}
            </a>
            {item.children && (
              <ul class="pb-2 pl-4 flex flex-col">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      data-mobile-nav-link
                      class="block py-2 text-[color:var(--color-ink-muted)] normal-case tracking-normal text-xs"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <AccesoSesion tono="moka" client:load />
      <SocialLinks tono="moka" class="mt-4 pt-4 border-t border-[color:var(--color-avellana)]" />
    </div>
  </nav>
</header>

<script>
  const nav = () => document.getElementById("mobile-nav");
  const toggle = () =>
    document.querySelector<HTMLButtonElement>("[data-mobile-nav-toggle]");

  const closeMobileNav = () => {
    nav()?.classList.add("hidden");
    toggle()?.setAttribute("aria-expanded", "false");
  };

  document.addEventListener("click", (e) => {
    const target = e.target as HTMLElement | null;

    if (target?.closest("[data-mobile-nav-toggle]")) {
      const el = nav();
      const open = el?.classList.toggle("hidden") === false;
      toggle()?.setAttribute("aria-expanded", String(open));
      return;
    }

    // Close immediately on tap (before navigation finishes)
    if (target?.closest("[data-mobile-nav-link]")) closeMobileNav();
  });

  // Also close after every view-transition page swap (covers back/forward)
  document.addEventListener("astro:page-load", closeMobileNav);
</script>
