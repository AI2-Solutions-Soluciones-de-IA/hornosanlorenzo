---
import { Image, getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { statSync } from "node:fs";
import MarketingLayout from "~/layouts/MarketingLayout.astro";

/**
 * La carta impresa, página a página, con la opción de descargar el PDF.
 *
 * En carrusel, de dos en dos, para no hacer bajar doce páginas. Se enseña
 * como imágenes y no incrustando el PDF: en iPhone un PDF dentro de
 * un iframe solo muestra la primera página. Las imágenes salen de ese mismo
 * PDF (cómo regenerarlas, en `src/assets/carta/LEEME.md`).
 */
const PDF = "/carta-horno-san-lorenzo.pdf";
// Se mide al construir: la página es estática y el PDF va en `public/`.
const pesoPdf = `${(statSync(`public${PDF}`).size / 1024 / 1024).toFixed(1).replace(".", ",")} MB`;

const paginas = Object.entries(
  import.meta.glob<{ default: ImageMetadata }>("../assets/carta/pagina-*.jpg", { eager: true }),
)
  // Orden numérico: con diez páginas o más, «pagina-10» iría detrás de la 1.
  .sort(([a], [b]) => a.localeCompare(b, undefined, { numeric: true }))
  .map(([, m]) => m.default);

// Para el visor: cada página a su tamaño original (1200 px de ancho), que es
// lo que se ve al ampliar. Se carga solo al abrirla.
const grandes = await Promise.all(
  paginas.map((img) => getImage({ src: img, width: img.width, quality: 80 })),
);
---
<MarketingLayout
  title="Carta"
  description="La carta del obrador, con precios y raciones. Consúltala aquí o descárgala en PDF."
>
  <section class="mx-auto max-w-4xl px-4 sm:px-6 py-10 sm:py-14">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <h1 class="font-[family-name:var(--font-display)] text-3xl sm:text-4xl">La carta</h1>
        <p class="mt-2 text-sm text-[color:var(--color-ink-muted)]">
          {paginas.length} páginas · PDF de {pesoPdf}
        </p>
      </div>
      <a href={PDF} download class="btn btn-primario">Descargar PDF</a>
    </div>

    <!-- Página a página en horizontal: de dos en dos desde tablet, una en el
         móvil (dos en 390 px no se leen). Cada flecha pasa lo que se ve. -->
    <div class="mt-8" data-carrusel="pantalla">
    <div class="carta-marco">
      <button type="button" class="carta-flecha carta-flecha--prev" data-carrusel-prev aria-controls="carta-paginas" aria-label="Páginas anteriores">‹</button>
      <button type="button" class="carta-flecha carta-flecha--next" data-carrusel-next aria-controls="carta-paginas" aria-label="Páginas siguientes">›</button>
      <ol
        id="carta-paginas"
        class="carta-pista flex gap-4 overflow-x-auto snap-x snap-mandatory"
        data-carrusel-pista
        role="region"
        aria-roledescription="carrusel"
        aria-label="Páginas de la carta"
        tabindex="0"
      >
        {paginas.map((img, i) => (
          <li class="carta-pagina snap-start shrink-0 border border-[color:var(--color-avellana)] bg-[color:var(--color-leche)]">
            <button
              type="button"
              class="carta-abrir"
              data-visor-abrir={i}
              data-grande={grandes[i].src}
              aria-label={`Ampliar la página ${i + 1}`}
            >
            <Image
              src={img}
              alt={`Carta del obrador, página ${i + 1} de ${paginas.length}`}
              widths={[480, 720, 1080]}
              sizes="(min-width: 640px) 440px, calc(100vw - 2rem)"
              quality={80}
              loading={i < 2 ? "eager" : "lazy"}
              class="block w-full h-auto"
            />
            </button>
          </li>
        ))}
      </ol>
    </div>
    <p class="carta-contador numeracion mt-4 text-center" aria-live="polite">
      Páginas <span data-carrusel-contador>1–2 de {paginas.length}</span>
    </p>
    <p class="mt-1 text-center text-sm text-[color:var(--color-ink-muted)]">
      Pulsa una página para verla en grande.
    </p>
    </div>

    <!-- Visor: una página a pantalla completa, con zoom. Se abre con
         `showModal`, así que Esc cierra y el foco queda dentro. -->
    <dialog class="visor" data-visor aria-label="Página de la carta ampliada">
      <div class="visor-barra">
        <button type="button" class="visor-boton" data-visor-prev aria-label="Página anterior">‹</button>
        <span class="visor-pagina numeracion" aria-live="polite" data-visor-pagina></span>
        <button type="button" class="visor-boton" data-visor-next aria-label="Página siguiente">›</button>
        <span class="visor-hueco"></span>
        <button type="button" class="visor-boton" data-visor-menos aria-label="Reducir">−</button>
        <span class="visor-zoom numeracion" data-visor-zoom></span>
        <button type="button" class="visor-boton" data-visor-mas aria-label="Ampliar">+</button>
        <button type="button" class="visor-boton" data-visor-cerrar aria-label="Cerrar">×</button>
      </div>
      <div class="visor-lienzo" data-visor-lienzo>
        <img data-visor-img alt="" width="1200" height="2134" />
      </div>
    </dialog>
  </section>
</MarketingLayout>

<style>
  .carta-marco {
    position: relative;
  }
  .carta-pista {
    scroll-behavior: smooth;
    scrollbar-width: none;
    list-style: none;
    padding: 0;
  }
  .carta-pista::-webkit-scrollbar {
    display: none;
  }
  .carta-pista:focus-visible {
    outline: 2px solid var(--color-caramelo);
    outline-offset: 4px;
  }
  .carta-pagina {
    flex-basis: 100%;
  }
  @media (min-width: 640px) {
    .carta-pagina {
      flex-basis: calc((100% - 1rem) / 2);
    }
    /* De dos en dos, el carrusel solo encaja en las impares: al girar la
       tablet con la 2 abierta se ve 1–2, no 2–3. */
    .carta-pagina:nth-child(even) {
      scroll-snap-align: none;
    }
  }
  .carta-flecha {
    position: absolute;
    z-index: 2;
    top: 50%;
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-avellana);
    background: var(--color-leche);
    color: var(--color-moka);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }
  .carta-flecha--prev {
    left: 8px;
  }
  .carta-flecha--next {
    right: 8px;
  }
  .carta-flecha:hover {
    background: var(--color-latte);
  }
  .carta-flecha:disabled {
    opacity: 0;
    pointer-events: none;
  }
  /* En el móvil la página ocupa todo el ancho y las flechas tapaban nombres
     y precios: bajan a la fila del contador, una a cada lado. */
  @media (max-width: 639px) {
    .carta-marco {
      padding-bottom: 60px;
    }
    .carta-flecha {
      top: auto;
      bottom: 0;
      transform: none;
    }
    .carta-flecha--prev {
      left: 0;
    }
    .carta-flecha--next {
      right: 0;
    }
    .carta-contador {
      margin-top: -44px;
      line-height: 44px;
    }
  }
  .carta-abrir {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .carta-abrir:focus-visible {
    outline: 2px solid var(--color-caramelo);
    outline-offset: -2px;
  }

  .visor {
    width: 100vw;
    height: 100dvh;
    max-width: none;
    max-height: none;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--color-leche);
    color: var(--color-moka);
  }
  .visor[open] {
    display: flex;
    flex-direction: column;
  }
  .visor::backdrop {
    background: var(--color-moka);
  }
  .visor-barra {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 8px;
    border-bottom: 1px solid var(--color-avellana);
  }
  .visor-hueco {
    flex: 1;
  }
  .visor-pagina,
  .visor-zoom {
    min-width: 4.5em;
    text-align: center;
    font-size: 14px;
  }
  .visor-boton {
    width: 44px;
    height: 44px;
    flex-shrink: 0;
    border: 1px solid var(--color-avellana);
    background: var(--color-leche);
    color: var(--color-moka);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }
  .visor-boton:hover {
    background: var(--color-latte);
  }
  .visor-boton:disabled {
    opacity: 0.35;
    cursor: default;
    background: var(--color-leche);
  }
  .visor-lienzo {
    flex: 1;
    overflow: auto;
    overscroll-behavior: contain;
    padding: 12px;
  }
  .visor-lienzo img {
    display: block;
    max-width: none;
    height: auto;
    margin: 0 auto;
    border: 1px solid var(--color-avellana);
    cursor: zoom-in;
  }
  .visor-lienzo[data-ampliado] img {
    cursor: zoom-out;
  }
  @media (max-width: 480px) {
    .visor-barra {
      gap: 4px;
      padding: 6px;
    }
    .visor-pagina,
    .visor-zoom {
      min-width: 3.5em;
      font-size: 13px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .carta-pista {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import "~/scripts/carrusel";
  import "~/scripts/visor-carta";
</script>
