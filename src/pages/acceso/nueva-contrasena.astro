---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import NuevaContrasenaForm from "~/islands/NuevaContrasenaForm.tsx";
---
<MarketingLayout
  title="Cambiar contraseña"
  description="Pon una contraseña nueva para tu cuenta."
>
  <section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-12 sm:py-16">
    <p class="numeracion">Acceso clientes</p>
    <h1 class="text-4xl sm:text-5xl mt-2">Pon una contraseña nueva</h1>
    <p class="text-[color:var(--color-ink-muted)] mt-3 max-w-xl">
      Escríbela dos veces para no equivocarte.
    </p>

    <div class="mt-8">
      <NuevaContrasenaForm client:load />
    </div>
  </section>
</MarketingLayout>
