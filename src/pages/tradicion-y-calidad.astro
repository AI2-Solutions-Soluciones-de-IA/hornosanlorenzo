---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import { tradicion } from "~/data/tradicion";
---
<MarketingLayout
  title="Tradición y Calidad"
  description="Más de 40 años de obrador propio, y todos se los debemos a nuestros clientes: particulares, hostelería y empresas."
>
  <!-- Diseño de la imagen «tradicion y calidad» del cliente (17-10-2026):
       cabecera roja con la foto del obrador a la derecha, a sangre; tres
       tarjetas de agradecimiento montadas sobre su borde inferior. -->
  <section class="relative flex flex-col md:block bg-[color:var(--color-teja)] text-[color:var(--color-leche)]">
    <div class="relative md:absolute md:inset-y-0 md:right-0 md:w-1/2 order-last aspect-[4/3] md:aspect-auto bg-[color:var(--color-moka)]">
      <img
        src="/images/tradicion-principal.jpg"
        alt="Una panadera coloca tartas de chocolate recién hechas junto al horno de leña del obrador"
        width="900"
        height="1600"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-[center_55%]"
      />
    </div>
    <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 pt-12 pb-14 sm:pt-20 md:pb-44">
      <div class="md:w-1/2 md:pr-12">
        <p class="numeracion antetitulo" style="color:var(--color-avellana)">{tradicion.cabecera.antetitulo}</p>
        <h1 class="text-4xl sm:text-5xl lg:text-6xl mt-5 leading-[1.05]">
          {tradicion.cabecera.titulo.map((linea) => <span class="block">{linea}</span>)}
        </h1>
        <p class="mt-6 max-w-md text-sm sm:text-base leading-relaxed text-[color:var(--color-leche)]/85">{tradicion.cabecera.texto}</p>
      </div>
    </div>
  </section>

  <section class="relative z-10 mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 -mt-8 md:-mt-28">
    <div class="grid gap-6 md:grid-cols-3 md:gap-8 lg:px-8">
      {tradicion.gracias.map((g) => (
        <article class="gracias-tarjeta flex flex-col bg-white p-7 sm:p-9">
          <p class="numeracion" style="color:var(--color-teja)">{g.canal}</p>
          <h2 class="text-2xl sm:text-3xl mt-3 leading-tight">{g.title}</h2>
          <p class="mt-4 text-sm leading-relaxed text-[color:var(--color-ink-muted)]">{g.body}</p>
          <p class="mt-auto pt-6">
            <span class="block border-t border-[color:var(--color-latte)] pt-5 font-[family-name:var(--font-display)] italic text-[color:var(--color-teja)] leading-snug">{g.cita}</span>
          </p>
        </article>
      ))}
    </div>
  </section>

  <!-- Manifiesto (Brand Guidelines Avellana, diapositiva 8): el texto a la
       izquierda y la playa de San Lorenzo, que da nombre a la casa, a la
       derecha; en el móvil, la foto debajo. -->
  <section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-16 sm:py-24 grid gap-10 md:grid-cols-[7fr_5fr] lg:gap-16 lg:px-14">
    <div>
      <p class="numeracion antetitulo" style="color:var(--color-teja)">Manifiesto</p>
      <h2 class="text-4xl sm:text-5xl mt-4 leading-[1.08]">{tradicion.manifiesto.titulo}</h2>
      <p class="text-xl text-[color:var(--color-teja)] mt-6 leading-relaxed font-[family-name:var(--font-display)] italic">{tradicion.manifiesto.entradilla}</p>
      <div class="mt-8 space-y-5 text-sm sm:text-base leading-relaxed text-[color:var(--color-ink)]">
        {/* `**…**` en el texto es negrita: se parte por ahí y los trozos
            impares van en <strong>. */}
        {tradicion.manifiesto.parrafos.map((p) => (
          <p>{p.split("**").map((trozo, i) => (i % 2 === 1 ? <strong>{trozo}</strong> : trozo))}</p>
        ))}
      </div>
      <p class="mt-10 font-[family-name:var(--font-display)] italic text-2xl leading-snug">
        {tradicion.manifiesto.cierre}
      </p>
      <p class="numeracion mt-6" style="color:var(--color-teja)">{tradicion.manifiesto.firma}</p>
    </div>
    <figure class="md:mt-16">
      <div class="aspect-[4/5] overflow-hidden rounded-sm bg-[color:var(--color-latte)]">
        <img
          src="/images/playa-san-lorenzo.jpg"
          alt="La playa de San Lorenzo, en Gijón, con la iglesia de San Pedro al fondo"
          width="900"
          height="1125"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover"
        />
      </div>
      <figcaption class="mt-3 text-right">
        <span class="numeracion" style="color:var(--color-teja)">Playa de San Lorenzo · Gijón</span>
        <!-- Foto de Mentxuwiki en Wikimedia Commons, licencia CC BY-SA 4.0. -->
        <a
          href="https://commons.wikimedia.org/wiki/File:Playa_de_San_Lorenzo_en_Gij%C3%B3n_3.jpg"
          class="block mt-1 text-[0.625rem] text-[color:var(--color-ink-muted)] no-underline hover:underline"
          rel="noopener"
        >Foto: Mentxuwiki · CC BY-SA 4.0</a>
      </figcaption>
    </figure>
  </section>

  <!-- Cifras: banda roja teja a todo el ancho, como la cabecera, sin
       marcos; letra en leche. Se animan de una en una (14-10-2026). -->
  <section class="bg-[color:var(--color-teja)] text-[color:var(--color-leche)]">
    <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-12 sm:py-16">
      <dl class="cifras grid gap-8 sm:grid-cols-2 lg:grid-cols-4" data-cifras>
        {tradicion.cifras.map((c, i) => (
          <div class="cifra text-center" style={`--i:${i}`}>
            <!-- Una cifra con prefijo («+40») cuenta solo el número; el «+» se
                 queda quieto delante (16-10-2026). -->
            <dt class="font-[family-name:var(--font-display)] text-4xl sm:text-5xl">
              <span class="cifra-numero">
                {(() => {
                  const m = /^(\D*)(\d+)$/.exec(c.figure);
                  return m ? <>{m[1]}<span data-cuenta={m[2]}>{m[2]}</span></> : c.figure;
                })()}
              </span>
            </dt>
            <span class="cifra-raya" aria-hidden="true"></span>
            <dd class="numeracion mt-2" style="color:var(--color-leche)">{c.label}</dd>
            <dd class="mt-3 text-sm leading-relaxed text-[color:var(--color-leche)]/80">{c.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <!-- Los cinco valores, en cinta continua (vuelve el carrusel, 17-10-2026). -->
  <section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-16 sm:py-24 lg:px-14">
    <p class="numeracion" style="color:var(--color-teja)">Cinco valores</p>
    <h2 class="text-4xl sm:text-5xl mt-3 max-w-2xl leading-[1.08]">Lo que no ha cambiado, y no va a cambiar</h2>
    <p class="mt-5 max-w-sm text-sm leading-relaxed text-[color:var(--color-ink-muted)]">{tradicion.valoresIntro}</p>
    <!-- Cinta continua: las cinco tarjetas dos veces, desplazándose sin
         parar; al llegar a la mitad vuelve a empezar sin que se note. La
         copia no la lee el lector de pantalla. Las flechas la adelantan o
         la atrasan una tarjeta y luego sigue sola. -->
    <div class="valores-marco mt-10" role="region" aria-label="Nuestros 5 valores" data-valores>
      <button type="button" class="valores-flecha valores-flecha--ant" data-valores-ant aria-label="Valor anterior" hidden>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
      </button>
      <button type="button" class="valores-flecha valores-flecha--sig" data-valores-sig aria-label="Valor siguiente" hidden>
        <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
      </button>
      <div class="valores-pista">
        {[0, 1].map((copia) => (
          <div class="valores-tanda" aria-hidden={copia === 1 ? "true" : undefined}>
            {tradicion.valores.map((v) => (
              <article class="valores-item">
                <img src={v.foto} alt="" loading="lazy" decoding="async" class="valores-foto" style={"encuadre" in v ? `object-position:${v.encuadre}` : undefined} />
                <div class="valores-texto p-6 sm:p-7">
                  <p class="font-[family-name:var(--font-display)] text-4xl">{v.number}</p>
                  <h3 class="font-[family-name:var(--font-display)] text-2xl mt-2">{v.title}</h3>
                  <p class="mt-2 text-sm leading-relaxed">{v.body}</p>
                </div>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="bg-[color:var(--color-moka)] text-[color:var(--color-leche)]">
    <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-14 sm:py-20 grid gap-10 md:grid-cols-[1.2fr_1fr] md:items-center">
      <div>
        <p class="numeracion" style="color:var(--color-avellana)">Lo que garantizamos</p>
        <p class="font-[family-name:var(--font-display)] italic text-3xl sm:text-4xl mt-3 leading-[1.15]">
          {tradicion.promesa}
        </p>
        <p class="mt-4 text-sm text-[color:var(--color-avellana)] max-w-lg">{tradicion.promesaBody}</p>
      </div>
      <ul>
        {tradicion.pruebas.map((prueba) => (
          <li class="border-t border-[color:var(--color-leche)]/15 py-4 text-sm text-[color:var(--color-avellana)]">
            {prueba}
          </li>
        ))}
      </ul>
    </div>
  </section>
</MarketingLayout>

<style>
  /* Antetítulo con una raya delante, como en el diseño. */
  .antetitulo {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .antetitulo::before {
    content: "";
    width: 2rem;
    height: 1px;
    background: currentColor;
  }
  .gracias-tarjeta {
    box-shadow: 0 18px 40px -18px rgb(50 40 32 / 0.28);
  }

  /* Cinta de los cinco valores: avanza siempre, a velocidad constante. */
  .valores-marco {
    position: relative;
    overflow: hidden;
  }
  /* Con JS la mueve el script (para poder usar las flechas). */
  .valores-marco.con-js .valores-pista {
    animation: none;
  }
  .valores-flecha {
    position: absolute;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    margin-top: -1.375rem;
    border-radius: 9999px;
    background: var(--color-latte);
    color: var(--color-moka);
    box-shadow: 0 2px 10px rgb(50 40 32 / 0.25);
    cursor: pointer;
    transition: transform 0.15s ease;
  }
  .valores-flecha[hidden] {
    display: none;
  }
  .valores-flecha:hover {
    transform: scale(1.06);
  }
  .valores-flecha:focus-visible {
    outline: 2px solid var(--color-teja);
    outline-offset: 2px;
  }
  .valores-flecha--ant {
    left: 0.75rem;
  }
  .valores-flecha--sig {
    right: 0.75rem;
  }
  .valores-pista {
    display: flex;
    width: max-content;
    animation: valores-cinta 46s linear infinite;
  }
  .valores-tanda {
    display: flex;
    gap: 1.25rem;
    padding-right: 1.25rem;
  }
  /* Foto a sangre y el texto encima, abajo, en latte; un degradado moka
     por debajo para que se lea sobre cualquier foto. */
  .valores-item {
    position: relative;
    flex: none;
    width: min(80vw, 22rem);
    aspect-ratio: 4 / 5;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    background: var(--color-moka);
  }
  .valores-foto {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .valores-texto {
    position: relative;
    color: var(--color-latte);
    background: linear-gradient(to top, rgb(50 40 32 / 0.92) 0%, rgb(50 40 32 / 0.75) 55%, rgb(50 40 32 / 0) 100%);
    padding-top: 5rem;
  }
  @keyframes valores-cinta {
    to {
      transform: translateX(-50%);
    }
  }
  /* Con «reducir movimiento», quieta y deslizable a mano, sin la copia. */
  @media (prefers-reduced-motion: reduce) {
    .valores-marco {
      overflow-x: auto;
    }
    .valores-pista {
      animation: none;
    }
    .valores-tanda[aria-hidden="true"] {
      display: none;
    }
    /* Con JS no avanza sola, pero las flechas la siguen moviendo. */
    .valores-marco.con-js {
      overflow-x: hidden;
    }
    .valores-marco.con-js .valores-tanda[aria-hidden="true"] {
      display: flex;
    }
  }

  /* Cifras: entran escalonadas y, después, de una en una y en bucle, cada
     cifra vuelve a contar desde cero y a dibujar su raya mientras las demás
     esperan algo apagadas. Sin JS o con «reducir movimiento», quietas. */
  .cifra-raya {
    display: block;
    width: 2.5rem;
    height: 2px;
    margin: 0.75rem auto 0;
    background: var(--color-latte);
    transform-origin: center;
  }
  .cifras.listo .cifra {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i) * 140ms);
  }
  /* Más movimiento (16-10-2026): la que se enciende crece y sube, las
     demás se apagan más, y el número da un pequeño salto al empezar. */
  .cifras.visto .cifra {
    opacity: 0.65;
    transform: none;
  }
  .cifras.visto .cifra.activa {
    opacity: 1;
    transform: translateY(-8px) scale(1.06);
    transition-delay: 0s;
  }
  .cifra-numero {
    display: inline-block;
  }
  .cifras.visto .cifra.activa .cifra-numero {
    animation: cifra-salto 0.6s cubic-bezier(0.3, 1.6, 0.5, 1);
  }
  @keyframes cifra-salto {
    0% {
      transform: scale(0.8);
    }
    100% {
      transform: scale(1);
    }
  }
  .cifras.listo .cifra-raya {
    transform: scaleX(0);
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .cifras.visto .cifra.activa .cifra-raya {
    transform: scaleX(1);
  }
</style>

<script>
  function animaCifras() {
    const dl = document.querySelector<HTMLElement>("[data-cifras]");
    if (!dl || dl.classList.contains("listo")) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const cifras = [...dl.querySelectorAll<HTMLElement>(".cifra")];
    dl.classList.add("listo");

    const cuenta = (n: HTMLElement) => {
      const fin = Number(n.dataset.cuenta);
      const DURACION = 1400;
      let inicio = 0;
      const paso = (t: number) => {
        if (!inicio) inicio = t;
        const p = Math.min((t - inicio) / DURACION, 1);
        // Frena al final: los últimos números se leen.
        const suave = 1 - Math.pow(1 - p, 3);
        n.textContent = String(Math.round(fin * suave));
        if (p < 1) requestAnimationFrame(paso);
      };
      requestAnimationFrame(paso);
    };

    /** Enciende la cifra `i`: cuenta desde cero y dibuja su raya. */
    let actual = -1;
    const enciende = (i: number) => {
      cifras.forEach((c) => c.classList.remove("activa"));
      const c = cifras[i];
      void c.offsetWidth;
      c.classList.add("activa");
      const n = c.querySelector<HTMLElement>("[data-cuenta]");
      if (n) {
        n.textContent = "0";
        cuenta(n);
      }
      actual = i;
    };

    // Una cada 2,5 s, en bucle, mientras se ven. Fuera de pantalla se para,
    // y al volver sigue por la siguiente.
    const CADA = 2500;
    let reloj: ReturnType<typeof setInterval> | undefined;
    const io = new IntersectionObserver(
      ([e]) => {
        clearInterval(reloj);
        if (!e.isIntersecting) return;
        if (!dl.isConnected) return io.disconnect();
        dl.classList.add("visto");
        enciende((actual + 1) % cifras.length);
        reloj = setInterval(() => {
          if (!dl.isConnected) {
            clearInterval(reloj);
            io.disconnect();
          } else if (!document.hidden) enciende((actual + 1) % cifras.length);
        }, CADA);
      },
      { threshold: 0.35 },
    );
    io.observe(dl);
  }

  /** Cinta de valores: avanza sola y las flechas la mueven una tarjeta. */
  function cintaValores() {
    const marco = document.querySelector<HTMLElement>("[data-valores]");
    if (!marco || marco.classList.contains("con-js")) return;
    const pista = marco.querySelector<HTMLElement>(".valores-pista")!;
    const tanda = marco.querySelector<HTMLElement>(".valores-tanda")!;
    const item = marco.querySelector<HTMLElement>(".valores-item")!;
    const quieta = matchMedia("(prefers-reduced-motion: reduce)").matches;
    marco.classList.add("con-js");

    const DURACION_VUELTA = 46; // s, como la animación sin JS
    const DURACION_SALTO = 450; // ms
    let pos = 0;
    let salto: { desde: number; hasta: number; inicio: number } | null = null;
    let antes = 0;

    // Una tarjeta = su ancho más el hueco entre tarjetas.
    const paso = () => item.offsetWidth + parseFloat(getComputedStyle(tanda).columnGap || "0");
    const vuelta = () => tanda.offsetWidth;
    const coloca = () => {
      const v = vuelta();
      pista.style.transform = `translateX(${-(((pos % v) + v) % v)}px)`;
    };

    const mueve = (signo: number) => {
      // Si ya iba saltando, cuenta desde donde iba a acabar.
      const base = salto ? salto.hasta : pos;
      salto = { desde: pos, hasta: base + signo * paso(), inicio: performance.now() };
    };
    marco.querySelector("[data-valores-ant]")!.addEventListener("click", () => mueve(-1));
    marco.querySelector("[data-valores-sig]")!.addEventListener("click", () => mueve(1));
    marco.querySelectorAll<HTMLElement>(".valores-flecha").forEach((b) => (b.hidden = false));

    const marca = (t: number) => {
      if (!marco.isConnected) return;
      const dt = antes ? Math.min(t - antes, 100) : 0;
      antes = t;
      if (salto) {
        const p = Math.min((t - salto.inicio) / DURACION_SALTO, 1);
        const suave = 1 - Math.pow(1 - p, 3);
        pos = salto.desde + (salto.hasta - salto.desde) * suave;
        if (p === 1) salto = null;
      } else if (!quieta) {
        pos += (vuelta() / DURACION_VUELTA) * (dt / 1000);
      }
      coloca();
      requestAnimationFrame(marca);
    };
    requestAnimationFrame(marca);
  }
  document.addEventListener("astro:page-load", cintaValores);
  document.addEventListener("astro:page-load", animaCifras);

</script>

