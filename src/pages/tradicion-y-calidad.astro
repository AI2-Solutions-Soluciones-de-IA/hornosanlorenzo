---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import SectionLabel from "~/components/SectionLabel.astro";
import { tradicion } from "~/data/tradicion";
import { site } from "~/data/site";
---
<MarketingLayout
  title="Tradición y Calidad"
  description="Obrador propio desde 1986: método tradicional, ingredientes de siempre y cinco valores que se cumplen en algo concreto."
>
  <!-- Manifiesto de la marca (Brand Guidelines Avellana, diapositiva 8). -->
  <section class="border-b border-[color:var(--color-avellana)]">
    <div class="mx-auto max-w-3xl px-4 sm:px-6 py-12 sm:py-20">
      <p class="numeracion">Manifiesto</p>
      <h1 class="text-4xl sm:text-5xl mt-3">{tradicion.manifiesto.titulo}</h1>
      <p class="text-xl text-[color:var(--color-ink-muted)] mt-6 leading-relaxed">{tradicion.manifiesto.entradilla}</p>
      <div class="mt-8 space-y-5 leading-relaxed text-[color:var(--color-ink)]">
        {tradicion.manifiesto.parrafos.map((p) => <p>{p}</p>)}
      </div>
      <p class="mt-10 border-l-2 border-[color:var(--color-teja)] pl-5 font-[family-name:var(--font-display)] italic text-2xl sm:text-3xl leading-snug">
        {tradicion.manifiesto.cierre}
      </p>
      <p class="numeracion mt-6">{tradicion.manifiesto.firma}</p>
    </div>
  </section>

  <section class="bg-[color:var(--color-leche)] border-b border-[color:var(--color-avellana)]">
    <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-12 sm:py-16">
      <dl class="cifras grid gap-px bg-[color:var(--color-avellana)] border border-[color:var(--color-avellana)] sm:grid-cols-2 lg:grid-cols-4" data-cifras>
        {tradicion.cifras.map((c, i) => (
          <div class="cifra bg-[color:var(--color-leche)] p-6" style={`--i:${i}`}>
            <dt class="font-[family-name:var(--font-display)] text-4xl">
              {/^\d+$/.test(c.figure) ? <span data-cuenta={c.figure}>{c.figure}</span> : c.figure}
            </dt>
            <span class="cifra-raya" aria-hidden="true"></span>
            <dd class="numeracion mt-2">{c.label}</dd>
            <dd class="mt-3 text-sm leading-relaxed text-[color:var(--color-ink-muted)]">{c.body}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-14 sm:py-20">
    <SectionLabel number="01" label="Cinco valores" />
    <h2 class="text-3xl sm:text-4xl mt-2">Ninguno decorativo.</h2>
    <p class="mt-3 max-w-2xl text-[color:var(--color-ink-muted)]">
      Cada valor se traduce en una decisión concreta del negocio. Si no se puede señalar
      dónde se cumple, no es un valor: es un adorno.
    </p>
    <div class="mt-10 grid gap-x-10 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {tradicion.valores.map((v) => (
        <article class="border-t border-[color:var(--color-avellana)] pt-5">
          <p class="numeracion">Nº {v.number} —</p>
          <h3 class="font-[family-name:var(--font-display)] text-2xl mt-2">{v.title}</h3>
          <p class="mt-2 leading-relaxed text-[color:var(--color-ink-muted)]">{v.body}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="bg-[color:var(--color-moka)] text-[color:var(--color-leche)]">
    <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-14 sm:py-20 grid gap-10 md:grid-cols-[1.2fr_1fr] md:items-end">
      <div>
        <p class="numeracion" style="color:var(--color-avellana)">Lo que garantizamos</p>
        <p class="font-[family-name:var(--font-display)] italic text-3xl sm:text-4xl mt-3 leading-[1.15]">
          {tradicion.promesa}
        </p>
        <p class="mt-4 text-[color:var(--color-avellana)] max-w-lg">{tradicion.promesaBody}</p>
      </div>
      <ul class="space-y-4">
        {tradicion.pruebas.map((prueba) => (
          <li class="border-t border-[color:var(--color-leche)]/25 pt-4 text-sm text-[color:var(--color-avellana)]">
            {prueba}
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-14 sm:py-20 grid gap-10 md:grid-cols-2">
    <div class="border border-[color:var(--color-avellana)] p-6 sm:p-8">
      <p class="numeracion">{tradicion.especialidad.title}</p>
      <p class="mt-3 font-[family-name:var(--font-display)] text-2xl leading-snug">
        {tradicion.especialidad.body}
      </p>
      <a href="/catalogo" class="btn btn-primario mt-6">Ver el catálogo</a>
    </div>
    <div class="bg-[color:var(--color-leche)] p-6 sm:p-8">
      <p class="numeracion">Cómo trabajamos</p>
      <ul class="mt-4 space-y-3 text-sm text-[color:var(--color-ink-muted)]">
        {tradicion.certifications.map((c) => (
          <li class="flex gap-3">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-[color:var(--color-avellana)]" aria-hidden="true"></span>
            <span>{c}</span>
          </li>
        ))}
      </ul>
      <p class="mt-6 text-sm italic text-[color:var(--color-ink-muted)]">«{site.usp}»</p>
    </div>
  </section>
</MarketingLayout>

<style>
  /* Cifras: entran escalonadas, cuentan desde cero y dibujan una raya teja
     al aparecer en pantalla. Sin JS o con «reducir movimiento», quietas. */
  .cifra-raya {
    display: block;
    width: 2.5rem;
    height: 2px;
    margin-top: 0.75rem;
    background: var(--color-teja);
    transform-origin: left;
  }
  .cifras.listo .cifra {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity 0.7s ease,
      transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i) * 140ms);
  }
  .cifras.listo .cifra-raya {
    transform: scaleX(0);
    transition: transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1);
    transition-delay: calc(var(--i) * 140ms + 0.5s);
  }
  .cifras.visto .cifra {
    opacity: 1;
    transform: none;
  }
  .cifras.visto .cifra-raya {
    transform: scaleX(1);
  }
</style>

<script>
  function animaCifras() {
    const dl = document.querySelector<HTMLElement>("[data-cifras]");
    if (!dl || dl.classList.contains("listo")) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    const numeros = [...dl.querySelectorAll<HTMLElement>("[data-cuenta]")];
    dl.classList.add("listo");
    numeros.forEach((n) => (n.textContent = "0"));

    const cuenta = (n: HTMLElement, retraso: number) => {
      const fin = Number(n.dataset.cuenta);
      const DURACION = 1400;
      let inicio = 0;
      const paso = (t: number) => {
        if (!inicio) inicio = t;
        const p = Math.min((t - inicio) / DURACION, 1);
        // Frena al final: los últimos números se leen.
        const suave = 1 - Math.pow(1 - p, 3);
        n.textContent = String(Math.round(fin * suave));
        if (p < 1) requestAnimationFrame(paso);
      };
      setTimeout(() => requestAnimationFrame(paso), retraso);
    };

    const io = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        io.disconnect();
        dl.classList.add("visto");
        numeros.forEach((n) => {
          const i = Number(n.closest<HTMLElement>(".cifra")?.style.getPropertyValue("--i") || 0);
          cuenta(n, i * 140);
        });
      },
      { threshold: 0.35 },
    );
    io.observe(dl);
  }
  document.addEventListener("astro:page-load", animaCifras);
</script>

