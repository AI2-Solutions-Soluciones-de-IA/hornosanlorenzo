---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import NewsCarousel from "~/components/NewsCarousel.astro";
import type { Noticia } from "~/lib/db/noticias";
import { noticiasPublicas, seccionesEsteMesPublicas, definicionesPublicas } from "~/lib/lectura-publica";
import ElementoCatalogo from "~/components/ElementoCatalogo.astro";
import SuscripcionOfertas from "~/islands/SuscripcionOfertas.tsx";
import { slugify } from "~/lib/slug";

// Lee de la base de datos: bajo demanda, con la caché ISR delante
// (`astro.config.mjs`) y el panel invalidándola al publicar.
export const prerender = false;

// Que la base de datos falle no puede tumbar una página pública: se enseña la
// sección vacía, que es feo pero navegable — y con `no-store`, para que ese
// «no hay nada publicado» no se quede cacheado (`~/lib/lectura-publica.ts`).
const [items, secciones, defsPacks] = await Promise.all([
  noticiasPublicas(Astro.response) as Promise<Noticia[]>,
  // Secciones que escribe el obrador en el panel («Productos nuevos sin
  // gluten»…), debajo de las ofertas.
  seccionesEsteMesPublicas(Astro.response),
  definicionesPublicas(Astro.response),
]);

// Selector para saltar a cada parte de la página (8-10-2026). El ancla sale
// del título; si dos se llaman igual, la segunda lleva su posición detrás.
const usadas = new Set<string>();
const anclas = secciones.map((s, i) => {
  const base = `s-${slugify(s.titulo) || i}`;
  const ancla = usadas.has(base) ? `${base}-${i}` : base;
  usadas.add(ancla);
  return { ancla, titulo: s.titulo };
});
---
<MarketingLayout
  title="Noticias y promociones"
  description="Roscón de Reyes, San Valentín, Día del Padre, fiestas patronales y más."
>
  <!-- Suscripción a las ofertas por correo (tabla `suscriptores`), lo primero
       de la página. Franja baja a propósito: el precio de la oferta tiene que
       verse sin hacer scroll (7-10-2026). -->
  <section class="bg-[color:var(--color-latte)] border-b border-[color:var(--color-avellana)]">
    <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-4 grid gap-3 md:gap-8 md:grid-cols-2 md:items-center">
      <div>
        <h2 class="text-2xl sm:text-3xl">Que no se te escape ninguna.</h2>
        <p class="mt-1 text-sm text-[color:var(--color-ink-muted)] max-w-md">
          Déjanos tu correo y te avisamos cuando salga la oferta del mes. Sin
          spam: solo las ofertas del obrador.
        </p>
      </div>
      <SuscripcionOfertas client:load />
    </div>
  </section>
  <section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 pt-6 pb-12">
    <!-- El selector va en la línea del título y no debajo: así no empuja el
         precio de la oferta fuera de la pantalla. -->
    <div class="flex flex-wrap items-center justify-between gap-x-6 gap-y-3">
      <h1 class="text-3xl sm:text-4xl">Oferta del mes.</h1>
      {anclas.length > 0 && (
        <nav aria-label="Secciones de Este mes" class="flex flex-wrap gap-2">
          {anclas.map((a) => (
            <a href={`#${a.ancla}`} class="px-3 py-1.5 text-sm border border-[color:var(--color-avellana)] hover:border-[color:var(--color-moka)] hover:bg-[color:var(--color-latte)] transition-colors">
              {a.titulo}
            </a>
          ))}
        </nav>
      )}
    </div>
    <div class="mt-5">
      {items.length > 0 ? (
        <NewsCarousel items={items} />
      ) : (
        <p class="text-[color:var(--color-ink-muted)]">
          Ahora mismo no hay nada publicado. Vuelve en unos días.
        </p>
      )}
    </div>
  </section>

  {secciones.map((s, i) => (
    <section id={anclas[i].ancla} class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-12 border-t border-[color:var(--color-avellana)] scroll-mt-36 md:scroll-mt-56">
      <h2 class="text-3xl sm:text-4xl">{s.titulo}</h2>
      {s.descripcion && <p class="mt-3 max-w-2xl text-[color:var(--color-ink-muted)]">{s.descripcion}</p>}
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4">
        {s.productos.map((producto) => (
          <ElementoCatalogo elemento={{ tipo: "producto", producto }} sinFiltro defsPacks={defsPacks} />
        ))}
      </div>
    </section>
  ))}

</MarketingLayout>
