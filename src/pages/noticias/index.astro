---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import NewsCarousel from "~/components/NewsCarousel.astro";
import type { Noticia } from "~/lib/db/noticias";
import { noticiasPublicas } from "~/lib/lectura-publica";

// Lee de la base de datos: bajo demanda, con la caché ISR delante
// (`astro.config.mjs`) y el panel invalidándola al publicar.
export const prerender = false;

// Que la base de datos falle no puede tumbar una página pública: se enseña la
// sección vacía, que es feo pero navegable — y con `no-store`, para que ese
// «no hay nada publicado» no se quede cacheado (`~/lib/lectura-publica.ts`).
const items: Noticia[] = await noticiasPublicas(Astro.response);
---
<MarketingLayout
  title="Noticias y promociones"
  description="Roscón de Reyes, San Valentín, Día del Padre, fiestas patronales y más."
>
  <section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-12">
    <p class="numeracion">Este mes</p>
    <h1 class="text-4xl sm:text-5xl mt-2">Lo que tenemos esta temporada.</h1>
    <div class="mt-10">
      {items.length > 0 ? (
        <NewsCarousel items={items} />
      ) : (
        <p class="text-[color:var(--color-ink-muted)]">
          Ahora mismo no hay nada publicado. Vuelve en unos días.
        </p>
      )}
    </div>
  </section>
</MarketingLayout>
