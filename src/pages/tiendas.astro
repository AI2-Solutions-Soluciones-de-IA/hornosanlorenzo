---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import StoreCard from "~/components/StoreCard.astro";
import { stores } from "~/data/stores";

const jsonLd = stores.map((s) => ({
  "@context": "https://schema.org",
  "@type": "Bakery",
  name: s.name,
  address: {
    "@type": "PostalAddress",
    streetAddress: s.address,
    addressLocality: s.city,
    postalCode: s.postal,
    addressCountry: "ES",
  },
  telephone: [s.phone, ...s.mobiles.map((m) => m.number)],
  email: s.email,
  geo: { "@type": "GeoCoordinates", latitude: s.coords.lat, longitude: s.coords.lng },
  openingHours: s.hoursText,
}));
---
<MarketingLayout
  title="Tiendas"
  description="Dos obradores con horno propio en Madrid: Alcobendas (sede) y Pozuelo de Alarcón. Reparto propio de lunes a sábado."
  jsonLd={jsonLd}
>
  <section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-12">
    <p class="numeracion">Nuestras tiendas</p>
    <h1 class="text-4xl sm:text-5xl mt-2">Dos obradores en Madrid.</h1>
    <p class="text-[color:var(--color-ink-muted)] mt-3 max-w-xl">Alcobendas es la sede desde 1986; Pozuelo de Alarcón, el segundo horno.</p>
    <div class="mt-10 grid gap-8">
      {stores.map((s) => <StoreCard store={s} />)}
    </div>
  </section>
</MarketingLayout>
