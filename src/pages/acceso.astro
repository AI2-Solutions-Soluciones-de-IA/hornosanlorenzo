---
export const prerender = false;

import MarketingLayout from "~/layouts/MarketingLayout.astro";
import Acceso from "~/islands/Acceso.tsx";

if (Astro.locals.usuario) return Astro.redirect("/cuenta");
---
<MarketingLayout
  title="Acceso clientes"
  description="Entra con tu cuenta o date de alta como particular o como empresa."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-12 sm:py-16">
    <Acceso client:load />
  </section>
</MarketingLayout>
