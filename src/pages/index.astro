---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import Hero from "~/components/Hero.astro";
import ElementoCatalogo from "~/components/ElementoCatalogo.astro";
import { agruparSabores } from "~/lib/sabores";
import SectionLabel from "~/components/SectionLabel.astro";
import { catalogoPublico, definicionesPublicas } from "~/lib/lectura-publica";
import { stores } from "~/data/stores";
import { site } from "~/data/site";

// Lee el catálogo de la base de datos: bajo demanda, con la caché ISR delante
// y el panel invalidándola al guardar.
export const prerender = false;

// Un fallo de Postgres deja la home sin destacados, no una página rota — y
// marca la respuesta como `no-store` para que esa home sin destacados no se
// quede cacheada (`~/lib/lectura-publica.ts`).
// Las definiciones de los packs van igual, en paralelo: un pack destacado
// sin definición no se pinta.
const [productsAll, defsPacks] = await Promise.all([
  catalogoPublico(Astro.response),
  definicionesPublicas(Astro.response),
]);
// `listarProductos` ya devuelve en el orden de la carta.
const featured = productsAll.filter((p) => p.destacado).slice(0, 6);

// Arquitectura de mensajes de la marca («Qué decimos, en qué orden»): de lo
// más breve y estable a lo más argumentativo. El orden importa.
const mensajesMarca = [
  {
    texto: "Más de 40 años haciéndolo bien.",
    sub: "El secreto de comer bien lleva más de 40 años en Horno San Lorenzo.",
  },
  {
    texto: "El futuro es volver a comer de verdad, con producto fresco recién salido del horno.",
    sub: "Del horno a tu mesa: no es producto congelado, sino horneado cada mañana.",
  },
  {
    texto: "Producto fresco y artesanal, recién salido del horno, para hogares y empresas.",
  },
  {
    texto: "La confianza de siempre: producto artesanal fresco que sale del horno cada día, con una calidad precio difícil de igualar.",
  },
  {
    texto: "Convertir 40 años de reputación en la marca de referencia de comida casera fresca, accesible y generosa.",
  },
];

const lemas = [
  "Desde 1986",
  "Obrador propio",
  "Hecho cada mañana",
  "Método tradicional",
  "Ingredientes de siempre",
  "Alcobendas · Pozuelo",
];

const localBizJsonLd = stores.map((s) => ({
  "@context": "https://schema.org",
  "@type": "Bakery",
  name: s.name,
  address: {
    "@type": "PostalAddress",
    streetAddress: s.address,
    addressLocality: s.city,
    postalCode: s.postal,
    addressCountry: "ES",
  },
  telephone: s.phone,
  geo: { "@type": "GeoCoordinates", latitude: s.coords.lat, longitude: s.coords.lng },
  openingHours: s.hoursText,
}));
---
<MarketingLayout
  title={site.name}
  description="Obrador artesano en Alcobendas y Pozuelo desde 1986. Comida casera para hogares y empresas: tartas y empanadas hechas cada mañana en horno propio."
  jsonLd={localBizJsonLd}
>
  <Hero
    eyebrow="Desde 1986 · Obrador artesano · Madrid"
    title="Más de 40 años"
    italicTail="haciéndolo bien."
    mensajes={mensajesMarca}
    video={{ src: "/videos/portada.mp4", poster: "/videos/portada-poster.jpg" }}
    imageAlt="En el obrador: rellenando tartaletas a mano, hasta el sello de Horno San Lorenzo"
    primaryCta={{ href: "/catalogo", label: "Ver el catálogo" }}
    secondaryCta={{ href: "/a-quien-servimos", label: "A quién servimos" }}
  />

  <section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-16 sm:py-24">
    <div class="flex items-end justify-between gap-4 mb-8">
      <div>
        <SectionLabel number="01" label="Lo que se comparte" />
        <h2 class="text-3xl sm:text-4xl mt-2">Lo que se pone en el centro de la mesa.</h2>
      </div>
      <a href="/catalogo" class="text-sm font-semibold underline whitespace-nowrap">Ver todo el catálogo →</a>
    </div>
    <!-- Carrusel con scroll nativo: se arrastra en el móvil y con trackpad sin
         JS; las flechas pasan de una en una. -->
    <div class="carrusel-marco" data-carrusel data-carrusel-auto="30">
    <button type="button" class="carrusel-flecha carrusel-flecha--prev" data-carrusel-prev aria-controls="carrusel-destacados" aria-label="Producto anterior">‹</button>
    <button type="button" class="carrusel-flecha carrusel-flecha--next" data-carrusel-next aria-controls="carrusel-destacados" aria-label="Producto siguiente">›</button>
    <div
      id="carrusel-destacados"
      class="carrusel flex gap-5 overflow-x-auto snap-x snap-mandatory"
      data-carrusel-pista
      role="region"
      aria-roledescription="carrusel"
      aria-label="Productos destacados"
      tabindex="0"
    >
      {agruparSabores(featured).map((e) => (
        <div class="carrusel-item snap-start shrink-0">
          <ElementoCatalogo elemento={e} sinFiltro defsPacks={defsPacks} />
        </div>
      ))}
    </div>
    </div>
    <div class="mt-10 text-center">
      <a href="/catalogo" class="btn btn-primario">Haz tu pedido</a>
    </div>
  </section>

  <!-- Claim de campaña: cierra la home, justo antes del pie (`-mb-24`
       anula el `mt-24` del Footer solo aquí, para que vayan pegados). Entra palabra a palabra al
       aparecer en pantalla (ver el script del final). -->
  <section class="claim relative overflow-hidden -mb-24 bg-[color:var(--color-moka)] text-[color:var(--color-leche)]" data-claim>
    <div class="claim-brillo" aria-hidden="true"></div>
    <div class="claim-brillo claim-brillo--2" aria-hidden="true"></div>
    <div class="relative mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-14 sm:py-20 grid gap-8 md:grid-cols-[1.2fr_1fr] md:items-end">
      <p class="font-[family-name:var(--font-display)] italic text-3xl sm:text-4xl lg:text-5xl leading-[1.1]">
        <span class="sr-only">{`«${site.claim}»`}</span>
        {`«${site.claim}»`.split(" ").map((palabra, i) => (
          <><span class="claim-palabra" style={`--i:${i}`} aria-hidden="true">{palabra}</span>{" "}</>
        ))}
      </p>
      <div class="claim-lado">
        <span class="claim-raya" aria-hidden="true"></span>
        <p class="text-[color:var(--color-avellana)]">
          Métodos tradicionales. Ingredientes de siempre. Comida casera hecha para la vida de hoy.
        </p>
        <a href="/tradicion-y-calidad" class="btn btn-claro mt-6">Cómo lo hacemos</a>
      </div>
    </div>
    <!-- Cinta que corre sin parar por el borde de abajo: decorativa, el
         lector de pantalla no la lee. Va duplicada para que el bucle no salte. -->
    <div class="claim-cinta" aria-hidden="true">
      <div class="claim-cinta-pista">
        {[0, 1].map(() => (
          <span>
            {[...lemas, ...lemas].map((l) => (<>{l}<i>✦</i></>))}
          </span>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  /* Claim: las palabras suben y aparecen en cadena; la raya se dibuja y un
     brillo cálido cruza el fondo despacio. Sin JS (o con «reducir
     movimiento») se ve todo quieto desde el principio. */
  .claim-palabra {
    display: inline-block;
  }
  .claim.listo .claim-palabra {
    opacity: 0;
    transform: translateY(0.6em);
    filter: blur(4px);
    transition:
      opacity 0.9s ease,
      transform 0.9s cubic-bezier(0.2, 0.7, 0.2, 1),
      filter 0.9s ease;
    transition-delay: calc(var(--i) * 90ms);
  }
  .claim.listo .claim-lado {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.9s ease 0.7s, transform 0.9s ease 0.7s;
  }
  .claim-raya {
    display: block;
    height: 1px;
    width: 4rem;
    margin-bottom: 1.25rem;
    background: var(--color-avellana);
    transform-origin: left;
  }
  .claim.listo .claim-raya {
    transform: scaleX(0);
    transition: transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1) 0.9s;
  }
  .claim.visto .claim-palabra,
  .claim.visto .claim-lado {
    opacity: 1;
    transform: none;
    filter: none;
  }
  .claim.visto .claim-raya {
    transform: scaleX(1);
  }
  .claim-brillo {
    position: absolute;
    inset: -60% auto -60% -30%;
    width: 45%;
    background: radial-gradient(closest-side, rgb(199 150 100 / 0.32), transparent);
    animation: claim-brillo 11s ease-in-out infinite alternate;
    pointer-events: none;
  }
  .claim-brillo--2 {
    left: auto;
    right: -30%;
    background: radial-gradient(closest-side, rgb(142 36 29 / 0.35), transparent);
    animation-duration: 15s;
    animation-direction: alternate-reverse;
  }
  @keyframes claim-brillo {
    from {
      transform: translateX(0) scale(1);
    }
    to {
      transform: translateX(200%) scale(1.25);
    }
  }
  .claim-cinta {
    position: relative;
    overflow: hidden;
    border-top: 1px solid rgb(216 194 166 / 0.2);
    padding: 0.9rem 0;
    font-size: 0.6875rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--color-avellana);
  }
  .claim-cinta-pista {
    display: flex;
    width: max-content;
    animation: claim-cinta 45s linear infinite;
  }
  .claim-cinta-pista > span {
    display: flex;
    flex-shrink: 0;
    white-space: nowrap;
  }
  .claim-cinta i {
    font-style: normal;
    margin: 0 2.25rem;
    color: var(--color-caramelo);
  }
  .claim:hover .claim-cinta-pista {
    animation-play-state: paused;
  }
  @keyframes claim-cinta {
    to {
      transform: translateX(-50%);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .claim-brillo,
    .claim-cinta-pista {
      animation: none;
    }
  }

  .carrusel {
    scroll-behavior: smooth;
    scrollbar-width: none;
    padding: 0 1px 2px 0;
  }
  .carrusel::-webkit-scrollbar {
    display: none;
  }
  .carrusel:focus-visible {
    outline: 2px solid var(--color-caramelo);
    outline-offset: 4px;
  }
  /* Móvil: una tarjeta y un asomo de la siguiente, para que se vea que hay más. */
  .carrusel-item {
    flex-basis: 82%;
  }
  @media (min-width: 640px) {
    .carrusel-item {
      flex-basis: calc((100% - 1.25rem) / 2);
    }
  }
  @media (min-width: 1024px) {
    .carrusel-item {
      flex-basis: calc((100% - 2.5rem) / 3);
    }
  }
  /* Las flechas van sobre la foto, a media altura de ella. La foto es 4:3,
     así que su centro queda a 3/8 del ancho de la tarjeta; con `cqw` ese
     ancho se calcula igual que el `flex-basis` de cada tramo. */
  .carrusel-marco {
    position: relative;
    container-type: inline-size;
    --tarjeta: 82cqw;
  }
  @media (min-width: 640px) {
    .carrusel-marco {
      --tarjeta: calc((100cqw - 1.25rem) / 2);
    }
  }
  @media (min-width: 1024px) {
    .carrusel-marco {
      --tarjeta: calc((100cqw - 2.5rem) / 3);
    }
  }
  .carrusel-flecha {
    position: absolute;
    z-index: 2;
    top: calc(var(--tarjeta) * 0.375);
    transform: translateY(-50%);
    width: 44px;
    height: 44px;
    border: 1px solid var(--color-avellana);
    background: var(--color-leche);
    color: var(--color-moka);
    font-size: 24px;
    line-height: 1;
    cursor: pointer;
  }
  .carrusel-flecha--prev {
    left: 8px;
  }
  .carrusel-flecha--next {
    right: 8px;
  }
  .carrusel-flecha:hover {
    background: var(--color-latte);
  }
  .carrusel-flecha:disabled {
    opacity: 0;
    pointer-events: none;
  }
  .carrusel-marco:global(.carrusel--auto) .carrusel {
    scroll-snap-type: none;
    scroll-behavior: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    .carrusel {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  import "~/scripts/carrusel";

  function animaClaim() {
    const claim = document.querySelector<HTMLElement>("[data-claim]");
    if (!claim || claim.classList.contains("listo")) return;
    if (matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    claim.classList.add("listo");
    // Se repite cada vez que vuelve a entrar en pantalla.
    const io = new IntersectionObserver(
      ([e]) => {
        if (e.intersectionRatio >= 0.35) claim.classList.add("visto");
        else if (!e.isIntersecting) claim.classList.remove("visto");
      },
      { threshold: [0, 0.35] },
    );
    io.observe(claim);
  }
  document.addEventListener("astro:page-load", animaClaim);
</script>
