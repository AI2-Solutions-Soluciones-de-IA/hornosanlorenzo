---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import SuscripcionBanda from "~/components/SuscripcionBanda.astro";
import { stores } from "~/data/stores";

/**
 * Calco del artifact «HSL · A quién servimos» del cliente (21-10-2026),
 * versiones desktop y móvil: portada moka con la foto del obrador, tres
 * tarjetas blancas montadas sobre su borde y un cierre con los teléfonos.
 * Las anclas `#particulares`, `#hosteleria` y `#empresas` son las del submenú.
 */
const [alcobendas, pozuelo] = stores;

// El melocotón de los círculos y antetítulos del diseño; no hay token propio.
const melocoton = "#f3d9c4";

const tarjetas = [
  {
    id: "particulares",
    etiqueta: "Particulares",
    // El subtítulo solo sale en el diseño móvil.
    subtitulo: "Para tu mesa de cada día",
    icono: ["M3 10l9-6 9 6v10H3z", "M9 20v-6h6v6"],
    entrada: "La compra del día en cualquiera de nuestras dos tiendas y el encargo de la semana desde la tienda online.",
    puntos: [
      "Catálogo completo: dulce, salado, packs y temporada.",
      // Los minis son cosa de particulares, no de hostelería (14-10-2026).
      "Mini croissants dulces y salados en bandejas de 6, 12 y 24.",
      "Encargo online con recogida en Alcobendas o Pozuelo.",
      "Reparto propio de lunes a sábado en Madrid capital, Alcobendas, San Sebastián de los Reyes, Tres Cantos y Pozuelo.",
      "Tartas y encargos especiales, avisando con antelación.",
    ],
    ctas: [
      { href: "/catalogo", label: "Haz tu pedido" },
      { href: "/acceso?modo=registro&perfil=particular", label: "Registrarme" },
    ],
  },
  {
    id: "hosteleria",
    etiqueta: "Hostelería, catering y eventos",
    subtitulo: "Para tu carta y tus celebraciones",
    icono: ["M4 15a8 8 0 0 1 16 0", "M2 18h20", "M12 7V5", "M10 5h4"],
    entrada: "Trabajamos con restaurantes, bares, cafeterías, pastelerías, salones de bodas y banquetes, eventos y catering.",
    puntos: [
      "Atención comercial personalizada para cada cliente.",
      "Amplia variedad de dulce y salado para menú, carta, raciones, celebraciones, desayunos y tapas.",
      "Entrega diaria de lunes a sábado en formato mayorista.",
    ],
    ctas: [
      { href: "/contacto", label: "Pedir condiciones" },
      { href: "/acceso?modo=registro&perfil=empresa", label: "Registrarme" },
    ],
  },
  {
    id: "empresas",
    etiqueta: "Empresas",
    subtitulo: "Para tu equipo y tus clientes",
    icono: ["M3 7h18v13H3z", "M8 7V4h8v3", "M3 12h18"],
    entrada: "Cada empresa es distinta, y por eso te atendemos de forma personalizada: desayunos, reuniones y celebraciones.",
    puntos: [
      "Elige uno de nuestros packs o cuéntanos qué necesitas y preparamos tu catering a medida.",
      "Sin pedido mínimo en Alcobendas y alrededores (consúltanos). En el resto de zonas, el mismo que a domicilio.",
      "¿Dudas? Llámanos y cerramos la entrega contigo.",
    ],
    ctas: [
      { href: "/contacto", label: "Pedir condiciones" },
      { href: "/acceso?modo=registro&perfil=empresa", label: "Registrarme" },
    ],
  },
];
---
<MarketingLayout
  title="A quién servimos"
  description="Particulares, hostelería y empresas. El mismo obrador para la mesa de casa, la barra del bar y el desayuno de oficina."
>
  <!-- Arriba del todo, la misma suscripción que en Promociones del mes. -->
  <SuscripcionBanda />

  <!-- Portada: en móvil la foto va arriba; en escritorio, a sangre a la derecha. -->
  <section class="flex flex-col lg:grid lg:grid-cols-2 lg:min-h-[640px] bg-[color:var(--color-moka)] text-[color:var(--color-leche)]">
    <div class="relative order-first lg:order-last h-[260px] lg:h-auto">
      <img
        src="/images/obrador-tartas.jpg"
        alt="Obrador de Horno San Lorenzo en Alcobendas: tartas recién terminadas"
        width="1087"
        height="1447"
        decoding="async"
        class="absolute inset-0 h-full w-full object-cover object-[center_35%]"
      />
    </div>
    <div class="flex flex-col justify-center gap-[18px] lg:gap-7 px-6 pt-9 pb-24 lg:pt-24 lg:pr-14 lg:pb-[152px] lg:pl-10 lg:max-w-[680px] lg:ml-auto">
      <p class="flex items-center gap-3 lg:gap-3.5 text-[11px] lg:text-xs font-medium uppercase tracking-[0.22em]" style={`color:${melocoton}`}>
        <span class="block w-8 lg:w-10 h-0.5" style={`background:${melocoton}`} aria-hidden="true"></span>
        A quién servimos<span class="hidden lg:inline">&nbsp;· desde 1986</span>
      </p>
      <h1 class="text-4xl lg:text-6xl font-bold leading-[1.1] lg:leading-[1.05]">
        Un obrador.<br />Tres formas de servirte.
      </h1>
      <p class="lg:hidden text-base leading-relaxed text-[#f3e6db]">
        Horneamos para la mesa de casa, para la carta de tu negocio y para el desayuno de tu equipo.
      </p>
      <div class="hidden lg:block max-w-[540px] text-lg leading-[1.65] text-[#f3e6db] space-y-4">
        <p>Horneamos para tu mesa, para la carta de tu negocio, para tu evento o catering y para los desayunos de tu equipo.</p>
        <p>Desde nuestro obrador, horneamos cada día, con la calidad y el sabor de siempre y una relación calidad-precio difícil de igualar.</p>
        <p class="font-semibold">Te esperamos en nuestras tiendas, abiertas de lunes a domingo, o te lo llevamos directamente con nuestro reparto propio de lunes a sábado.</p>
      </div>
      <p class="hidden lg:flex items-center gap-4 pt-1">
        <span class="text-sm" style={`color:${melocoton}`}>¿No sabes cuál eres? Llámanos:</span>
        <a href={`tel:${alcobendas.phone}`} class="font-[family-name:var(--font-display)] text-[22px] text-[color:var(--color-leche)] no-underline border-b border-[color:var(--color-leche)]/40 hover:border-[color:var(--color-leche)]">
          {alcobendas.phoneDisplay}
        </a>
      </p>
    </div>
  </section>

  <!-- Las tres tarjetas, montadas sobre el borde inferior de la portada. -->
  <div class="relative z-10 mx-auto max-w-[1200px] px-4 lg:px-10 -mt-16 lg:-mt-20 grid gap-5 lg:grid-cols-3 lg:gap-8">
    {tarjetas.map((t) => (
      <article id={t.id} class="tarjeta-servimos scroll-mt-40 flex flex-col gap-4 lg:gap-5 bg-white px-6 pt-8 pb-7 lg:px-10 lg:pt-11 lg:pb-10">
        <span class="flex items-center justify-center w-14 h-14 lg:w-16 lg:h-16 rounded-full" style={`background:${melocoton}`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" class="w-[26px] h-[26px] lg:w-[30px] lg:h-[30px] text-[color:var(--color-teja)]" aria-hidden="true">
            {t.icono.map((d) => <path d={d} />)}
          </svg>
        </span>
        <h2 class="font-[family-name:var(--font-body)] text-[11px] lg:text-[26px] font-medium uppercase tracking-[0.2em] lg:tracking-[0.22em] leading-snug text-[color:var(--color-teja)]">
          {t.etiqueta}
        </h2>
        <p class="lg:hidden font-[family-name:var(--font-display)] text-[26px] font-bold leading-[1.15]">{t.subtitulo}</p>
        <p class="text-[15px] lg:text-base leading-[1.65] lg:leading-[1.7] text-[color:var(--color-ink-muted)]">{t.entrada}</p>
        <ul class="flex flex-col gap-2.5 lg:gap-3 pt-3.5 lg:pt-[18px] border-t border-[#e6dccf] text-sm lg:text-[15px] leading-[1.55]">
          {t.puntos.map((p) => (
            <li class="flex gap-2.5 lg:gap-3">
              <span class="mt-2 lg:mt-[9px] h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--color-teja)]" aria-hidden="true"></span>
              <span>{p}</span>
            </li>
          ))}
        </ul>
        <!-- Los botones, siempre abajo: las tres tarjetas igualan alto. -->
        <div class="flex flex-col gap-3 mt-1 lg:mt-auto lg:pt-3">
          {t.ctas.map((c, i) => (
            <a href={c.href} class:list={["btn tarjeta-servimos-btn", i === 0 ? "btn-primario" : "tarjeta-servimos-contorno"]}>{c.label}</a>
          ))}
        </div>
      </article>
    ))}
  </div>

  <!-- Cierre: la llamada y los teléfonos (en escritorio, solo Alcobendas). -->
  <section class="mx-auto max-w-[1200px] px-4 lg:px-10 pt-12 pb-16 lg:pt-24 lg:pb-28">
    <div class="flex flex-col lg:flex-row lg:flex-wrap lg:justify-between lg:items-center gap-3.5 lg:gap-8 px-6 py-8 lg:px-14 lg:py-12 rounded-md bg-[color:var(--color-moka)] text-[color:var(--color-leche)]">
      <div class="flex flex-col gap-3 lg:max-w-[560px]">
        <p class="text-[11px] font-medium uppercase tracking-[0.2em] lg:tracking-[0.22em]" style={`color:${melocoton}`}>
          <span class="lg:hidden">¿No sabes cuál eres?</span><span class="hidden lg:inline">¿Tienes alguna consulta?</span>
        </p>
        <p class="font-[family-name:var(--font-display)] text-[22px] lg:text-[28px] leading-[1.3]">Llámanos y te lo decimos en un minuto.</p>
        <p class="hidden lg:block font-[family-name:var(--font-display)] italic text-[17px] leading-normal text-[#e8d9cc]">
          El secreto de comer bien lleva más de 40 años en nuestra casa.
        </p>
      </div>
      <div class="hidden lg:flex flex-col gap-1.5">
        <span class="text-[11px] font-medium uppercase tracking-[0.18em]" style={`color:${melocoton}`}>{alcobendas.shortName}</span>
        <a href={`tel:${alcobendas.phone}`} class="font-[family-name:var(--font-display)] text-2xl text-[color:var(--color-leche)] no-underline hover:underline">{alcobendas.phoneDisplay}</a>
      </div>
      <div class="lg:hidden flex flex-col">
        {[alcobendas, pozuelo].map((s) => (
          <a href={`tel:${s.phone}`} class="flex justify-between items-center min-h-12 border-t border-[color:var(--color-leche)]/20 text-[15px] text-[color:var(--color-leche)] no-underline">
            <span class="text-[11px] uppercase tracking-[0.16em]" style={`color:${melocoton}`}>{s.shortName}</span>
            {s.phoneDisplay}
          </a>
        ))}
      </div>
    </div>
  </section>
</MarketingLayout>

<style>
  .tarjeta-servimos {
    border: 1px solid #e6dccf;
    border-radius: 6px;
    box-shadow: 0 24px 48px -24px rgb(50 40 32 / 0.35);
  }
  .tarjeta-servimos-btn {
    min-height: 50px;
    font-weight: 500;
    letter-spacing: 0.04em;
    border-radius: 2px;
  }
  .tarjeta-servimos-contorno {
    color: var(--color-teja);
    border-color: var(--color-teja);
  }
  .tarjeta-servimos-contorno:hover {
    background: var(--color-teja);
    color: var(--color-leche);
  }
</style>
