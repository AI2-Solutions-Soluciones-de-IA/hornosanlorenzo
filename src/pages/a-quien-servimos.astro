---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import SuscripcionBanda from "~/components/SuscripcionBanda.astro";

/**
 * Los tres públicos de la casa, en el mismo orden que el submenú de
 * «A quién servimos». Cada uno es una sección con ancla propia.
 */
const publicos = [
  {
    id: "particulares",
    tag: "Mostrador y tienda online",
    title: "Particulares",
    lead: "La compra del día en cualquiera de las dos tiendas y el encargo de la semana desde la tienda online.",
    points: [
      "El catálogo completo: dulce, salado, packs y temporada.",
      // Los minis son cosa de particulares, no de hostelería (14-10-2026).
      "Mini croissants dulces y salados, en bandejas de 6, 12 y 24 unidades.",
      "Encargo online con recogida en Alcobendas o Pozuelo de Alarcón.",
      "Reparto propio de lunes a sábado a Madrid capital, Alcobendas, San Sebastián de los Reyes, Tres Cantos y Pozuelo de Alarcón.",
      "Tartas y encargos especiales avisando con antelación.",
    ],
    // Llamadas a la acción (15-10-2026): registro en particulares; en
    // hostelería y empresas, pedir condiciones y registrarse (alta de empresa,
    // con razón social y CIF).
    ctas: [{ href: "/acceso?modo=registro&perfil=particular", label: "Registrarme", style: "btn-primario" }],
    foot: "Recogida en tienda · reparto propio",
  },
  {
    id: "hosteleria",
    tag: "Base B2B consolidada",
    title: "Hostelería y eventos",
    // Texto del cliente (14-10-2026), repartido entre la entrada y la lista.
    lead: "Trabajamos con restaurantes, bares, cafeterías, pastelerías, salones de bodas y banquetes, eventos y catering.",
    points: [
      "Cada cliente cuenta con una atención comercial personalizada.",
      "Una amplia variedad de dulce y salado para menú, carta, raciones, celebraciones, desayunos y tapas para tu negocio.",
    ],
    ctas: [
      { href: "/contacto", label: "Pedir condiciones", style: "btn-secundario" },
      { href: "/acceso?modo=registro&perfil=empresa", label: "Registrarme", style: "btn-primario" },
    ],
    foot: "Entrega diaria L–S · formato mayorista",
  },
  {
    id: "empresas",
    tag: "Canal prioritario",
    title: "Empresas",
    // Texto del cliente (14-10-2026), repartido entre la entrada y la lista.
    lead: "Cada empresa es distinta, y por eso te atendemos de forma personalizada.",
    points: [
      "Elige uno de nuestros packs en la web o cuéntanos qué necesitas y preparamos tu catering a medida.",
      "Sin pedido mínimo en Alcobendas y alrededores (consúltanos). En el resto de zonas, el mismo pedido mínimo que en el servicio a domicilio.",
      "¿Tienes dudas? Llámanos y cerramos la entrega contigo.",
    ],
    ctas: [
      { href: "/contacto", label: "Pedir condiciones", style: "btn-secundario" },
      { href: "/acceso?modo=registro&perfil=empresa", label: "Registrarme", style: "btn-primario" },
    ],
    foot: "Propuesta B2B · reparto propio",
  },
];
---
<MarketingLayout
  title="A quién servimos"
  description="Particulares, hostelería y empresas. El mismo obrador para la mesa de casa, la barra del bar y el desayuno de oficina."
>
  <!-- Arriba del todo, la misma suscripción que en Este mes. -->
  <SuscripcionBanda />

  <!-- Las tres cajas de los canales que había aquí se quitaron (15-10-2026):
       el submenú ya lleva a cada sección. El h1 queda para el lector. -->
  <h1 class="sr-only">A quién servimos</h1>

  {publicos.map((p) => (
    <section
      id={p.id}
      class="scroll-mt-40 border-b border-[color:var(--color-avellana)]"
    >
      <div class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-14 sm:py-20 grid gap-10 md:grid-cols-[1fr_1fr] items-start">
        <div>
          <h2 class="text-4xl sm:text-5xl">{p.title}</h2>
          <p class="mt-2 text-2xl sm:text-3xl font-[family-name:var(--font-display)] italic text-[color:var(--color-ink-muted)]">{p.tag}</p>
          <div class="mt-7 flex flex-wrap gap-3">
            {p.ctas.map((c) => <a href={c.href} class:list={["btn", c.style]}>{c.label}</a>)}
          </div>
        </div>
        <!-- Sin marco: fondo moka y letra clara. A la izquierda el título, el
             subtítulo y los botones; la entrada y la lista, aquí (15-10-2026). -->
        <div class="p-6 sm:p-8 bg-[color:var(--color-moka)] text-[color:var(--color-leche)]">
          <p class="text-lg leading-relaxed">{p.lead}</p>
          <ul class="mt-5 space-y-3 text-sm">
            {p.points.map((item) => (
              <li class="flex gap-3">
                <span class="mt-2 h-1.5 w-1.5 shrink-0 bg-[color:var(--color-latte)]" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
          <p class="numeracion mt-6 pt-5 border-t border-white/20" style="color:var(--color-latte)">{p.foot}</p>
        </div>
      </div>
    </section>
  ))}


</MarketingLayout>
