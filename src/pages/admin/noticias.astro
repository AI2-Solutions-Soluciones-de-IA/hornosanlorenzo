---
// src/pages/admin/noticias.astro
import AdminLayout from "~/layouts/AdminLayout.astro";
import AdminNoticias, { type ProductoOpcion } from "~/islands/AdminNoticias.tsx";
import { listarNoticias, type Noticia } from "~/lib/db/noticias";
import { listarProductos } from "~/lib/db/productos";
import { nombreCompleto } from "~/lib/sabores";
import { secciones as seccionesCarta, isSeccionId, seccionById } from "~/data/secciones";
import AdminSeccionesEsteMes, { type Seccion } from "~/islands/AdminSeccionesEsteMes.tsx";
import { listarSecciones } from "~/lib/db/seccionesEsteMes";

export const prerender = false;

let noticiasIniciales: Noticia[] = [];
// Para el desplegable «Producto de la carta» y la oferta: id, nombre y
// precios, solo de las fichas activas. El resto de la ficha no tiene por
// qué viajar al navegador.
let productos: ProductoOpcion[] = [];
let secciones: Seccion[] = [];
try {
  noticiasIniciales = await listarNoticias({ soloPublicadas: false });
  secciones = await listarSecciones();
  // Sin ofertas aplicadas (`conOfertas` por defecto es false): la casilla
  // de la oferta enseña al lado el precio DE SIEMPRE, no el rebajado.
  // En el orden de la carta, sección por sección: «San Marcos Trufa» hay
  // plancha y brazo, y en el desplegable tiene que verse cuál es (5-11-2026).
  const posicion = (s: string | null) => {
    const i = seccionesCarta.findIndex((x) => x.id === s);
    return i === -1 ? seccionesCarta.length : i;
  };
  const productosCarta = (await listarProductos({ soloActivos: true })).sort(
    (a, b) => posicion(a.seccion) - posicion(b.seccion),
  );
  productos = productosCarta.map((p) => ({
    id: p.id,
    // «Empanada · De Carne» y no «De Carne» a secas (7-10-2026), y con la
    // sección: «San Marcos Trufa (Brazos y Mini Brazos)».
    name: `${nombreCompleto(p)}${isSeccionId(p.seccion) ? ` (${seccionById(p.seccion).label})` : ""}`,
    grupo: isSeccionId(p.seccion) ? seccionById(p.seccion).label : "Otros",
    priceCents: p.priceCents,
    consultar: p.consultar,
    variantes: p.variantes.map((v) => ({ variantId: v.variantId, label: v.label, priceCents: v.priceCents })),
    // Para «Usar la foto del producto» en la noticia.
    foto:
      p.imageUrl && p.imageWidth && p.imageHeight
        ? { url: p.imageUrl, ancho: p.imageWidth, alto: p.imageHeight, alt: p.imageAlt ?? p.name }
        : null,
  }));
} catch (error) {
  // La isla sabe recargar la lista por su cuenta: mejor entrar con la lista
  // vacía y poder reintentar que ver un 500 al abrir el panel.
  console.error(
    "No se pudieron cargar las noticias del panel:",
    error instanceof Error ? error.message : error,
  );
}
---
<AdminLayout titulo="Este mes">
  <AdminNoticias client:load noticiasIniciales={noticiasIniciales} productos={productos} />
  <AdminSeccionesEsteMes client:load seccionesIniciales={secciones} productos={productos} />
</AdminLayout>
