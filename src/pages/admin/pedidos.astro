---
// src/pages/admin/pedidos.astro
import AdminLayout from "~/layouts/AdminLayout.astro";
import PedidoEstado from "~/islands/PedidoEstado.tsx";
import PedidosNuevos from "~/islands/PedidosNuevos.tsx";
import Paginacion from "~/islands/Paginacion.tsx";
import { paginar, resumenPagina } from "~/lib/paginacion";
import { listarPedidos, contarPedidos, type PedidoConLineas } from "~/lib/db/pedidos";
import { leerFiltrosPedidos, queryFiltros } from "~/lib/filtros-pedidos";
import { formatPriceCents, formatDateISO } from "~/lib/format";
import { MODE_COPY, ENTREGA_DOMICILIO_COPY } from "~/lib/entrega";
import { stores } from "~/data/stores";
import { etiquetaPieza } from "~/data/packs";

export const prerender = false;

// Filtros por URL (`?fecha=entrega|entrada&desde=&hasta=&q=&pagina=`, ver
// `leerFiltrosPedidos`). Esta página se sirve en servidor y fuera de la
// caché (está excluida del ISR en `astro.config.mjs`), así que aquí sí se
// pueden leer parámetros; en las páginas públicas no, que son estáticas.
const leidos = leerFiltrosPedidos(Astro.url.searchParams);
const { tipo, desde, hasta, texto: filtroTexto, hayFiltro } = leidos;

// De 20 en 20: con cada pedido desplegado con sus líneas, más que eso ya es
// un scroll que nadie recorre.
const POR_PAGINA = 20;

// Igual que en `cuenta.astro`: un fallo de Postgres no puede dejar el panel
// en un 500. Se enseña el aviso y el resto del panel sigue navegable.
let pedidos: PedidoConLineas[] = [];
let total = 0;
let pag = paginar(0, POR_PAGINA, 1);
let fallo = false;
/** Cuántos hay en total, sin filtros: el punto de partida del aviso de nuevos. */
let totalSinFiltros = 0;
try {
  // Primero la cuenta: una `?pagina=` más allá de la última se queda en la
  // última en vez de enseñar una página vacía.
  total = await contarPedidos(leidos.filtros);
  pag = paginar(total, POR_PAGINA, leidos.pagina);
  pedidos = await listarPedidos(POR_PAGINA, leidos.filtros, (pag.pagina - 1) * POR_PAGINA);
  totalSinFiltros = hayFiltro ? await contarPedidos() : total;
} catch (error) {
  fallo = true;
  console.error(
    "No se pudieron cargar los pedidos:",
    error instanceof Error ? error.message : error,
  );
}

const query = queryFiltros(leidos);
const enlacePagina = (n: number) => {
  const q = new URLSearchParams(query);
  if (n > 1) q.set("pagina", String(n));
  return `/admin/pedidos?${q}`;
};

const SLOT_LABEL = { morning: "mañana", afternoon: "tarde" } as const;

/**
 * `mode`, `fechaEntrega` y el destino pueden faltar en un pedido
 * reconstruido desde Stripe (migración 008). Cuando faltan hay que decirlo:
 * escribir un valor por defecto convertiría un «no lo sé» en un dato que
 * nadie va a comprobar, y el obrador prepararía el pedido equivocado.
 */
const SIN_DATOS = "sin datos — mira la sesión en Stripe";

function destino(p: PedidoConLineas): string {
  if (p.mode === null) return `Destino ${SIN_DATOS}`;
  if (p.mode === "domicilio") {
    const linea = [p.address, p.postalCode].filter(Boolean).join(" · ");
    return linea || `Dirección ${SIN_DATOS}`;
  }
  const tienda = stores.find((s) => s.id === p.storeId);
  return tienda ? `${tienda.shortName} — ${tienda.address}` : `Recogida (tienda ${SIN_DATOS})`;
}

/** La franja solo se enseña cuando se sabe la modalidad. */
function franja(p: PedidoConLineas): string {
  if (p.mode === "recogida") return p.slot ? ` (${SLOT_LABEL[p.slot]})` : "";
  if (p.mode === "domicilio") return ` (${ENTREGA_DOMICILIO_COPY})`;
  return "";
}
---
<AdminLayout titulo="Pedidos">
  {!fallo && <PedidosNuevos client:load inicial={totalSinFiltros} />}
  {fallo && (
    <p class="border-l-2 border-[color:var(--color-caramelo)] pl-3 py-2 text-sm">
      Ahora mismo no se pueden leer los pedidos. Vuelve a intentarlo en un
      momento; los cobros siguen estando en el panel de Stripe.
    </p>
  )}

  <form method="get" class="mb-6 flex flex-wrap items-end gap-4 border border-[color:var(--color-avellana)] bg-[color:var(--color-leche)] p-4">
    <div>
      <label for="f-fecha" class="numeracion block">Fecha de</label>
      <select id="f-fecha" name="fecha" class="mt-2 block border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm">
        <option value="entrega" selected={tipo === "entrega"}>Entrega</option>
        <option value="entrada" selected={tipo === "entrada"}>Entrada del pedido</option>
      </select>
    </div>
    <div>
      <label for="f-desde" class="numeracion block">Desde</label>
      <input id="f-desde" type="date" name="desde" value={desde ?? ""} class="mt-2 block border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm" />
    </div>
    <div>
      <label for="f-hasta" class="numeracion block">Hasta</label>
      <input id="f-hasta" type="date" name="hasta" value={hasta ?? ""} class="mt-2 block border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm" />
    </div>
    <div class="grow basis-56">
      <label for="f-q" class="numeracion block">Buscar</label>
      <input id="f-q" type="search" name="q" value={filtroTexto} maxlength="80" placeholder="Nombre, correo, teléfono o referencia" class="mt-2 block w-full border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm" />
    </div>
    <button type="submit" class="btn btn-primario">Filtrar</button>
    {hayFiltro && (
      <a href="/admin/pedidos" class="text-sm underline underline-offset-4 text-[color:var(--color-ink-muted)]">Quitar filtros</a>
    )}
    {/* Descarga los pedidos que casan con los filtros: todas las páginas. */}
    <a
      href={`/api/admin/pedidos/exportar?${query}`}
      class="btn btn-secundario ml-auto"
      download
    >
      Exportar a Excel
    </a>
  </form>

  {!fallo && total > 0 && (
    <p class="mb-3 text-sm text-[color:var(--color-ink-muted)]">
      {resumenPagina(pag, total, "pedido", "pedidos")}
    </p>
  )}

  {!fallo && pedidos.length === 0 && (
    <p class="text-[color:var(--color-ink-muted)]">
      {filtroTexto
        ? "No hay pedidos que casen con esa búsqueda."
        : hayFiltro
          ? "No hay pedidos entre esas fechas."
          : "Todavía no ha entrado ningún pedido por la web."}
    </p>
  )}

  <ul class="flex flex-col gap-px bg-[color:var(--color-avellana)]">
    {pedidos.map((p) => (
      <li class="bg-[color:var(--color-leche)] p-5">
        <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1">
          <p class="numeracion">
            {p.fechaEntrega ? formatDateISO(p.fechaEntrega) : `Día ${SIN_DATOS}`} ·
            {" "}{p.mode ? MODE_COPY[p.mode].label : `Modalidad ${SIN_DATOS}`}
            {franja(p)}
          </p>
          <p class="font-[family-name:var(--font-display)] text-xl font-semibold">
            {formatPriceCents(p.totalCents)}
          </p>
        </div>

        {/* Estado y botón de cobrar a mano. «Pagado por Stripe» es el que
            tiene referencia de Stripe; el resto lo pone (y lo deshace) el
            obrador. Un «Sin pagar» tiene que cantar: va mezclado con los
            pagados. */}
        <PedidoEstado
          client:load
          pedidoId={p.id}
          estadoInicial={p.estado}
          deStripe={p.stripeSessionId !== null}
        />

        <p class="mt-2 text-sm">
          {p.nombre ?? "Sin nombre"} ·
          {" "}<a href={`tel:${p.telefono}`} class="underline font-semibold whitespace-nowrap">{p.telefono}</a> ·
          {" "}<a href={`mailto:${p.email}`} class="underline">{p.email}</a>
        </p>
        <p class="text-sm text-[color:var(--color-ink-muted)]">{destino(p)}</p>
        {/* Los primeros caracteres del uuid bastan para que el cliente los
            lea por teléfono y el obrador los teclee en «Buscar». */}
        <p class="text-xs text-[color:var(--color-ink-muted)]">Ref. {p.id.slice(0, 8)}</p>

        <ul class="mt-3 text-sm">
          {p.lineas.map((l) => (
            <li>
              {l.qty}× {l.nombre}{l.varianteLabel ? ` — ${l.varianteLabel}` : ""}
              <span class="text-[color:var(--color-ink-muted)]"> · {formatPriceCents(l.unitPriceCents)}/ud</span>
              {l.detalle && (
                <ul class="text-xs text-[color:var(--color-ink-muted)]">
                  {l.detalle.map((pieza) => <li>{etiquetaPieza(pieza)}</li>)}
                </ul>
              )}
              {l.fotoUrl && (
                <a href={l.fotoUrl} target="_blank" rel="noopener" class="text-xs underline">
                  Ver la foto del cliente
                </a>
              )}
            </li>
          ))}
        </ul>

        {p.notas && (
          <p class="mt-3 text-sm border-l-2 border-[color:var(--color-caramelo)] pl-3">
            {p.notas}
          </p>
        )}

        {p.envioCents > 0 && (
          <p class="mt-2 text-sm text-[color:var(--color-ink-muted)]">
            Reparto: {formatPriceCents(p.envioCents)}
          </p>
        )}

        {p.reconstruido && (
          <p class="mt-3 text-xs text-[color:var(--color-ink-muted)]">
            Reconstruido desde Stripe: puede faltarle detalle. Referencia
            {" "}{p.stripeSessionId}
          </p>
        )}
      </li>
    ))}
  </ul>

  <Paginacion pagina={pag.pagina} paginas={pag.paginas} etiqueta="Páginas de pedidos" href={enlacePagina} />
</AdminLayout>
