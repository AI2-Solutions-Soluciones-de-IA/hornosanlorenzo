---
// src/pages/admin/pedidos.astro
import AdminLayout from "~/layouts/AdminLayout.astro";
import PedidoEstado from "~/islands/PedidoEstado.tsx";
import PedidoProcesado from "~/islands/PedidoProcesado.tsx";
import PedidoArchivar from "~/islands/PedidoArchivar.tsx";
import PedidosNuevos from "~/islands/PedidosNuevos.tsx";
import Paginacion from "~/islands/Paginacion.tsx";
import { paginar, resumenPagina } from "~/lib/paginacion";
import { listarPedidos, contarPedidos, type PedidoConLineas } from "~/lib/db/pedidos";
import { leerFiltrosPedidos, queryFiltros } from "~/lib/filtros-pedidos";
import { formatPriceCents, formatDateISO } from "~/lib/format";
import { MODE_COPY, ENTREGA_DOMICILIO_COPY } from "~/lib/entrega";
import { stores } from "~/data/stores";
import { destinosVisibles, destinosDeVista } from "~/lib/auth/guardia";
import type { DestinoPedido } from "~/lib/db/pedidos";
import { etiquetaPieza } from "~/data/packs";
import { nombreConTipo } from "~/data/secciones";

export const prerender = false;

// Filtros por URL (`?fecha=entrega|entrada&desde=&hasta=&q=&destino=&pagina=`, ver
// `leerFiltrosPedidos`). Esta página se sirve en servidor y fuera de la
// caché (está excluida del ISR en `astro.config.mjs`), así que aquí sí se
// pueden leer parámetros; en las páginas públicas no, que son estáticas.
const leidos = leerFiltrosPedidos(Astro.url.searchParams);
const { tipo, desde, hasta, texto: filtroTexto, procesado: filtroProcesado, archivo: filtroArchivo, hayFiltro } = leidos;

// La oficina de una tienda solo ve lo suyo (6-11-2026): se añade a todas
// las consultas, también a la cuenta sin filtros del aviso de nuevos. En el
// desplegable solo salen sus destinos, y uno que no es suyo no cuenta.
// Quien lo ve todo tiene arriba «Todo · Alcobendas · Pozuelo» (12-11-2026):
// la pestaña restringe igual que la oficina de esa tienda.
const propios = destinosVisibles(Astro.locals.usuario);
const conPestanas = !propios;
const soloDestinos = destinosDeVista(Astro.locals.usuario, leidos.oficina);
const filtroDestino =
  leidos.destino && (!soloDestinos || soloDestinos.includes(leidos.destino))
    ? leidos.destino
    : undefined;
const filtros = { ...leidos.filtros, destino: filtroDestino, soloDestinos };

const OPCIONES_DESTINO: { valor: DestinoPedido; texto: string }[] = [
  ...stores.map((s) => ({ valor: s.id, texto: `Recogida en ${s.shortName}` })),
  { valor: "domicilio", texto: "Envío a domicilio" },
];
const opcionesDestino = OPCIONES_DESTINO.filter(
  (o) => !soloDestinos || soloDestinos.includes(o.valor),
);

// De 20 en 20: con cada pedido desplegado con sus líneas, más que eso ya es
// un scroll que nadie recorre.
const POR_PAGINA = 20;

// Igual que en `cuenta.astro`: un fallo de Postgres no puede dejar el panel
// en un 500. Se enseña el aviso y el resto del panel sigue navegable.
let pedidos: PedidoConLineas[] = [];
let total = 0;
let pag = paginar(0, POR_PAGINA, 1);
let fallo = false;
/** Cuántos hay en total, sin filtros: el punto de partida del aviso de nuevos. */
let totalSinFiltros = 0;
try {
  // Primero la cuenta: una `?pagina=` más allá de la última se queda en la
  // última en vez de enseñar una página vacía.
  total = await contarPedidos(filtros);
  pag = paginar(total, POR_PAGINA, leidos.pagina);
  pedidos = await listarPedidos(POR_PAGINA, filtros, (pag.pagina - 1) * POR_PAGINA);
  // Con los archivados: archivar uno no puede bajar la cuenta y esconder el
  // siguiente pedido nuevo (mismo criterio en `/api/admin/pedidos/nuevos`).
  // Con lo propio, no con la pestaña: el aviso de nuevos cuenta igual en
  // `/api/admin/pedidos/nuevos` y no puede saltar al cambiar de pestaña.
  totalSinFiltros = await contarPedidos({ soloDestinos: propios, archivo: "todos" });
} catch (error) {
  fallo = true;
  console.error(
    "No se pudieron cargar los pedidos:",
    error instanceof Error ? error.message : error,
  );
}

const query = queryFiltros({ ...leidos, destino: filtroDestino });
const enlacePagina = (n: number) => {
  const q = new URLSearchParams(query);
  if (n > 1) q.set("pagina", String(n));
  return `/admin/pedidos?${q}`;
};

const SLOT_LABEL = { morning: "mañana", afternoon: "tarde" } as const;

/**
 * `mode`, `fechaEntrega` y el destino pueden faltar en un pedido
 * reconstruido desde Stripe (migración 008). Cuando faltan hay que decirlo:
 * escribir un valor por defecto convertiría un «no lo sé» en un dato que
 * nadie va a comprobar, y el obrador prepararía el pedido equivocado.
 */
const SIN_DATOS = "sin datos — mira la sesión en Stripe";

function destino(p: PedidoConLineas): string {
  if (p.mode === null) return `Destino ${SIN_DATOS}`;
  if (p.mode === "domicilio") {
    const linea = [p.address, p.postalCode].filter(Boolean).join(" · ");
    return linea || `Dirección ${SIN_DATOS}`;
  }
  const tienda = stores.find((s) => s.id === p.storeId);
  return tienda ? `${tienda.shortName} — ${tienda.address}` : `Recogida (tienda ${SIN_DATOS})`;
}

/** Fecha y hora en que entró el pedido, en hora de Madrid: «09/10/2026 · 13:27». */
const fechaHora = (d: Date) => {
  const f = new Intl.DateTimeFormat("es-ES", {
    timeZone: "Europe/Madrid",
    day: "2-digit",
    month: "2-digit",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  }).formatToParts(new Date(d));
  const v = (t: string) => f.find((x) => x.type === t)?.value ?? "";
  return `${v("day")}/${v("month")}/${v("year")} · ${v("hour")}:${v("minute")}`;
};

/** «Envío a domicilio» o «Recogida en Pozuelo». */
function modalidad(p: PedidoConLineas): string {
  if (p.mode === "domicilio") return "Envío a domicilio";
  if (p.mode === "recogida") {
    const tienda = stores.find((s) => s.id === p.storeId);
    return tienda ? `Recogida en ${tienda.shortName}` : "Recogida en tienda";
  }
  return `Modalidad ${SIN_DATOS}`;
}

---
<AdminLayout titulo="Pedidos">
  {conPestanas && (
    <nav aria-label="Pedidos de qué tienda" class="mb-6 flex flex-wrap gap-2">
      {([
        { id: undefined, texto: "Todo" },
        { id: "alcobendas", texto: "Alcobendas" },
        { id: "pozuelo", texto: "Pozuelo" },
      ] as const).map((v) => {
        const activa = leidos.oficina === v.id;
        const q = queryFiltros({ ...leidos, destino: filtroDestino, oficina: v.id });
        return (
          <a
            href={`/admin/pedidos?${q}`}
            aria-current={activa ? "page" : undefined}
            class:list={[
              "inline-flex items-center min-h-11 px-5 border text-sm font-semibold uppercase tracking-[0.12em]",
              activa
                ? "bg-[color:var(--color-teja)] border-[color:var(--color-teja)] text-[color:var(--color-leche)]"
                : "bg-[color:var(--color-leche)] border-[color:var(--color-avellana)] text-[color:var(--color-moka)] hover:border-[color:var(--color-moka)]",
            ]}
          >
            {v.texto}
          </a>
        );
      })}
    </nav>
  )}
  {!fallo && (
    <PedidosNuevos client:load inicial={totalSinFiltros} marcables={!hayFiltro && pag.pagina === 1} />
  )}
  {fallo && (
    <p class="border-l-2 border-[color:var(--color-caramelo)] pl-3 py-2 text-sm">
      Ahora mismo no se pueden leer los pedidos. Vuelve a intentarlo en un
      momento; los cobros siguen estando en el panel de Stripe.
    </p>
  )}

  <form method="get" class="mb-6 flex flex-wrap items-end gap-4 border border-[color:var(--color-avellana)] bg-[color:var(--color-leche)] p-4">
    {/* La pestaña de arriba viaja con el formulario. */}
    {conPestanas && leidos.oficina && <input type="hidden" name="oficina" value={leidos.oficina} />}
    <div>
      <label for="f-fecha" class="numeracion block">Fecha de</label>
      <select id="f-fecha" name="fecha" class="mt-2 block border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm">
        <option value="entrega" selected={tipo === "entrega"}>Entrega</option>
        <option value="entrada" selected={tipo === "entrada"}>Entrada del pedido</option>
      </select>
    </div>
    <div>
      <label for="f-desde" class="numeracion block">Desde</label>
      <input id="f-desde" type="date" name="desde" value={desde ?? ""} class="mt-2 block border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm" />
    </div>
    <div>
      <label for="f-hasta" class="numeracion block">Hasta</label>
      <input id="f-hasta" type="date" name="hasta" value={hasta ?? ""} class="mt-2 block border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm" />
    </div>
    {/* Con un solo destino posible (la oficina de Pozuelo) no hay nada que elegir. */}
    {opcionesDestino.length > 1 && (
      <div>
        <label for="f-destino" class="numeracion block">Tienda / envío</label>
        <select id="f-destino" name="destino" class="mt-2 block border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm">
          <option value="" selected={!filtroDestino}>Todos</option>
          {opcionesDestino.map((o) => (
            <option value={o.valor} selected={filtroDestino === o.valor}>{o.texto}</option>
          ))}
        </select>
      </div>
    )}
    <div>
      <label for="f-procesado" class="numeracion block">Procesado</label>
      <select id="f-procesado" name="procesado" class="mt-2 block border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm">
        <option value="" selected={!filtroProcesado}>Todos</option>
        <option value="no" selected={filtroProcesado === "no"}>Sin procesar</option>
        <option value="si" selected={filtroProcesado === "si"}>Procesados</option>
      </select>
    </div>
    <div>
      <label for="f-archivo" class="numeracion block">Archivo</label>
      <select id="f-archivo" name="archivo" class="mt-2 block border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm">
        <option value="" selected={!filtroArchivo}>Activos</option>
        <option value="si" selected={filtroArchivo === "si"}>Archivados</option>
        <option value="todos" selected={filtroArchivo === "todos"}>Todos</option>
      </select>
    </div>
    <div class="grow basis-56">
      <label for="f-q" class="numeracion block">Buscar</label>
      <input id="f-q" type="search" name="q" value={filtroTexto} maxlength="80" placeholder="Nombre, correo, teléfono o referencia" class="mt-2 block w-full border border-[color:var(--color-avellana)] bg-[color:var(--color-paper)] px-3 py-2 text-sm" />
    </div>
    <button type="submit" class="btn btn-primario">Filtrar</button>
    {hayFiltro && (
      <a href={conPestanas && leidos.oficina ? `/admin/pedidos?oficina=${leidos.oficina}` : "/admin/pedidos"} class="text-sm underline underline-offset-4 text-[color:var(--color-ink-muted)]">Quitar filtros</a>
    )}
    {/* Descarga (o imprime, 12-11-2026) los pedidos que casan con los
        filtros: todas las páginas, no solo la que se ve. */}
    <div class="ml-auto flex flex-wrap gap-3">
      <a
        href={`/admin/pedidos/imprimir?${query}`}
        target="_blank"
        rel="noopener"
        class="btn btn-secundario"
      >
        Imprimir
      </a>
      <a
        href={`/api/admin/pedidos/exportar?${query}`}
        class="btn btn-secundario"
        download
      >
        Exportar a Excel
      </a>
    </div>
  </form>

  {!fallo && total > 0 && (
    <p class="mb-3 text-sm text-[color:var(--color-ink-muted)]">
      {resumenPagina(pag, total, "pedido", "pedidos")}
    </p>
  )}

  {!fallo && pedidos.length === 0 && (
    <p class="text-[color:var(--color-ink-muted)]">
      {filtroTexto
        ? "No hay pedidos que casen con esa búsqueda."
        : desde || hasta
          ? "No hay pedidos entre esas fechas."
          : filtroDestino
            ? "No hay pedidos con esa entrega."
          : filtroArchivo === "si"
            ? "No hay pedidos archivados."
          : filtroProcesado === "no"
            ? "No queda ningún pedido sin procesar."
          : filtroProcesado === "si"
            ? "No hay pedidos marcados como procesados."
          : "Todavía no ha entrado ningún pedido por la web."}
    </p>
  )}

  {/* Cada pedido, su propia tarjeta con aire entre una y otra (9-10-2026):
      con una raya fina de separación se confundían al leer la lista. */}
  {/* En «Activos», un pedido que se acaba de archivar se pliega hasta que
      se recarga la lista (`.pedidos-lista[data-vista]`, estilo de abajo). */}
  <ul class="pedidos-lista flex flex-col gap-5" data-vista={filtroArchivo ? "archivo" : "activos"}>
    {pedidos.map((p) => (
      <li
        class="pedido-tarjeta bg-white border border-[color:var(--color-avellana)] border-l-4 border-l-[color:var(--color-caramelo)] p-5"
        data-pedido={p.id}
        data-procesado={p.procesadoEn ? "si" : "no"}
        data-archivado={p.archivadoEn ? "si" : "no"}
      >
        <div class="pedido-cabecera mb-3 flex flex-wrap items-start justify-between gap-3">
          {/* Sin número de pedido desde el 12-11-2026: se identifica por
              el cliente (nombre obligatorio al pedir) y la referencia. */}
          <p class="font-[family-name:var(--font-display)] text-lg">
            {p.nombre ? `Pedido de ${p.nombre}` : "Pedido"}
          </p>
          {/* «Procesado» (11-11-2026): la oficina lo marca al pasarlo al
              obrador; la tarjeta se apaga para que salten los pendientes. */}
          <div class="flex flex-col items-end gap-2">
            <PedidoProcesado
              client:load
              pedidoId={p.id}
              procesadoEn={p.procesadoEn ? new Date(p.procesadoEn).toISOString() : null}
              procesadoPor={p.procesadoPor}
            />
            {/* «Archivar» (12-11-2026): lo saca de la lista sin anularlo. */}
            <PedidoArchivar
              client:load
              pedidoId={p.id}
              archivadoEn={p.archivadoEn ? new Date(p.archivadoEn).toISOString() : null}
              archivadoPor={p.archivadoPor}
            />
            {/* Este pedido solo, como comanda (12-11-2026). */}
            <a
              href={`/admin/pedidos/imprimir?id=${p.id}`}
              target="_blank"
              rel="noopener"
              class="text-xs underline underline-offset-4 text-[color:var(--color-ink-muted)]"
            >
              Imprimir
            </a>
          </div>
        </div>
        {/* Los seis datos que pide el obrador (9-10-2026), cada uno con su
            etiqueta: fecha y hora del pedido, envío o recogida, fecha de
            entrega, importe y estado arriba; los productos debajo. */}
        <dl class="grid gap-x-6 gap-y-4 grid-cols-2 lg:grid-cols-[1.1fr_1.3fr_1.3fr_0.8fr_1.4fr]">
          <div>
            <dt class="numeracion">Fecha del pedido</dt>
            <dd class="mt-1 text-sm font-semibold">{fechaHora(p.createdAt)}</dd>
          </div>
          <div>
            <dt class="numeracion">Envío / Recogida</dt>
            <dd class="mt-1 text-sm font-semibold">{modalidad(p)}</dd>
          </div>
          <div>
            <dt class="numeracion">{p.mode === "domicilio" ? "Fecha de envío" : p.mode === "recogida" ? "Fecha de recogida" : "Fecha de entrega"}</dt>
            <dd class="mt-1 text-sm font-semibold first-letter:uppercase">
              {p.fechaEntrega ? formatDateISO(p.fechaEntrega) : `Día ${SIN_DATOS}`}
              {p.mode === "recogida" && p.slot && (
                <span class="block font-normal text-[color:var(--color-ink-muted)]">Franja de {SLOT_LABEL[p.slot]}</span>
              )}
              {p.mode === "domicilio" && (
                <span class="block font-normal text-[color:var(--color-ink-muted)]">{ENTREGA_DOMICILIO_COPY}</span>
              )}
            </dd>
          </div>
          <div>
            <dt class="numeracion">Importe</dt>
            <dd class="mt-1 font-[family-name:var(--font-display)] text-xl font-semibold leading-tight">
              {formatPriceCents(p.totalCents)}
            </dd>
            {p.envioCents > 0 && (
              <dd class="text-xs text-[color:var(--color-ink-muted)]">con {formatPriceCents(p.envioCents)} de reparto</dd>
            )}
          </div>
          <div class="col-span-2 lg:col-span-1">
            <dt class="numeracion">Estado</dt>
            <dd>
              {/* «Pagado por Stripe» es el que tiene referencia de Stripe; el
                  resto lo pone (y lo deshace) el obrador. Un «Sin pagar»
                  tiene que cantar: va mezclado con los pagados. */}
              <PedidoEstado
                client:load
                pedidoId={p.id}
                estadoInicial={p.estado}
                deStripe={p.stripeSessionId !== null}
              />
            </dd>
            {/* Devolución hecha desde Stripe (webhook `charge.refunded`). */}
            {p.devueltoCents > 0 && (
              <dd class="mt-2 inline-block px-2 py-1 text-[11px] font-semibold uppercase tracking-[0.14em] border border-[color:var(--color-teja)] text-[color:var(--color-teja)]">
                {p.devueltoCents >= p.totalCents
                  ? "Devuelto"
                  : `Devuelto en parte · ${formatPriceCents(p.devueltoCents)}`}
              </dd>
            )}
          </div>
        </dl>

        <div class="mt-4 pt-4 border-t border-[color:var(--color-line)]">
          <p class="numeracion">Productos</p>
          <ul class="mt-2 text-sm divide-y divide-[color:var(--color-line)]">
            {p.lineas.map((l) => (
              <li class="py-1.5 flex flex-wrap justify-between gap-x-4">
                <span>
                  <strong class="tabular-nums">{l.qty}×</strong> {nombreConTipo(l.nombre, l.seccion)}{l.varianteLabel ? ` — ${l.varianteLabel}` : ""}
                  {l.detalle && (
                    <ul class="text-xs text-[color:var(--color-ink-muted)]">
                      {l.detalle.map((pieza) => <li>{etiquetaPieza(pieza)}</li>)}
                    </ul>
                  )}
                  {l.fotoUrl && (
                    <a href={l.fotoUrl} target="_blank" rel="noopener" class="block text-xs underline">
                      Ver la foto del cliente
                    </a>
                  )}
                </span>
                <span class="text-[color:var(--color-ink-muted)] tabular-nums whitespace-nowrap">
                  {formatPriceCents(l.unitPriceCents * l.qty)}
                </span>
              </li>
            ))}
            {p.lineas.length === 0 && (
              <li class="py-1.5 text-[color:var(--color-ink-muted)]">Sin productos apuntados.</li>
            )}
          </ul>
        </div>

        <div class="mt-4 pt-4 border-t border-[color:var(--color-line)] text-sm">
          <p>
            {p.nombre ?? "Sin nombre"} ·
            {" "}<a href={`tel:${p.telefono}`} class="underline font-semibold whitespace-nowrap">{p.telefono}</a> ·
            {" "}<a href={`mailto:${p.email}`} class="underline">{p.email}</a>
          </p>
          <p class="text-[color:var(--color-ink-muted)]">{destino(p)}</p>
          {/* Los primeros caracteres del uuid bastan para que el cliente los
              lea por teléfono y el obrador los teclee en «Buscar». */}
          <p class="text-xs text-[color:var(--color-ink-muted)]">
            Ref. web {p.id.slice(0, 8)}
            {p.stripeSessionId && (
              <>
                {" · "}
                {/* Abre el pago en el panel de Stripe (pasa por
                    `/api/admin/pedidos/stripe`, que averigua cuál es). En
                    Stripe el pago lleva además «Ref. …». */}
                <a href={`/api/admin/pedidos/stripe?pedido=${p.id}`} target="_blank" rel="noopener" class="underline font-semibold text-[color:var(--color-ink)]">
                  Ver en Stripe
                </a>
              </>
            )}
          </p>
          {p.notas && (
            <p class="mt-3 border-l-2 border-[color:var(--color-caramelo)] pl-3">
              {p.notas}
            </p>
          )}
          {p.reconstruido && (
            <p class="mt-3 text-xs text-[color:var(--color-ink-muted)]">
              Reconstruido desde Stripe: puede faltarle detalle. Referencia
              {" "}{p.stripeSessionId}
            </p>
          )}
        </div>
      </li>
    ))}
  </ul>

  <Paginacion pagina={pag.pagina} paginas={pag.paginas} etiqueta="Páginas de pedidos" href={enlacePagina} />
</AdminLayout>

<style is:global>
  /* Pedido procesado: borde neutro y contenido apagado, para que los
     pendientes salten a la vista. La casilla queda a pleno color. */
  .pedido-tarjeta[data-procesado="si"] {
    border-left-color: var(--color-avellana);
    background: var(--color-leche);
  }
  /* Recién archivado en la vista de activos: solo la cabecera, para poder
     sacarlo del archivo sin buscarlo. */
  .pedidos-lista[data-vista="activos"] .pedido-tarjeta[data-archivado="si"] > :not(.pedido-cabecera) {
    display: none;
  }
  .pedido-tarjeta[data-procesado="si"] > :not(.pedido-cabecera),
  .pedido-tarjeta[data-procesado="si"] > .pedido-cabecera > p {
    opacity: 0.55;
  }
</style>
