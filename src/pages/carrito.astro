---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import CartPage from "~/islands/CartPage.tsx";
import { listarDirecciones } from "~/lib/db/direcciones";
import { ventaOnlinePausada } from "~/lib/venta-online";

// Necesita leer la sesión de la petición para precargar los datos de quien
// tiene cuenta: sin esta línea Astro serviría la página como estática,
// `Astro.locals.usuario` sería siempre null y nada de esto funcionaría. Es
// el mismo tropiezo que ya tuvo la cabecera.
export const prerender = false;

const usuario = Astro.locals.usuario;

// Cuando hay sesión la página lleva nombre, correo, teléfono y direcciones:
// nada de eso debe quedar en una caché compartida ni en el disco. Se fija
// siempre, haya o no sesión, porque una CDN no distingue entre peticiones.
Astro.response.headers.set("Cache-Control", "private, no-store");

// Sin sesión, `prefill` queda `undefined` y el checkout de invitado no
// cambia de comportamiento: es la propia isla la que decide qué hacer con
// cada caso.
//
// El middleware degrada a invitado si Postgres falla al resolver la
// sesión, pero aquí hay sesión y el fallo puede venir después, al pedir las
// direcciones: sin este `try/catch` esa caída se lleva la página entera por
// delante y deja a quien tiene cuenta sin poder comprar, justo lo que el
// middleware intenta evitar. Con direcciones vacías puede seguir
// escribiéndola a mano, como un invitado.
let direcciones: Awaited<ReturnType<typeof listarDirecciones>> = [];
if (usuario) {
  try {
    direcciones = await listarDirecciones(usuario.id);
  } catch (error) {
    console.error(
      "No se pudieron cargar las direcciones guardadas, se sigue sin ellas:",
      error instanceof Error ? error.message : error,
    );
  }
}

const prefill = usuario
  ? {
      nombre: usuario.name,
      email: usuario.email,
      telefono: usuario.telefono ?? "",
      direcciones,
    }
  : undefined;
---
<MarketingLayout
  title="Tu pedido"
  description="Revisa tu pedido y termínalo online."
>
  <CartPage client:only="react" prefill={prefill} ventaPausada={ventaOnlinePausada()} />
</MarketingLayout>
