---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import ContactForm from "~/islands/ContactForm.tsx";
import SocialLinks from "~/components/SocialLinks.astro";
import { stores } from "~/data/stores";
---
<MarketingLayout
  title="Contacto"
  description="Escríbenos o llama. Te respondemos en menos de 24 horas."
>
  <section class="mx-auto max-w-6xl 2xl:max-w-[110rem] px-4 sm:px-6 2xl:px-10 py-12 grid gap-12 md:grid-cols-2">
    <div>
      <p class="numeracion">Contacto</p>
      <h1 class="text-4xl sm:text-5xl mt-2">Hablamos.</h1>
      <p class="text-[color:var(--color-ink-muted)] mt-3 max-w-md">Para un pedido del día, llama a la tienda o pídelo en la tienda online. Para eventos, encargos grandes o consultas largas, este formulario.</p>
      <p class="text-[color:var(--color-ink-muted)] mt-3 max-w-md text-sm">¿Eres empresa u hostelería? Escríbenos con este formulario y te preparamos tus condiciones.</p>

      <ul class="mt-8 space-y-5 text-sm">
        {stores.map((s) => (
          <li>
            <p class="font-[family-name:var(--font-display)] text-xl">{s.shortName}</p>
            <p class="text-[color:var(--color-ink-muted)]">{s.address}, {s.postal} {s.city}</p>
            <p><a href={`tel:${s.phone}`}>{s.phoneDisplay}</a> · <a href={`mailto:${s.email}`}>{s.email}</a></p>
          </li>
        ))}
        <li>
          <p class="numeracion">Redes</p>
          <SocialLinks class="mt-2" />
        </li>
      </ul>
    </div>

    <div>
      <ContactForm client:visible />
    </div>
  </section>
</MarketingLayout>
