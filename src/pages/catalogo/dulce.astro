---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import CatalogoGrid from "~/components/CatalogoGrid.astro";
import { catalogoPublico, definicionesPublicas } from "~/lib/lectura-publica";

// Lee el catálogo de la base de datos: bajo demanda, con la caché ISR delante
// y el panel invalidándola al guardar.
export const prerender = false;

// La lectura va aquí y no dentro de `CatalogoGrid`: si Postgres falla, hay
// que marcar la respuesta como `no-store` para que la página vacía no se
// quede guardada en la caché, y eso solo funciona desde el frontmatter de la
// página (el porqué, en `~/lib/lectura-publica.ts`).
// Las definiciones de los packs, igual y en paralelo: con ellas la rejilla
// sabe qué pack se puede pintar.
const [productos, defsPacks] = await Promise.all([
  catalogoPublico(Astro.response),
  definicionesPublicas(Astro.response),
]);
---
<MarketingLayout
  title="Dulce"
  description="Repostería de obrador con la receta tradicional desde 1986: bollería, tartas y temporada."
>
  <CatalogoGrid
    productos={productos}
    defsPacks={defsPacks}
    grupo="dulce"
    eyebrow="Nuestros productos · Dulce"
    title="Dulce de obrador."
    intro="Repostería artesana elaborada con la misma receta tradicional desde 1986."
    porSeccion
  />
</MarketingLayout>
