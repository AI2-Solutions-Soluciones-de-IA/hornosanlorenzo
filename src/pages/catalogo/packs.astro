---
import MarketingLayout from "~/layouts/MarketingLayout.astro";
import PackCard from "~/components/PackCard.astro";
import { packPorSlug } from "~/data/packs";
import { catalogoPublico } from "~/lib/lectura-publica";
import { fichaPack } from "~/lib/pack-ficha";

// Lee de la base de datos: bajo demanda, con la caché ISR delante y el panel
// invalidándola al guardar (`RUTAS_CATALOGO`).
export const prerender = false;

// Una sola lectura: el catálogo activo trae a la vez los packs y todas sus
// piezas, que hacen falta para el «comprado suelto» y el ahorro. Si Postgres
// falla, sale vacío y sin caché (`~/lib/lectura-publica.ts`).
const catalogo = await catalogoPublico(Astro.response);

// En el orden de la carta. Un pack sin definición no tiene piezas ni ficha
// (da 404): no se enseña.
const tarjetas = catalogo.flatMap((pack) => {
  const def = pack.category === "packs" ? packPorSlug(pack.slug) : undefined;
  return def ? [{ pack, def, ficha: fichaPack(def, pack, catalogo) }] : [];
});
---
<MarketingLayout
  title="Packs"
  description="Siete ocasiones resueltas, con precio cerrado y el ahorro a la vista."
>
  <section class="mx-auto max-w-6xl px-4 sm:px-6 py-12 sm:py-16">
    <p class="numeracion">Nuestros productos</p>
    <h1 class="text-4xl sm:text-5xl mt-2">Nuestras cajitas para cada ocasión.</h1>
    <p class="text-[color:var(--color-ink-muted)] mt-4 max-w-2xl text-lg">
      Siete ocasiones resueltas, con precio cerrado y el ahorro a la vista.
    </p>
    <div class="mt-7 flex flex-wrap gap-3">
      <a href="/catalogo" class="btn btn-primario">
        Pedir online
      </a>
      <a href="/a-quien-servimos" class="btn btn-secundario">
        Packs para empresa
      </a>
    </div>
  </section>

  <section class="border-t border-[color:var(--color-avellana)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
      {tarjetas.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
          {tarjetas.map(({ pack, def, ficha }) => (
            <PackCard
              pack={pack}
              def={def}
              sueltoCents={ficha.sueltoCents}
              ahorro={ficha.ahorro}
              agotado={ficha.agotado}
            />
          ))}
        </div>
      ) : (
        <p class="text-lg text-[color:var(--color-ink-muted)]">
          Estamos preparando los packs. Mientras tanto,
          <a href="/catalogo" class="underline underline-offset-4 text-[color:var(--color-ink)]">pide desde la carta</a>.
        </p>
      )}
    </div>
  </section>

  <section class="bg-[color:var(--color-leche)] border-t border-[color:var(--color-avellana)]">
    <div class="mx-auto max-w-6xl px-4 sm:px-6 py-14 sm:py-20">
      <div class="max-w-xl border border-[color:var(--color-avellana)] bg-[color:var(--color-leche)] p-6 sm:p-8">
        <p class="numeracion">Premium packs</p>
        <h2 class="mt-2 font-[family-name:var(--font-display)] text-2xl">
          Para cuando la mesa importa.
        </h2>
        <p class="mt-3 text-sm leading-relaxed text-[color:var(--color-ink-muted)]">
          Selección ampliada de salado y dulce, presentación cuidada y formatos grandes.
          Disponibles también en versión XL para empresa, con descuento por volumen.
        </p>
        <a href="/contacto" class="btn btn-primario mt-6">Pedir presupuesto</a>
      </div>
    </div>
  </section>
</MarketingLayout>
