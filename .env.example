# Postgres. Cualquier proveedor: lo único que se usa es SQL estándar.
# Usa la cadena agrupada (pooled), no la directa.
DATABASE_URL=postgresql://usuario:clave@host:5432/basededatos?sslmode=require

PUBLIC_SITE_URL=https://hornosanlorenzo-demo.vercel.app

# Better Auth. Genera uno nuevo con: openssl rand -base64 32
# Nunca se comparte entre entornos ni se comitea el valor real.
BETTER_AUTH_SECRET=

# Stripe — panel > Desarrolladores > Claves de API
STRIPE_SECRET_KEY=sk_test_xxx
# Stripe — panel > Desarrolladores > Webhooks > firma del endpoint
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Resend — aviso de pedido pagado. Sin esto el pedido sigue en el panel de
# Stripe, pero no llega ningún correo.
RESEND_API_KEY=re_xxx
ORDER_NOTIFICATION_EMAIL=info@hornosanlorenzo.com
ORDER_FROM_EMAIL="Horno San Lorenzo <pedidos@hornosanlorenzo.com>"

# Invalidar la caché de Vercel cuando el panel publica un cambio.
# Genera uno con: openssl rand -hex 16
# TIENE que estar también en el entorno de CONSTRUCCIÓN de Vercel, no solo en
# el de ejecución: `astro.config.mjs` lo lee al construir.
VERCEL_BYPASS_TOKEN=

# Vercel Blob — fotos de productos y noticias.
# Panel de Vercel > Storage > Blob > crear almacén y copiar el token.
BLOB_READ_WRITE_TOKEN=
